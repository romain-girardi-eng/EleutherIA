cff-version: 1.2.0
title: "EleutherIA: An AI-Powered Scholarly Research Platform for Ancient Philosophy on Free Will"
message: "If you use this software or dataset, please cite it as below."
type: software
authors:
  - family-names: Girardi
    given-names: Romain
    email: romain.girardi@univ-cotedazur.fr
