{
  "$schema": "https://opencode.ai/config.json",
  "//k2p7_swap": "ONE-LINE K2.7 SWAP (ARCHITECTURE §K2.7): when K2.7 lands on Fireworks, change 'model'/'small_model' below to its Fireworks id and add a sibling entry under provider.fireworks.models. Fireworks-only — do NOT add a Moonshot provider here.",
  "model": "fireworks/accounts/fireworks/models/kimi-k2p7-code",
  "small_model": "fireworks/accounts/fireworks/models/kimi-k2p7-code",
  "provider": {
    "fireworks": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks AI",
      "options": {
        "baseURL": "https://api.fireworks.ai/inference/v1",
        "apiKey": "{env:FIREWORKS_API_KEY}"
      },
      "models": {
        "accounts/fireworks/models/kimi-k2p7-code": {
          "name": "Kimi K2.7 Code",
          "limit": {
            "context": 256000,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "eleutheria": {
      "type": "local",
      "command": [
        "[local-path]",
        "-m",
        "mcp_server.transports.stdio"
      ],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}",
        "MCP_API_TOKEN": "local-spike",
        "PYTHONPATH": "[local-path]",
        "ELEUTHERIA_KG_SNAPSHOT_DIR": "[local-path]"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
