{
  "schema_version": "1.0.0",
  "scope_id": "scope_ancient_free_will_v1",
  "as_of": "2026-08-24",
  "objective": "Operationally exhaustive, edition-aware and claim-level coverage of ancient debates about agency, fate, freedom, choice, will and moral responsibility, together with secondary scholarship needed to interpret those debates.",
  "temporal_bounds": {
    "ancient_start_year": -800,
    "ancient_end_year": 700,
    "secondary_start_year": 1800,
    "secondary_end_policy": "rolling_current_date",
    "boundary_rule": "Earlier antecedents and later transmissions are included when a registered evidence unit demonstrates direct relevance to an in-range debate."
  },
  "inclusion_rules": [
    "Ancient texts that formulate, report, attack or presuppose positions on fate, necessity, contingency, agency, voluntary action, choice, will, responsibility, providence, foreknowledge, grace, evil, astrology or divination.",
    "Doxographical, fragmentary and translation witnesses needed to reconstruct otherwise lost ancient positions.",
    "Critical editions, translations and commentaries required to establish text, locus, authorship or variant readings.",
    "Secondary scholarship whose primary contribution interprets, reconstructs, disputes or documents ancient material within scope.",
    "Reception sources outside the ancient date range only where they preserve an ancient witness or materially determine a disputed reconstruction."
  ],
  "exclusion_rules": [
    "Purely contemporary free-will literature with no substantive ancient argument, source or reception component.",
    "Popular summaries that add no evidence and are not needed to document public reception.",
    "Untraceable citations, generated bibliographies and unattributed quotations; these become issues, never sources accepted as evidence.",
    "Duplicate editions or reprints only after their identity and equivalence have been explicitly adjudicated."
  ],
