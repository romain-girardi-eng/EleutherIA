data: {"type": "tool_result", "tool_call_id": "functions.search_passages:49", "result_summary": "5 passages loaded", "passages_touched": ["e2c01199-e0e5-53fe-b47b-4ac59a50eb9a", "53b5f781-38eb-5661-9e86-19339b93cf50", "27167f63-4816-5e6f-8e21-d885faf5a171", "4d546745-0a7f-57fb-8329-b57ba11e6dc6", "464f33dc-6828-410d-a6f5-b62891dedc80"], "duration_ms": 5}

