data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"b6c318f2-8577-49ee-8a73-26315325cccf\", \"excerpt\": \"\\u03c4\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd \\u03b4\\u2019 \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u1f10\\u03c7\\u03cc\\u03bd\\u03c4\\u03c9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u1ff6\\u03bd \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b5\\u1f30\\u03c2 \\u03c4\\u03bf\\u03cd\\u03c4\\u03bf\\u03c5\\u03c2 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03c5\\u03c2 \\u03bd\\u03b5\\u03bd\\u03b5\\u03bc\\u03b7\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f00\\u03ba\\u03cc\\u03bb\\u03bf\\u03c5\\u03b8\\u03bf\\u03bd \\u1f10\\u03c0\\u1f76 \\u03c4\\u03bf\\u03cd\\u03c4\\u03bf\\u03b9\\u03c2 \\u1f30\\u03b4\\u03b5\\u1fd6\\u03bd, \\u1f10\\u03bd \\u03c0\\u03bf\\u03af\\u1ff3 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03bf\\u03b9\\u03b7\\u03c4\\u03b9\\u03ba\\u1ff6\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03c9\\u03bd \\u03c7\\u03c1\\u1f74 \\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f74\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd. \\u1f06\\u03c1\\u03ac \\u03b3\\u03b5 \\u1f10\\u03bd \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03bf\\u1f50\\u03b4\\u03b5\\u03bd\\u1f78\\u03c2 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u03c7\\u03ac\\u03c1\\u03b9\\u03bd; \\u1f22 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03bc\\u1f72\\u03bd \\u03c0\\u03b1\\u03bd\\u03c4\\u03ac\\u03c0\\u03b1\\u03c3\\u03b9\\u03bd \\u1f04\\u03bb\\u03bf\\u03b3\\u03bf\\u03bd\\u00b7 \\u03b1\\u1f30\\u03b5\\u1f76 \\u03b3\\u1f70\\u03c1 \\u1f10\\u03c0\\u1f76 \\u03c4\\u03ad\\u03bb\\u03bf\\u03c5\\u03c2 \\u03c4\\u03b9\\u03bd\\u1f78\\u03c2 \\u03c4\\u1ff7 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u1f40\\u03bd\\u03cc\\u03bc\\u03b1\\u03c4\\u03b9 \\u03c7\\u03c1\\u03ce\\u03bc\\u03b5\\u03b8\\u03b1 \\u03ba\\u03b1\\u03b8\\u2019 \\u03