data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"6a47201d-f42b-4e41-8b18-c2be5d11a93a\", \"excerpt\": \"\\u03c4\\u03cc \\u03c4\\u03b5 \\u03b3\\u1f70\\u03c1 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03bf\\u03bd \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c6\\u03cd\\u03c3\\u03b9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c6\\u03cd\\u03c3\\u03b9\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03bf\\u03bd. \\u03bf\\u1f50 \\u03b3\\u1f70\\u03c1 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c6\\u03cd\\u03c3\\u03b9\\u03bd \\u03bc\\u03ad\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9\\u03bd \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03bd \\u1f10\\u03be \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03bf\\u03c5 \\u03ba\\u03b1\\u1f76 \\u1f35\\u03c0\\u03c0\\u03bf\\u03bd \\u1f10\\u03be \\u1f35\\u03c0\\u03c0\\u03bf\\u03c5 \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u03bf\\u1f50 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03b4\\u03ad, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03c3\\u03c5\\u03bd\\u03bf\\u03b4\\u03b5\\u03cd\\u03b5\\u03b9 \\u03c4\\u1f70 \\u03b1\\u1f34\\u03c4\\u03b9\\u03b1 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u1f00\\u03bb\\u03bb\\u03ae\\u03bb\\u03bf\\u03b9\\u03c2 \\u1f61\\u03c2 \\u1f02\\u03bd \\u1f14\\u03c7\\u03bf\\u03bd\\u03c4\\u03b1 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c4\\u03bf\\u1f54\\u03bd\\u03bf\\u03bc\\u03b1 \\u03bc\\u03cc\\u03bd\\u03bf\\u03bd \\u03c4\\u1f74\\u03bd \\u03b4\\u03b9\\u03b1\\u03c6\\u03bf\\u03c1\\u03ac\\u03bd. \\u03b4\\u03b9\\u1f78 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f70 \\u03c0\\u03c1\\u1ff6\\u03c4\\u03b1 \\u03c4\\u1fc6\\u03c2 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c6\\u03cd\\u03c3\\u03b9\\u03bd \\u1f11\\u03ba\\u03ac\\u03c3\\u03c4\\u03bf\\u03b9\\u03c2 \\u03b3\\u03b5\\u03bd\\u03ad\\u03c3\\u03b5\\u03c9\\u03c2 \\u03b1\\u1f34\\u03c4\\u03b9\\u03b1 (\\u1f14\\u03c3\\u03c4\\u03b9\\u03bd \\u03b4\\u1f72 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u27e8\\u03c4\\u03b1\\u1fe6\\u27e9 \\u03b8\\u03b5\\u1fd6\\u03b1 \\u03ba\\u03b1\\u1f76 \\u1f21 \\u03c4\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd \\u03b5\\u1f54\\u03c4\\u03b1\\u03ba\\u03c4\\u03bf\\u03c2 \\u03c0\\u03b5\\u03c1\\u03b9\\u03c6\\u03bf\\u03c1\\u1f70) \\u03ba\\u03b1\\u1f76 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u03b1\\u1f34\\u03c4\\u03b9\\u03b1 \\u03bb\\u03ad\\u03b3\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd. \\u03c0\\u03ac\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"9326c388-fcf3-41cd-8d59-c7e0085234a3\", \"excerpt\": \"\\u1f29 \\u03b4\\u1f72 \\u03ba\\u03b1\\u03c4\\u03b1\\u03c3\\u03ba\\u03b5\\u03c5\\u1f74 \\u03c4\\u1ff6\\u03bd \\u03b5\\u1f30\\u03c1\\u03b7\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f14\\u03c3\\u03c4\\u03b1\\u03b9 \\u03c6\\u03b1\\u03bd\\u03b5\\u03c1\\u03c9\\u03c4\\u03ad\\u03c1\\u03b1 \\u03c0\\u03b1\\u03c1\\u03b1\\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03c4\\u03c9\\u03bd \\u1f21\\u03bc\\u1ff6\\u03bd \\u03c4\\u03b1\\u1fd6\\u03c2 \\u03c0\\u03c1\\u03bf\\u03b7\\u03b3\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03b1\\u03b9\\u03c2 \\u03c4\\u1ff6\\u03bd \\u03ba\\u03b5\\u03b9\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f00\\u03c0\\u03bf\\u03b4\\u03b5\\u03af\\u03be\\u03b5\\u03c3\\u03b9\\u03bd \\u03c4\\u1f70 \\u1f11\\u03c0\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1 \\u1f04\\u03c4\\u03bf\\u03c0\\u03b1 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03bb\\u03ad\\u03b3\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd\\u00b7 \\u03bc\\u03b9\\u03b3\\u03bd\\u03cd\\u03bd\\u03c4\\u03b5\\u03c2 \\u03b3\\u1f70\\u03c1 \\u03bf\\u1f55\\u03c4\\u03c9 \\u03c4\\u1f78\\u03bd \\u03bb\\u03cc\\u03b3\\u03bf\\u03bd \\u03c4\\u1fc7 \\u03c4\\u1ff6\\u03bd \\u03b4\\u03bf\\u03be\\u1ff6\\u03bd \\u03c0\\u03b1\\u03c1\\u2019 \\u1f00\\u03bb\\u03bb\\u03ae\\u03bb\\u03b1\\u03c2 \\u03b8\\u03ad\\u03c3\\u03b5\\u03b9 \\u03b3\\u03bd\\u03c9\\u03c1\\u03b9\\u03bc\\u03ce\\u03c4\\u03b5\\u03c1\\u03bf\\u03bd \\u03c4\\u1f00\\u03bb\\u03b7\\u03b8\\u1f72\\u03c2 \\u03c0\\u03bf\\u03b9\\u03ae\\u03c3\\u03bf\\u03bc\\u03b5\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c0\\u03c1\\u1f78\\u03c2 \\u03c4\\u03bf\\u03cd\\u03c4\\u1ff3 \\u03bf\\u1f50\\u03c7 \\u1f15\\u03be\\u03bf\\u03bc\\u03b5\\u03bd \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03bd \\u03bc\\u03b5\\u03bc\\u03bd\\u1fc6