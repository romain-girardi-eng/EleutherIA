data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"2427aa5c-54fd-5395-ae7b-ffbf9ad2eb20\", \"excerpt\": \"Hippolytus Philos. 21 (DDG p. 571, 11). \\u03ba\\u03b1\\u1f76 \\u03b1\\u1f50\\u03c4\\u03bf\\u1f76 \\u03b4\\u1f72 (scil. Chrysippus et Zeno) \\u03c4\\u1f78 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b4\\u03b9\\u03b5\\u03b2\\u03b5\\u03b2\\u03b1\\u03b9\\u03ce\\u03c3\\u03b1\\u03bd\\u03c4\\u03bf \\u03c0\\u03b1\\u03c1\\u03b1\\u03b4\\u03b5\\u03af\\u03b3\\u03bc\\u03b1\\u03c4\\u03b9 \\u03c7\\u03c1\\u03b7\\u03c3\\u03ac\\u03bc\\u03b5\\u03bd\\u03bf\\u03b9 \\u03c4\\u03bf\\u03b9\\u03bf\\u03cd\\u03c4\\u1ff3, \\u1f45\\u03c4\\u03b9 \\u1f65\\u03c3\\u03c0\\u03b5\\u03c1 \\u1f40\\u03c7\\u03ae\\u03bc\\u03b1\\u03c4\\u03bf\\u03c2 \\u1f10\\u1f70\\u03bd \\u1f96 \\u1f10\\u03be\\u03b7\\u03c1\\u03c4\\u03b7\\u03bc\\u03ad\\u03bd\\u03bf\\u03c2 \\u03ba\\u03cd\\u03c9\\u03bd, \\u1f10\\u1f70\\u03bd \\u03bc\\u1f72\\u03bd \\u03b2\\u03bf\\u03cd\\u03bb\\u03b7\\u03c4\\u03b1\\u03b9 \\u1f15\\u03c0\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u03ba\\u03b1\\u1f76 \\u1f15\\u03bb\\u03ba\\u03b5\\u03c4\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u1f15\\u03c0\\u03b5\\u03c4\\u03b1\\u03b9, \\u03c0\\u03bf\\u03b9\\u1ff6\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03bd \\u03bc\\u03b5\\u03c4\\u1f70 \\u03c4\\u1fc6\\u03c2 \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03c2 [\\u03bf\\u1f37\\u03bf\\u03bd \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2]\\u00b7 \\u1f10\\u1f70\\u03bd \\u03b4\\u1f72 \\u03bc\\u1f74 \\u03b2\\u03bf\\u03cd\\u03bb\\u03b7\\u03c4\\u03b1\\u03b9 \\u1f15\\u03c0\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03c2 \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03b1\\u03c3\\u03b8\\u03ae\\u03c3\\u03b5\\u03c4\\u03b1\\u03b9\\u00b7 \\u03c4\\u1f78 \\u03b1\\u1f50\\u03c4\\u1f78 \\u03b4\\u03ae\\u03c0\\u03bf\\u03c5 \\u03ba\\u03b1\\u1f76 \\u1f10\\u03c0\\u1f76 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

