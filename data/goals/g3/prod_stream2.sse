data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"aed97e25-98dd-4935-9ec7-80c5dc348ce7\", \"excerpt\": \"**Reference:** De Fato 14\\n**Author:** Alexander of Aphrodisias\\n**Work:** De Fato\\n**Edition:** Bruns (CAG Suppl. II.2)\\n\\n**Original Greek:**\\n\\u1f14\\u03bd\\u03b5\\u03c3\\u03c4\\u03b9 \\u03b4' \\u1f41\\u03c1\\u1fb6\\u03bd, \\u03b5\\u1f30 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u03bb\\u03ad\\u03b3\\u03bf\\u03bd\\u03c4\\u03b5\\u03c2 \\u03c3\\u03ce\\u03b6\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd \\u03c4\\u1f70\\u03c2 \\u03ba\\u03bf\\u03b9\\u03bd\\u1f70\\u03c2 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd \\u03c0\\u03c1\\u03bf\\u03bb\\u03ae\\u03c8\\u03b5\\u03b9\\u03c2. \\u03bf\\u1f31 \\u03b3\\u1f70\\u03c1 \\u1f00\\u03c0\\u03b1\\u03b9\\u03c4\\u03bf\\u1fe6\\u03bd\\u03c4\\u03b5\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u03cd\\u03c2, \\u03c0\\u1ff6\\u03c2 \\u03bf\\u1f37\\u03cc\\u03bd \\u03c4\\u03b5 \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u1f44\\u03bd\\u03c4\\u03c9\\u03bd \\u03ba\\u03b1\\u03b8' \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03c4\\u1f78 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c3\\u03ce\\u03b6\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u03bf\\u1f50\\u03ba \\u1f44\\u03bd\\u03bf\\u03bc\\u03b1 \\u03bc\\u03cc\\u03bd\\u03bf\\u03bd \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03c4\\u03b5\\u03c2 \\u03c4\\u03bf\\u1fe6\\u03c4' \\u1f00\\u03c0\\u03b1\\u03b9\\u03c4\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03ba\\u03b1\\u1f76 \\u03c3\\u03b7\\u03bc\\u03b1\\u03b9\\u03bd\\u03cc\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"537989b4-73ef-59db-a94e-882cec72834d\", \"excerpt\": \"Alexander Aphrod. de fato cp. 14 p. 183, 21 Bruns. \\u1f10\\u03c0\\u1f76 \\u03c4\\u03bf\\u03cd\\u03c4\\u1ff3 \\u03b4\\u1f72 \\u1f10\\u03ba\\u03b5\\u1fd6\\u03bd\\u03bf \\u1f04\\u03bd \\u03c4\\u03b9\\u03c2 \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd \\u03b8\\u03b1\\u03c5\\u03bc\\u03ac\\u03c3\\u03b5\\u03b9\\u03b5\\u03bd, \\u03c4\\u03af \\u03c0\\u03b1\\u03b8\\u03cc\\u03bd\\u03c4\\u03b5\\u03c2 \\u1f10\\u03bd \\u03c4\\u1fc7 \\u1f41\\u03c1\\u03bc\\u1fc7 \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03c3\\u03c5\\u03b3\\u03ba\\u03b1\\u03c4\\u03b1\\u03b8\\u03ad\\u03c3\\u03b5\\u03b9 \\u03c4\\u1f78 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c6\\u03b1\\u03c3\\u03b9\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9, \\u03b4\\u03b9\\u2019 \\u1f43 \\u03ba\\u03b1\\u1f76 \\u1f41\\u03bc\\u03bf\\u03af\\u03c9\\u03c2 \\u1f10\\u03bd \\u03c0\\u1fb6\\u03c3\\u03b9 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03b6\\u1ff4\\u03bf\\u03b9\\u03c2 \\u03c4\\u03b7\\u03c1\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd \\u03b1\\u1f50\\u03c4\\u03cc. \\u03bf\\u1f50 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1f78 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03c6\\u03b1\\u03bd\\u03c4\\u03b1\\u03c3\\u03af\\u03b1\\u03c2 \\u03c0\\u03c1\\u03bf\\u03c3\\u03c0\\u03b5\\u03c3\\u03bf\\u03cd\\u03c3\\u03b7\\u03c2 \\u03b5\\u1f36\\u03be\\u03b1\\u03af \\u03c4\\u03b5 \\u1f10\\u03be \\u1f11\\u03b1\\u03c5\\u03c4\\u1ff6\\u03bd \\u03c4\\u1fc7 \\u03c6\\u03b1\\u03bd\\u03c4\\u03b1\\u03c3\\u03af\\u1fb3 \\u03ba\\u03b1\\u1f76 \\u1f41\\u03c1\\u03bc\\u1fc6\\u03c3\\u03b1\\u03b9 \\u1f10\\u03c0\\u1f76 \\u03c4\\u1f78 \\u03c6\\u03b1\\u03bd\\u03ad\\u03bd. p. 184, 11. \\u03b5\\u1f30 \\u03b4\\u1f72 \\u03c4\\u1f78 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9 \\u1f10\\u03bd \\u03c4\\u1fc7 \\u03bb\\u03bf\\u03b3\\u03b9\\u03ba\\u1fc7 \\u03c3\\u03c5\\u03b3\\u03ba\\u03b1\\u03c4\\u03b1\\u03b8\\u03ad\\u03c3\\u03b5\\u03b9, \\u1f25\\u03c4\\u03b9\\u03c2 \\u03b4\\u03b9\\u1f70 \\u03c4\\u03bf\\u1fe6 \\u03b2\\u03bf\\u03c5\\u03bb\\u03b5\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"6d9d85c8-ffa3-48f5-b5fe-9ef25cd19aa0\", \"excerpt\": \"**Reference:** De Fato 15\\n**Author:** Alexander of Aphrodisias\\n**Work:** De Fato\\n**Edition:** Bruns (CAG Suppl. II.2)\\n\\n**Original Greek:**\\n\\u03b4\\u03b9\\u1f70 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1f74\\u03bd \\u03c4\\u03bf\\u03b9\\u03b1\\u03cd\\u03c4\\u03b7\\u03bd \\u1f10\\u03be\\u03bf\\u03c5\\u03c3\\u03af\\u03b1\\u03bd \\u1f10\\u03c3\\u03c4\\u03af \\u03c4\\u03b9 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd, \\u1f45\\u03c4\\u03b9 \\u03c4\\u1ff6\\u03bd \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f21\\u03bc\\u03b5\\u1fd6\\u03c2 \\u1f10\\u03c3\\u03bc\\u03b5\\u03bd \\u03ba\\u03cd\\u03c1\\u03b9\\u03bf\\u03b9, \\u1f00\\u03bb\\u03bb' \\u03bf\\u1f50\\u03ba \\u1f14\\u03be\\u03c9\\u03b8\\u03ad\\u03bd \\u03c4\\u03b9\\u03c2 \\u03b1\\u1f30\\u03c4\\u03af\\u03b1. [...] \\u1f41 \\u03b3\\u1f70\\u03c1 \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03c2 \\u1f00\\u03c1\\u03c7\\u1f74 \\u03ba\\u03b1\\u1f76 \\u03b1\\u1f30\\u03c4\\u03af\\u03b1 \\u03c4\\u1ff6\\u03bd \\u03b4\\u03b9' \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c0\\u03c1\\u03ac\\u03be\\u03b5\\u03c9\\u03bd.\\n\\n**English Translation (Sharples 1983):**\\nFor it is because of such power\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"7daa3f8a-7094-5fe7-97e9-75636177596e\", \"excerpt\": \"Alexander Aphrod. de fato cp. 26 p. 196, 13 Bruns. \\u1f05 \\u03b4\\u1f72 \\u1f00\\u03c0\\u03bf\\u03c1\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd \\u03c0\\u03c1\\u1f78\\u03c2 \\u03c4\\u1f78 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u03bf\\u03b9\\u03bf\\u1fe6\\u03c4\\u03bf\\u03bd \\u03c4\\u1f78 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd, \\u1f41\\u03c0\\u03bf\\u1fd6\\u03bf\\u03bd \\u1f21 \\u03ba\\u03bf\\u03b9\\u03bd\\u1f74 \\u03c0\\u03c1\\u03cc\\u03bb\\u03b7\\u03c8\\u03b9\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd \\u03c0\\u03b5\\u03c0\\u03af\\u03c3\\u03c4\\u03b5\\u03c5\\u03ba\\u03b5\\u03bd, \\u1f00\\u03c0\\u03bf\\u03c1\\u03b5\\u1fd6\\u03bd \\u03bc\\u1f72\\u03bd \\u03bf\\u1f50\\u03ba \\u1f04\\u03bb\\u03bf\\u03b3\\u03bf\\u03bd, \\u03c4\\u1f78 \\u03b4\\u1f72 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f00\\u03c0\\u03bf\\u03c1\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u1f10\\u03c0\\u03bf\\u03c7\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u1f61\\u03c2 \\u1f41\\u03bc\\u03bf\\u03bb\\u03bf\\u03b3\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\uff0d \\u03c3\\u03c5\\u03bd\\u03b1\\u03b3\\u03c9\\u03bd\\u03af\\u03b6\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f00\\u03c0\\u03bf\\u03c1\\u03bf\\u03c5\\u03bc\\u03ad\\u03bf\\u03b9\\u03c2 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b1\\u1f51\\u03c4\\u1ff6\\u03bd, \\u03c0\\u1ff6\\u03c2 \\u03bf\\u1f50 \\u03c0\\u03b1\\u03bd\\u03c4\\u03ac\\u03c0\\u03b1\\u03c3\\u03b9\\u03bd \\u1f04\\u03bb\\u03bf\\u03b3\\u03bf\\u03bd; 21. \\u03bf\\u1f50 \\u03c7\\u03b5\\u1fd6\\u03c1\\u03bf\\u03bd \\u03b4\\u1f72 \\u1f34\\u03c3\\u03c9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f21\\u03bc\\u1fb6\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03c0\\u03bf\\u03c1\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f51\\u03c6' \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd, \\u03bf\\u1f37\\u03c2 \\u03bc\\u03ac\\u03bb\\u03b9\\u03c3\\u03c4\\u03b1 \\u03b8\\u03b1\\u1fe4\\u1fe5\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd, \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u03c0\\u03c1\\u03bf\\u03c7\\u03b5\\u03b9\\u03c1\\u03b9\\u03c3\\u03b1\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"851632f4-304e-5ae8-972a-561ccdfffac4\", \"excerpt\": \"Alexander Aphrod. de fato cp. 13 p. 181, 13 Bruns. \\u1f00\\u03bd\\u03b1\\u03b9\\u03c1\\u03bf\\u1fe6\\u03bd\\u03c4\\u03b5\\u03c2 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1f78 \\u1f10\\u03be\\u03bf\\u03c5\\u03c3\\u03af\\u03b1\\u03bd \\u1f14\\u03c7\\u03b5\\u03b9\\u03bd \\u03c4\\u1f78\\u03bd \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03bd \\u03c4\\u1fc6\\u03c2 \\u03b1\\u1f31\\u03c1\\u03ad\\u03c3\\u03b5\\u03ce\\u03c2 \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03c1\\u03ac\\u03be\\u03b5\\u03c9\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bd\\u03c4\\u03b9\\u03ba\\u03b5\\u03b9\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03bb\\u03ad\\u03b3\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f78 \\u03b3\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd \\u27e8\\u03ba\\u03b1\\u03b8\\u2019 \\u1f41\\u03c1\\u03bc\\u1f74\\u03bd\\u27e9 \\u03b4\\u03b9\\u2019 \\u1f21\\u03bc\\u1ff6\\u03bd. \\u1f10\\u03c0\\u03b5\\u1f76 \\u03b3\\u03ac\\u03c1, \\u03c6\\u03b1\\u03c3\\u03af\\u03bd, \\u03c4\\u1ff6\\u03bd \\u1f44\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f31 \\u03c6\\u03cd\\u03c3\\u03b5\\u03b9\\u03c2 \\u1f15\\u03c4\\u03b5\\u03c1\\u03b1\\u03af \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b9\\u03ac\\u03c6\\u03bf\\u03c1\\u03bf\\u03b9 (\\u03bf\\u1f50 \\u03b3\\u1f70\\u03c1 \\u03b1\\u1f31 \\u03b1\\u1f50\\u03c4\\u03b1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03bc\\u03c8\\u03cd\\u03c7\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03c8\\u03cd\\u03c7\\u03c9\\u03bd, \\u1f00\\u03bb\\u03bb\\u2019 \\u03bf\\u1f50\\u03b4\\u1f72 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03bc\\u03c8\\u03cd\\u03c7\\u03c9\\u03bd \\u1f01\\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u0