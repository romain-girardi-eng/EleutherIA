data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"72d8e55e-1407-5441-9b21-5993abe19a7d\", \"excerpt\": \"Plutarchus de Stoic. repugn. cp. 47 p. 1056b. \\u1f49 \\u03b4\\u1f72 \\u03bb\\u03ad\\u03b3\\u03c9\\u03bd \\u1f45\\u03c4\\u03b9 \\u03a7\\u03c1\\u03cd\\u03c3\\u03b9\\u03c0\\u03c0\\u03bf\\u03c2 \\u03bf\\u1f50\\u03ba \\u03b1\\u1f50\\u03c4\\u03bf\\u03c4\\u03b5\\u03bb\\u1fc6 \\u03c4\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd (sc. \\u03c4\\u03bf\\u1fe6 \\u03ba\\u03b1\\u03c4\\u03bf\\u03c1\\u03b8\\u03bf\\u1fe6\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c6\\u03c1\\u03bf\\u03bd\\u03b5\\u1fd6\\u03bd) \\u1f00\\u03bb\\u03bb\\u1f70 \\u03c0\\u03c1\\u03bf\\u03ba\\u03b1\\u03c4\\u03b1\\u03c1\\u03c4\\u03b9\\u03ba\\u1f74\\u03bd \\u03bc\\u03cc\\u03bd\\u03bf\\u03bd \\u1f10\\u03c0\\u03bf\\u03b9\\u03b5\\u1fd6\\u03c4\\u03bf \\u03c4\\u1f74\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd, \\u1f10\\u03ba\\u03b5\\u1fd6 \\u03c0\\u03ac\\u03bb\\u03b9\\u03bd \\u03b1\\u1f50\\u03c4\\u1f78\\u03bd \\u1f00\\u03c0\\u03bf\\u03b4\\u03b5\\u03af\\u03be\\u03b5\\u03b9 \\u03bc\\u03b1\\u03c7\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd \\u03c0\\u03c1\\u1f78\\u03c2 \\u03b1\\u1f51\\u03c4\\u03cc\\u03bd, \\u1f45\\u03c0\\u03bf\\u03c5 \\u03c4\\u1f78\\u03bd \\u03bc\\u1f72\\u03bd \\u1f4d\\u03bc\\u03b7\\u03c1\\u1f78\\u03bd \\u1f51\\u03c0\\u03b5\\u03c1\\u03c6\\u03c5\\u1ff6\\u03c2 \\u1f10\\u03c0\\u03b1\\u03b9\\u03bd\\u03b5\\u1fd6 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u03bf\\u1fe6 \\u0394\\u03b9\\u1f78\\u03c2 \\u03bb\\u03ad\\u03b3\\u03bf\\u03bd\\u03c4\\u03b1 (\\u039f 109) \\u03a4\\u1ff7 \\u1f14\\u03c7\\u03b5\\u03b8\\u2019 \\u1f45\\u03c4\\u03c4\\u03b9 \\u03ba\\u03b5\\u03bd \\u1f54\\u03bc\\u03bc\\u03b9 \\u03ba\\u03b1\\u03ba\\u1f78\\u03bd \\u03c0\\u03ad\\u03bc\\u03c0\\u03b7\\u03c3\\u03b9\\u03bd \\u1f11\\u03ba\\u03ac\\u03c3\\u03c4\\u1ff3 \\u1f22 \\u1f00\\u03b3\\u03b1\\u03b8\\u03cc\\u03bd\\u00b7 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78\\u03bd \\u0395\\u1f50\\u03c1\\u03b9\\u03c0\\u03af\\u03b4\\u03b7\\u03bd (Suppl. 734) \\u1f6e \\u0396\\u03b5\\u1fe6, \\u03c4\\u03af \\u03b4\\u1fc6\\u03c4\\u03b1 \\u03c4\\u03bf\\u1f7a\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"51fa918c-fdb1-5876-892d-e10449667ebd\", \"excerpt\": \"Diogenianus apud Eusebium praep. evang. IV 3 p. 136. [\\u1f10\\u03be\\u03b1\\u03c1\\u03ba\\u03b5\\u1fd6\\u03bd \\u1f14\\u03bc\\u03bf\\u03b9\\u03b3\\u03b5 \\u1f21\\u03b3\\u03bf\\u1fe6\\u03bc\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03bc\\u03af\\u03b1\\u03bd \\u1f11\\u03bd\\u1f78\\u03c2 \\u03c4\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd \\u03c0\\u03b1\\u03c1\\u03ac\\u03b8\\u03b5\\u03c3\\u03b9\\u03bd \\u1f00\\u03c0\\u03b1\\u03bd\\u03c4\\u1ff6\\u03c3\\u03b1\\u03bd \\u03c0\\u03c1\\u1f78\\u03c2 \\u03c4\\u1f70 \\u03a7\\u03c1\\u03c5\\u03c3\\u03af\\u03c0\\u03c0\\u1ff3 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u1f00\\u03c0\\u1f78 \\u03c4\\u1fc6\\u03c2 \\u03c4\\u1ff6\\u03bd \\u03bc\\u03b1\\u03bd\\u03c4\\u03b5\\u03af\\u03c9\\u03bd \\u03c0\\u03c1\\u03bf\\u1fe4\\u1fe5\\u03ae\\u03c3\\u03b5\\u03c9\\u03c2 \\u03ba\\u03b1\\u03c4\\u03b1\\u03c3\\u03ba\\u03b5\\u03c5\\u03b1\\u03c3\\u03b8\\u03ad\\u03bd\\u03c4\\u03b1. \\u03b3\\u03c1\\u03ac\\u03c6\\u03b5\\u03b9 \\u03b4\\u2019 \\u03bf\\u1f56\\u03bd \\u03c0\\u03c1\\u1f78\\u03c2 \\u03b1\\u1f50\\u03c4\\u1f78\\u03bd \\u1f41 \\u03c3\\u03c5\\u03b3\\u03b3\\u03c1\\u03b1\\u03c6\\u03b5\\u1f7a\\u03c2 \\u1f00\\u03c0\\u03b5\\u03bb\\u03ad\\u03b3\\u03c7\\u03c9\\u03bd \\u1f45\\u03c4\\u03b9 \\u03ba\\u03b1\\u03ba\\u1ff6\\u03c2 \\u1f10\\u03ba \\u03c4\\u1ff6\\u03bd \\u03bc\\u03b1\\u03bd\\u03c4\\u03b5\\u03af\\u03c9\\u03bd \\u03c3\\u03b7\\u03bc\\u03b5\\u03b9\\u03bf\\u1fe6\\u03c4\\u03b1\\u03b9 \\u03c4\\u1f74\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd etc.] \\u03a6\\u03ad\\u03c1\\u03b5\\u03b9 \\u03b4\\u1f72 \\u03ba\\u03b1\\u1f76 \\u1f04\\u03bb\\u03bb\\u03b7\\u03bd \\u1f00\\u03c0\\u03cc\\u03b4\\u03b5\\u03b9\\u03be\\u03b9\\u03bd \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03c0\\u03c1\\u03bf\\u03b5\\u03b9\\u03c1\\u03b7\\u03bc\\u03ad\\u03bd\\u1ff3 \\u03b2\\u03b9\\u03b2\\u03bb\\u03af\\u1ff3 (scil. Chrysippus \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2) \\u03c4\\u03bf\\u03b9\\u03b1\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

