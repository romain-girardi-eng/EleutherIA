data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"5ddcd110-4479-5a11-aba8-9aec44bab8af\", \"excerpt\": \"Alexander Aphrod. de fato cp. 9 p. 175, 7 Bruns. \\u039a\\u03b1\\u03af\\u03c4\\u03bf\\u03b9 \\u03c0\\u1ff6\\u03c2 \\u03bf\\u1f50\\u03ba \\u1f04\\u03c4\\u03bf\\u03c0\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03b1\\u03c1\\u1f70 \\u03c4\\u1f70 \\u1f10\\u03bd\\u03b1\\u03c1\\u03b3\\u1fc6 \\u03ba\\u03b1\\u1f76 \\u03bc\\u03ad\\u03c7\\u03c1\\u03b9 \\u03c4\\u03bf\\u03cd\\u03c4\\u03bf\\u03c5 \\u03c4\\u1f74\\u03bd \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03bd \\u03c0\\u03c1\\u03bf\\u03b5\\u03bb\\u03b7\\u03bb\\u03c5\\u03b8\\u03ad\\u03bd\\u03b1\\u03b9 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd, \\u1f61\\u03c2 \\u03bc\\u03ae\\u03c4\\u03b5 \\u03ba\\u03b9\\u03bd\\u03b7\\u03b8\\u1fc6\\u03bd\\u03b1\\u03af \\u03c4\\u03b9\\u03bd\\u03b1 \\u03b4\\u03cd\\u03bd\\u03b1\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u03af\\u03bd\\u03b7\\u03c3\\u03af\\u03bd \\u03c4\\u03b9\\u03bd\\u03b1, \\u03bc\\u03ae\\u03c4\\u03b5 \\u03ba\\u03b9\\u03bd\\u1fc6\\u03c3\\u03b1\\u03af \\u03c4\\u03b9 \\u03c4\\u1ff6\\u03bd \\u03b1\\u1f51\\u03c4\\u03bf\\u1fe6 \\u03bc\\u03b5\\u03c1\\u1ff6\\u03bd, \\u1f23\\u03bd \\u03ba\\u03af\\u03bd\\u03b7\\u03c3\\u03b9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03bc\\u1f74 \\u03ba\\u03b9\\u03bd\\u03b5\\u1fd6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u03cc\\u03c4\\u03b5 \\u03bf\\u1f37\\u03cc\\u03bd \\u03c4\\u03b5 \\u1f26\\u03bd, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03c4\\u1f74\\u03bd \\u03c4\\u03c5\\u03c7\\u03bf\\u1fe6\\u03c3\\u03b1\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03c4\\u03c1\\u03b1\\u03c7\\u03ae\\u03bb\\u03bf\\u03c5 \\u03c0\\u03b5\\u03c1\\u03b9\\u03c3\\u03c4\\u03c1\\u03bf\\u03c6\\u1f74\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f74\\u03bd \\u03b4\\u03b1\\u03ba\\u03c4\\u03cd\\u03bb\\u03bf\\u03c5 \\u03c4\\u03b9\\u03bd\\u1f78\\u03c2 \\u1f14\\u03ba\\u03c4\\u03b1\\u03c3\\u03b9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u1f10\\u03c0\\u1fb6\\u03c1\\u03b1\\u03b9 \\u03c4\\u1f70 \