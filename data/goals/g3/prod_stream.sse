data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"e311f0e8-1149-4a8d-923e-d30893414a99\", \"excerpt\": \"\\u03a4\\u03bf\\u1fe6 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u03c7\\u03c1\\u03b7\\u03c3\\u03c4\\u03b7\\u03c1\\u03af\\u03c9\\u03bd \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03c5 \\u03b4\\u03b9\\u1f70 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03b4\\u03b9\\u03b7\\u03bd\\u03c5\\u03c3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f50\\u03c4\\u03ac\\u03c1\\u03ba\\u03c9\\u03c2 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f00\\u03c0\\u03b5\\u03bb\\u03b7\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5, \\u03ba\\u03b1\\u1f76 \\u03c4\\u1fc6\\u03c2 \\u03b8\\u03b5\\u03af\\u03b1\\u03c2 \\u03b4\\u03c5\\u03bd\\u03ac\\u03bc\\u03b5\\u03c9\\u03c2 \\u03c4\\u03bf\\u1fe6 \\u03c3\\u03c9\\u03c4\\u1fc6\\u03c1\\u03bf\\u03c2 \\u1f21\\u03bc\\u1ff6\\u03bd \\u03b4\\u03b9\\u1f70 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f50\\u03b1\\u03b3\\u03b3\\u03b5\\u03bb\\u03b9\\u03ba\\u1fc6\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03b4\\u03b9\\u03b4\\u03b1\\u03c3\\u03ba\\u03b1\\u03bb\\u03af\\u03b1\\u03c2 \\u03c4\\u1f78 \\u03b8\\u03b5\\u03bf\\u03c0\\u03c1\\u03b5\\u03c0\\u1f72\\u03c2 \\u1f05\\u03bc\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03b2\\u03b9\\u03c9\\u03c6\\u03b5\\u03bb\\u1f72\\u03c2 \\u1f10\\u03c0\\u03b9\\u03b4\\u03b5\\u03b4\\u03b5\\u03b9\\u03b3\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2, \\u1f45\\u03c4\\u03b9 \\u03b4\\u1f74 \\u03b4\\u03b9\\u1f70 \\u03bc\\u03cc\\u03bd\\u03b7\\u03c2 \\u03b1\\u1f50\\u03c4\\u1fc6\\u03c2, \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f50 \\u03b4\\u03b9\\u1fbf \\u1f04\\u03bb\\u03bb\\u03b7\\u03c2, \\u03c4\\u1ff6\\u03bd \\u1f10\\u03be \\u03b1\\u1f30\\u1ff6\\u03bd\\u03bf\\u03c2 \\u03c4\\u1f78\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b2\\u03af\\u03bf\\u03bd \\u1f10\\u03c0\\u03b9\\u03c3\\u03ba\\u03bf\\u03c4\\u03b9\\u03c3\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03bb\\u03c5\\u03bc\\u03b7\\u03bd\\u03b1\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b4\\u03b1\\u03b9\\u03bc\\u03bf\\u03bd\\u03b9\\u03ba\\u1ff6\\u03bd \\u03c6\\u03b1\\u03bd\\u03c4\\u03b1\\u03c3\\u03bc\\u03ac\\u03c4\\u03c9\\u03bd \\u1f10\\u03bb\\u03b5\\u03c5\\u03b8\\u03b5\\u03c1\\u03af\\u03b1 \\u03c0\\u1fb6\\u03c3\\u03b9\\u03bd \\u1f51\\u03c0\\u1fc6\\u03c1\\u03c7\\u03b5\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03bf\\u03b9\\u03c2, \\u03c6\\u03ad\\u03c1\\u03b5 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Praeparatio Evangelica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"e9fdbe35-ec55-4019-9055-431476babd6c\", \"excerpt\": \"\\u03bc\\u03b7\\u03b4\\u1f72 \\u1f10\\u03ba\\u03b5\\u1fd6\\u03bd\\u03bf\\u03bd \\u03b4\\u1f72 \\u03c0\\u03b1\\u03c1\\u03b1\\u03bb\\u03b5\\u03af\\u03c0\\u03c9\\u03bc\\u03b5\\u03bd \\u03c4\\u1f78\\u03bd \\u03bb\\u03cc\\u03b3\\u03bf\\u03bd, \\u1fa7 \\u03b8\\u03b1\\u03c1\\u03c1\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd \\u1f61\\u03c2 \\u03b4\\u03b5\\u03b9\\u03ba\\u03bd\\u03cd\\u03bd\\u03b1\\u03b9 \\u03b4\\u03c5\\u03bd\\u03b1\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03ba\\u03b5\\u03b9\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c4\\u03b9. \\u03bb\\u03ad\\u03b3\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd \\u03b3\\u1f70\\u03c1 \\u03bf\\u1f50 \\u03b3\\u1f70\\u03c1 \\u1f14\\u03c3\\u03c4\\u03b9 \\u03bc\\u1f72\\u03bd \\u03c4\\u03bf\\u03b9\\u03b1\\u03cd\\u03c4\\u03b7 \\u1f21 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7, \\u03bf\\u1f50\\u03ba \\u1f14\\u03c3\\u03c4\\u03b9 \\u03b4\\u1f72 \\u03c0\\u03b5\\u03c0\\u03c1\\u03c9\\u03bc\\u03ad\\u03bd\\u03b7, * * * \\u03bf\\u1f50\\u03ba \\u1f14\\u03c3\\u03c4\\u03b9 \\u03b4\\u1f72 \\u03b1\\u1f36\\u03c3\\u03b1, \\u03bf\\u1f50\\u03b4\\u1f72 \\u1f14\\u03c3\\u03c4\\u03b9 \\u03bc\\u1f72\\u03bd \\u03b1\\u1f36\\u03c3\\u03b1, \\u03bf\\u1f50\\u03ba \\u1f14\\u03c3\\u03c4\\u03b9 \\u03b4\\u1f72 \\u03bd\\u03ad\\u03bc\\u03b5\\u03c3\\u03b9\\u03c2, \\u03bf\\u1f50\\u03b4\\u1f72 \\u1f14\\u03c3\\u03c4\\u03b9 \\u03bc\\u1f72\\u03bd \\u03bd\\u03ad\\u03bc\\u03b5\\u03c3\\u03b9\\u03c2. \\u03bf\\u1f50\\u03ba \\u1f14\\u03c3\\u03c4\\u03b9 \\u03b4\\u1f72 \\u03bd\\u03cc\\u03bc\\u03bf\\u03c2, \\u03bf\\u1f50\\u03b4\\u2019 \\u1f14\\u03c3\\u03c4\\u03b9 \\u03bc\\u1f72\\u03bd \\u03bd\\u03cc\\u03bc\\u03bf\\u03c2, \\u03bf\\u1f50\\u03b4\\u2019 \\u1f14\\u03c3\\u03c4\\u03b9\\u03bd \\u03b4\\u1f72 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c2 \\u1f40\\u03c1\\u03b8\\u1f78\\u03c2 \\u03c0\\u03c1\\u03bf\\u03c3\\u03c4\\u03b1\\u03ba\\u03c4\\u03b9\\u03ba\\u1f78\\u03c2 \\u03bc\\u1f72\\u03bd \\u1f67\\u03bd \\u03c0\\u03bf\\u03b9\\u03b7\\u03c4\\u03ad\\u03bf\\u03bd, \\u1f00\\u03c0\\u03b1\\u03b3\\u03bf\\u03c1\\u03b5\\u03c5\\u03c4\\u03b9\\u03ba\\u1f78\\u03c2 \\u03b4\\u1f72 \\u1f67\\u03bd \\u03bf\\u1f50 \\u03c0\\u03bf\\u03b9\\u03b7\\u03c4\\u03ad\\u03bf\\u03bd. \\u1f00\\u03bb\\u03bb\\u1f70 \\u1f00\\u03c0\\u03b1\\u03b3\\u03bf\\u03c1\\u03b5\\u03cd\\u03b5\\u03c4\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"1c429d14-3b7a-4cb6-a678-0a1751081e93\", \"excerpt\": \"\\u03b8\\u03b5\\u03c3\\u03bc\\u03cc\\u03c2 \\u03c4\\u03b5 \\u1f08\\u03b4\\u03c1\\u03b1\\u03c3\\u03c4\\u03b5\\u03af\\u03b1\\u03c2 \\u1f45\\u03b4\\u03b5:\\n\\u1f23\\u03c4\\u03b9\\u03c2 \\u1f02\\u03bd \\u03c8\\u03c5\\u03c7\\u1f74 \\u03c3\\u03c5\\u03bd\\u03bf\\u03c0\\u03b1\\u03b4\\u1f78\\u03c2 \\u03b3\\u03b5\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03b7 \\u03ba\\u03b1\\u03c4\\u03af\\u03b4\\u1fc3 \\u03c4\\u03b9 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bb\\u03b7\\u03b8\\u1ff6\\u03bd, \\u03bc\\u03ad\\u03c7\\u03c1\\u03b9 \\u03c4\\u1fc6\\u03c2 \\u1f11\\u03c4\\u03ad\\u03c1\\u03b1\\u03c2 \\u03c0\\u03b5\\u03c1\\u03b9\\u03cc\\u03b4\\u03bf\\u03c5 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u1f00\\u03c0\\u03ae\\u03bc\\u03bf\\u03bd\\u03b1:\\n\\u03ba\\u1f02\\u03bd \\u1f00\\u03b5\\u1f76 \\u03b4\\u03cd\\u03bd\\u03b7\\u03c4\\u03b1\\u03b9 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03c0\\u03bf\\u03b9\\u03b5\\u1fd6\\u03bd, \\u1f00\\u03b5\\u1f76 \\u1f00\\u03b2\\u03bb\\u03b1\\u03b2\\u1fc6 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9.\\\"\\n\\u03c4\\u03bf\\u03b9\\u03bf\\u1fe6\\u03c4\\u03bf\\u03bd \\u03bc\\u1f72\\u03bd \\u03b4\\u1f74 \\u03c4\\u1f78 \\u1f10\\u03be \\u1f51\\u03c0\\u03bf\\u03b8\\u03ad\\u03c3\\u03b5\\u03c9\\u03c2 \\u1f05\\u03bc\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03ba\\u03b1\\u03b8\\u03cc\\u03bb\\u03bf\\u03c5. \\u1f45\\u03c4\\u03b9 \\u03b4\\u1f72 \\u03ba\\u03b1\\u1f76 \\u1f21 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7 \\u03c4\\u03bf\\u03b9\\u03bf\\u1fe6\\u03c4\\u03bf\\u03bd \\u03c4\\u03c5\\u03b3\\u03c7\\u03ac\\u03bd\\u03b5\\u03b9 \\u1f44\\u03bd, \\u1f14\\u03ba \\u03c4\\u03b5 \\u03c4\\u1fc6\\u03c2 \\u03bf\\u1f50\\u03c3\\u03af\\u03b1\\u03c2 \\u03b1\\u1f50\\u03c4\\u1fc6\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f10\\u03ba \\u03c4\\u1fc6\\u03c2 \\u03c0\\u03c1\\u03bf\\u03c3\\u03b7\\u03b3\\u03bf\\u03c1\\u03af\\u03b1\\u03c2 \\u03b4\\u1fc6\\u03bb\\u03bf\\u03bd. \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7 \\u03c4\\u03b5 \\u03b3\\u1f70\\u03c1 \\u03c0\\u03c1\\u03bf\\u03c3\\u03b1\\u03b3\\u03bf\\u03c1\\u03b5\\u03cd\\u03b5\\u03c4\\u03b1\\u03b9 \\u1f61\\u03c2 \\u1f02\\u03bd \\u03b5\\u1f30\\u03c1\\u03bf\\u03bc\\u03ad\\u03bd\\u03b7 \\u03c4\\u03b9\\u03c2:\\n\\u03b8\\u03b5\\u03c3\\u03bc\\u1f78\\u03c2 \\u03b4\\u1f72 \\u03ba\\u03b1\\u1f76 \\u03bd\\u03cc\\u03bc\\u03bf\\u03c2 \\u1f51\\u03c0\\u03ac\\u03c1\\u03c7\\u03b5\\u03b9 \\u03c4\\u1ff7 \", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De fato\"}"}

