data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"c8caee66-2a49-59cb-bb8d-82e52d6f9956\", \"excerpt\": \"Alexander Aphrod. de fato cp. 10 p. 177, 2. \\u03c3\\u1ff4\\u03b6\\u03bf\\u03bd\\u03c4\\u03b5\\u03c2 \\u03b4\\u1f72 \\u03c4\\u1f74\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u03bf\\u1fe6 \\u03c6\\u03cd\\u03c3\\u03b9\\u03bd \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u1f61\\u03c2 \\u03b5\\u1f30\\u03c1\\u03ae\\u03ba\\u03b1\\u03bc\\u03b5\\u03bd, \\u03b4\\u03b9\\u1f70 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03cc \\u03c6\\u03b1\\u03c3\\u03b9\\u03bd \\u03bc\\u03b7\\u03b4\\u1f72 \\u03c4\\u1f70 \\u03b3\\u03b9\\u03b3\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd, \\u03ba\\u03b1\\u03af\\u03c4\\u03bf\\u03b9 \\u1f00\\u03c0\\u03b1\\u03c1\\u03b1\\u03b2\\u03ac\\u03c4\\u03c9\\u03c2 \\u03b3\\u03b9\\u03b3\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1, \\u1f10\\u03be \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03c2 \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u1f45\\u03c4\\u03b9 \\u1f10\\u03c3\\u03c4\\u1f76\\u03bd \\u03b1\\u1f50\\u03c4\\u03bf\\u1fd6\\u03c2 \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u1f78\\u03bd \\u03b3\\u03b5\\u03bd\\u03ad\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u1f00\\u03bd\\u03c4\\u03b9\\u03ba\\u03b5\\u03af\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd, \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u1f78\\u03bd \\u27e8\\u1f42\\u03bd\\u27e9 \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u1f61\\u03c2 \\u03c0\\u03c1\\u03bf\\u03b5\\u03af\\u03c1\\u03b7\\u03c4\\u03b1\\u03b9.\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"a02912ce-b729-50c7-95ed-f5ee53bf8f0b\", \"excerpt\": \"Alexander Aphrod. de fato cp. 10 p. 177, 7 Bruns. \\u1f45\\u03bc\\u03bf\\u03b9\\u03bf\\u03bd \\u03b4\\u1f72 \\u03c4\\u03bf\\u03cd\\u03c4\\u1ff3 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd, \\u03c4\\u1f78 \\u1f00\\u03be\\u03af\\u03c9\\u03bc\\u03b1 \\u03c4\\u1f78 \\u1f14\\u03c3\\u03c4\\u03b1\\u03b9 \\u03b1\\u1f54\\u03c1\\u03b9\\u03bf\\u03bd \\u03bd\\u03b1\\u03c5\\u03bc\\u03b1\\u03c7\\u03af\\u03b1 \\u1f00\\u03bb\\u03b7\\u03b8\\u1f72\\u03c2 \\u03bc\\u1f72\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03b4\\u03cd\\u03bd\\u03b1\\u03c3\\u03b8\\u03b1\\u03b9, \\u03bf\\u1f50 \\u03bc\\u03ad\\u03bd\\u03c4\\u03bf\\u03b9 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03b1\\u1fd6\\u03bf\\u03bd. \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03b1\\u1fd6\\u03bf\\u03bd \\u03bc\\u1f72\\u03bd \\u03b3\\u1f70\\u03c1 \\u03c4\\u1f78 \\u1f00\\u03b5\\u1f76 \\u1f00\\u03bb\\u03b7\\u03b8\\u03ad\\u03c2, \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03b4\\u1f72 \\u03bf\\u1f50\\u03ba\\u03ad\\u03c4\\u2019 \\u1f00\\u03bb\\u03b7\\u03b8\\u1f72\\u03c2 \\u03bc\\u03ad\\u03bd\\u03b5\\u03b9, \\u1f10\\u03c0\\u03b5\\u03b9\\u03b4\\u1f70\\u03bd \\u1f21 \\u03bd\\u03b1\\u03c5\\u03bc\\u03b1\\u03c7\\u03af\\u03b1 \\u03b3\\u03ad\\u03bd\\u03b7\\u03c4\\u03b1\\u03b9. \\u03b5\\u1f30 \\u03b4\\u1f72 \\u03bc\\u1f74 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03b1\\u1fd6\\u03bf\\u03bd, \\u03bf\\u1f50\\u03b4\\u1f72 \\u03c4\\u1f78 \\u1f51\\u03c0\\u2019 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03c3\\u03b7\\u03bc\\u03b1\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd \\u1f10\\u03be \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03c2 \\u03c4\\u1f78 \\u1f14\\u03c3\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03bd\\u03b1\\u03c5\\u03bc\\u03b1\\u03c7\\u03af\\u03b1\\u03bd. \\u03b5\\u1f30 \\u03b4\\u1f72 \\u1f14\\u03c3\\u03c4\\u03b1\\u03b9 \\u03bc\\u03ad\\u03bd, \\u03bf\\u1f50\\u03ba \\u1f10\\u03be \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03c2 \\u03b4\\u1f72 (\\u1f00\\u03bb\\u03b7\\u03b8\\u03bf\\u1fe6\\u03c2 \\u1f44\\u03bd\\u03c4\\u03bf\\u03c2 \\u03c4\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

