data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"daab240b-24ad-489e-948d-daff66e5a05f\", \"excerpt\": \"\\u03c4\\u1f70 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u03b4\\u03bf\\u03ba\\u03bf\\u1fe6\\u03bd\\u03b8' \\u1f21\\u03bc\\u1fd6\\u03bd, \\u1f61\\u03c2 \\u03bf\\u1f37\\u03cc\\u03bd \\u03c4\\u03b5 \\u03c3\\u03b1\\u03c6\\u1ff6\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c3\\u03c5\\u03bd\\u03c4\\u03cc\\u03bc\\u03c9\\u03c2 \\u03c0\\u03b5\\u03b9\\u03c1\\u03ac\\u03c3\\u03bf\\u03bc\\u03b1\\u03b9 \\u1f10\\u03c0\\u03b9\\u03c3\\u03c4\\u03b5\\u1fd6\\u03bb\\u03b1\\u03af \\u03c3\\u03bf\\u03b9, \\u03c6\\u03af\\u03bb\\u03c4\\u03b1\\u03c4\\u03b5 \\u03a0\\u03b5\\u03af\\u03c3\\u03c9\\u03bd, \\u1f10\\u03c0\\u03b5\\u03b9\\u03b4\\u1f74 \\u03c3\\u1f7a \\u03c4\\u03bf\\u1fe6\\u03c4' \\u1f20\\u03be\\u03af\\u03c9\\u03c3\\u03b1\\u03c2 \\u03bf\\u1f50\\u03ba \\u1f00\\u03b3\\u03bd\\u03bf\\u1ff6\\u03bd \\u1f23\\u03bd \\u1f14\\u03c7\\u03c9 \\u03c0\\u03c1\\u1f78\\u03c2 \\u03c4\\u1f78 \\u03b3\\u03c1\\u03ac\\u03c6\\u03b5\\u03b9\\u03bd \\u03b5\\u1f50\\u03bb\\u03ac\\u03b2\\u03b5\\u03b9\\u03b1\\u03bd. \\u03c0\\u03c1\\u1ff6\\u03c4\\u03bf\\u03bd \\u03c4\\u03bf\\u03af\\u03bd\\u03c5\\u03bd \\u1f34\\u03c3\\u03b8\\u03b9, \\u1f45\\u03c4\\u03b9 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7 \\u03b4\\u03b9\\u03c7\\u1ff6\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03bb\\u03ad\\u03b3\\u03b5\\u03c4\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03bd\\u03bf\\u03b5\\u1fd6\\u03c4\\u03b1\\u03b9:\\n\\u1f21 \\u03bc\\u1f72\\u03bd \\u03b3\\u03ac\\u03c1 \\u1f10\\u03c3\\u03c4\\u03b9\\u03bd \\u1f10\\u03bd\\u03ad\\u03c1\\u03b3\\u03b5\\u03b9\\u03b1 \\u1f21 \\u03b4' \\u03bf\\u1f50\\u03c3\\u03af\\u03b1. \\u03c0\\u03c1\\u1ff6\\u03c4\\u03bf\\u03bd \\u03bc\\u1f72\\u03bd \\u03bf\\u1f56\\u03bd \\u1f10\\u03bd\\u03ad\\u03c1\\u03b3\\u03b5\\u03b9\\u03b1\\u03bd \\u03c4\\u03cd\\u03c0\\u1ff3 \\u1f51\\u03c0\\u03ad\\u03b3\\u03c1\\u03b1\\u03c8\\u03b5\\u03bd \\u1f41 \\u03a0\\u03bb\\u03ac\\u03c4\\u03c9\\u03bd \\u1f14\\u03bd \\u03c4\\u03b5 \\u03c4\\u1ff7 \\u03a6\\u03b1\\u03af\\u03b4\\u03c1\\u1ff3 \\u03bb\\u03ad\\u03b3\\u03c9\\u03bd \\u03b8\\u03b5\\u03c3\\u03bc\\u03cc\\u03c2 \\u03c4\\u03b5 \\u1f08\\u03b4\\u03c1\\u03b1\\u03c3\\u03c4\\u03b5\\u03af\\u03b1\\u03c2 \\u1f45\\u03b4\\u03b5, \\u1f25\\u03c4\\u03b9\\u03c2 \\u1f02\\u03bd \\u03c8\\u03c5\\u03c7\\u1f74 \\u03b8\\u03b5\\u1ff7 \\u03be\\u03c5\\u03bd\\u03bf\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"0bf9e0e6-3168-519b-a2b3-b8ea280da4ca\", \"excerpt\": \"Greek: \\u1f41 \\u03bc\\u1f72\\u03bd \\u03bf\\u1f56\\u03bd \\u1f21\\u03bc\\u03ad\\u03c4\\u03b5\\u03c1\\u03bf\\u03c2 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c2, \\u1f10\\u03c0\\u1f76 \\u03ba\\u03b5\\u03c6\\u03b1\\u03bb\\u03b1\\u03af\\u03c9\\u03bd \\u03b5\\u1f30\\u03c0\\u03b5\\u1fd6\\u03bd, \\u03c4\\u03bf\\u03b9\\u03bf\\u1fe6\\u03c4\\u03cc\\u03c2 \\u03c4\\u03b9\\u03c2 \\u1f02\\u03bd \\u03b5\\u1f34\\u03b7: \\u1f41 \\u03b4\\u1f72 \\u03c4\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd \\u1f10\\u03bd\\u03b1\\u03bd\\u03c4\\u03af\\u03bf\\u03c2 \\u03bf\\u1f50 \\u03bc\\u03cc\\u03bd\\u03bf\\u03bd \\u1f10\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u1fc3 \\u1f00\\u03bb\\u03bb\\u1f70 \\u03ba\\u03b1\\u1f76 \\u03ba\\u03b1\\u03b8' \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03c4\\u03af\\u03b8\\u03b5\\u03c4\\u03b1\\u03b9.\\n\\nTranslation: Our account, to speak in summary, would be something like this. But the contrary account posits all things not only in fate but also according to fate. All things are consistent with one [position]; and what is consistent with \", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Pseudo-Plutarch, De Fato (Moralia 568b-574f)\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"442fc3d9-90a5-4257-9d2b-1dac9643e315\", \"excerpt\": \"\\u03ba\\u03b1\\u1f76 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1f78 \\u03c4\\u03b9\\u03bc\\u1fc6\\u03c3\\u03b1\\u03b9 \\u03c4\\u03cc\\u03bd\\u03b4\\u03b5 \\u03c4\\u03b9\\u03bd\\u1f70 \\u1f20\\u03c1\\u03b9\\u03c3\\u03c4\\u03b5\\u03c5\\u03ba\\u03cc\\u03c4\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u03ba\\u03bf\\u03bb\\u03ac\\u03c3\\u03b1\\u03b9 \\u03c4\\u03cc\\u03bd\\u03b4\\u03b5 \\u03c4\\u03b9\\u03bd\\u1f70 \\u03bb\\u03b9\\u03c0\\u03bf\\u03c4\\u03b1\\u03ba\\u03c4\\u03ae\\u03c3\\u03b1\\u03bd\\u03c4\\u03b1 \\u03bd\\u03cc\\u03bc\\u03b9\\u03bc\\u03bf\\u03bd \\u1f02\\u03bd \\u03c6\\u03ae\\u03c3\\u03b1\\u03b9\\u03bc\\u03b5\\u03bd, \\u1f61\\u03c2 \\u03b4\\u03c5\\u03bd\\u03ac\\u03bc\\u03b5\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd \\u03b4\\u03b9\\u03b1\\u03c4\\u03b5\\u03c4\\u03b1\\u03b3\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5 \\u03c4\\u03bf\\u1fe6 \\u03bd\\u03cc\\u03bc\\u03bf\\u03c5:\\n\\u1f43\\u03bd \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03bd \\u1f41 \\u1f30\\u03b1\\u03c4\\u03c1\\u03b9\\u03ba\\u1f78\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f41 \\u03b3\\u03c5\\u03bc\\u03bd\\u03b1\\u03c3\\u03c4\\u03b9\\u03ba\\u1f78\\u03c2 \\u1f61\\u03c2 \\u03b5\\u1f30\\u03c0\\u03b5\\u1fd6\\u03bd \\u03bd\\u03cc\\u03bc\\u03bf\\u03c2 \\u03b4\\u03c5\\u03bd\\u03ac\\u03bc\\u03b5\\u03b9 \\u03c4\\u1f70 \\u03ba\\u03b1\\u03b8' \\u1f15\\u03ba\\u03b1\\u03c3\\u03c4\\u03b1 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f45\\u03bb\\u03bf\\u03b9\\u03c2 \\u03c3\\u03c5\\u03bc\\u03c0\\u03b5\\u03c1\\u03b9\\u03bb\\u03b1\\u03bc\\u03b2\\u03ac\\u03bd\\u03b5\\u03b9:\\n\\u03bf\\u1f55\\u03c4\\u03c9 \\u03b4\\u1f72 \\u03ba\\u03b1\\u1f76 \\u1f41 \\u03c4\\u1fc6\\u03c2 \\u03c6\\u03cd\\u03c3\\u03b5\\u03c9\\u03c2 \\u03bd\\u03cc\\u03bc\\u03bf\\u03c2 \\u03c4\\u1f70 \\u03bc\\u1f72\\u03bd \\u03ba\\u03b1\\u03b8\\u03cc\\u03bb\\u03bf\\u03c5 \\u03c0\\u03c1\\u03bf\\u03b7\\u03b3\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03c9\\u03c2, \\u03c4\\u1f70 \\u03b4\\u1f72 \\u03ba\\u03b1\\u03b8' \\u1f15\\u03ba\\u03b1\\u03c3\\u03c4\\u03b1 \\u1f11\\u03c0\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03c2. \\u1f14\\u03c3\\u03c4\\u03b9 \\u03b8' \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b1 \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03bd \\u03c4\\u03b9\\u03bd\\u1f70 \\u03ba\\u03b1\\u1f76 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1, \\u1f44\\u03bd\\u03c4' \\u1f10\\u03ba\\u03b5\\u03af\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De fato\"}"}

