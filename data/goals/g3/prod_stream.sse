data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"1e5a059b-17cd-4677-9d8a-0199ded2f94b\", \"excerpt\": \"\\u1f2e\\u03bd \\u03bc\\u1f72\\u03bd \\u03b4\\u03b9\\u2019 \\u03b5\\u1f50\\u03c7\\u1fc6\\u03c2 \\u03bc\\u03bf\\u03b9, \\u03bc\\u03ad\\u03b3\\u03b9\\u03c3\\u03c4\\u03bf\\u03b9 \\u03b1\\u1f50\\u03c4\\u03bf\\u03ba\\u03c1\\u03ac\\u03c4\\u03bf\\u03c1\\u03b5\\u03c2 \\u0394\\u03a3\\u03b5\\u03b2\\u1fc6\\u03c1\\u03b5 \\u03ba\\u03b1\\u1f76 \\u1f08\\u03bd\\u03c4\\u03c9\\u03bd\\u1fd6\\u03bd\\u03b5, \\u03b1\\u1f50\\u03c4\\u1ff7 \\u03b3\\u03b5\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u1ff3 \\u03c0\\u03b1\\u03c1\\u2019 \\u1f51\\u03bc\\u1fd6\\u03bd \\u1f30\\u03b4\\u03b5\\u1fd6\\u03bd \\u03c4\\u03b5 \\u1f51\\u03bc\\u1fb6\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03c1\\u03bf\\u03c3\\u03b5\\u03b9\\u03c0\\u03b5\\u1fd6\\u03bd \\u03ba\\u03b1\\u1f76 \\u03ba\\u03b1\\u03b8\\u03bf\\u03bc\\u03bf\\u03bb\\u03bf\\u03b3\\u1fc6\\u03c3\\u03b1\\u03b9 \\u03c7\\u03ac\\u03c1\\u03b9\\u03bd \\u1f00\\u03bd\\u03b8\\u2019 \\u1f67\\u03bd \\u1f14\\u03c0\\u03b1\\u03b8\\u03bf\\u03bd \\u03b5\\u1f56 \\u03c0\\u03b1\\u03c1\\u2019 \\u1f51\\u03bc\\u1ff6\\u03bd \\u03c0\\u03bf\\u03bb\\u03bb\\u03ac\\u03ba\\u03b9\\u03c2, \\u03b1\\u1f30\\u03b5\\u1f76 \\u03c4\\u03c5\\u03c7\\u03ce\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u1f67\\u03bd \\u1f20\\u03be\\u03af\\u03c9\\u03c3\\u03b1 \\u03bc\\u03b5\\u03c4\\u1f70 \\u03bc\\u03b1\\u03c1\\u03c4\\u03c5\\u03c1\\u03af\\u03b1\\u03c2 \\u1f27\\u03c2 \\u03b4\\u03af\\u03ba\\u03b1\\u03b9\\u03bf\\u03c2 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u03c5\\u03b3\\u03c7\\u03ac\\u03bd\\u03b5\\u03b9\\u03bd \\u03c4\\u03bf\\u03b9\\u03b1\\u1fe6\\u03c4\\u03b1 \\u03b1\\u1f30\\u03c4\\u03bf\\u03cd\\u03bc\\u03b5\\u03bd\\u03bf\\u03c2. \\u1f10\\u03c0\\u03b5\\u1f76 \\u03b4\\u1f72 \\u1f10\\u03c6\\u03b5\\u1fd6\\u03c4\\u03b1\\u03b9, \\u03ba\\u03b1\\u1f76 \\u03b5\\u1f30 \\u03bc\\u1f74 \\u03c0\\u03b1\\u03c1\\u03ce\\u03bd \\u03c4\\u03b9\\u03c2 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f31\\u03b5\\u03c1\\u03bf\\u1fd6\\u03c2 \\u03b8\\u03cd\\u03b5\\u03b9\\u03bd \\u03b4\\u03cd\\u03bd\\u03b1\\u03c4\\u03b1\\u03b9, \\u03c4\\u1f78 \\u03b8\\u03cd\\u03b5\\u03b9\\u03bd \\u03b1\\u1f50\\u03c4\\u03bf\\u1fd6\\u03c2 \\u03c0\\u03b1\\u03bd\\u03c4\\u03b1\\u03c7\\u03cc\\u03b8\\u03b5\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03b1\\u03bd\\u03c4\\u03b1\\u03c7\\u03bf\\u1fe6 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03ad\\u03bc\\u03c0\\u03b5\\u03b9\\u03bd \\u1f00\\u03bd\\u03b1\\u03b8\\u03ae\\u03bc\\u03b1\\u03c4\\u03b1,\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"34005c9d-6a6c-54c3-a209-3ea2bd0c4086\", \"excerpt\": \"It was my prayer, most mighty Emperors Severus and Antoninus, to come before you in person, both to see you and to address you and to acknowledge my gratitude for the many benefits I have received from you, having always obtained everything I requested, together with the testimony that one who makes such requests deserves to receive. But since it is permitted, even if one is not present at the sac\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"26474662-5699-43c0-a13c-ecb755807460\", \"excerpt\": \"\\u03a4\\u1f78 \\u03bc\\u1f72\\u03bd \\u03bf\\u1f56\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03af \\u03c4\\u03b9 \\u03c4\\u1f74\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03ba\\u03b1\\u1f76 \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u03bf\\u1fe6 \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03af \\u03c4\\u03b9\\u03bd\\u03b1 \\u03ba\\u03b1\\u03c4\\u2019 \\u03b1\\u1f50\\u03c4\\u1f74\\u03bd \\u1f31\\u03ba\\u03b1\\u03bd\\u1ff6\\u03c2 \\u1f21 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd \\u03c3\\u03c5\\u03bd\\u03af\\u03c3\\u03c4\\u03b7\\u03c3\\u03b9\\u03bd \\u03c0\\u03c1\\u03cc\\u03bb\\u03b7\\u03c8\\u03b9\\u03c2 (\\u03bf\\u1f50 \\u03b3\\u1f70\\u03c1 \\u03ba\\u03b5\\u03bd\\u1f78\\u03bd \\u03bf\\u1f50\\u03b4\\u2019 \\u1f04\\u03c3\\u03c4\\u03bf\\u03c7\\u03bf\\u03bd \\u03c4\\u1f00\\u03bb\\u03b7\\u03b8\\u03bf\\u1fe6\\u03c2 \\u1f21 \\u03ba\\u03bf\\u03b9\\u03bd\\u1f74 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd \\u03c6\\u03cd\\u03c3\\u03b9\\u03c2, \\u03ba\\u03b1\\u03b8\\u2019 \\u1f23\\u03bd \\u03c0\\u03b5\\u03c1\\u03af \\u03c4\\u03b9\\u03bd\\u03c9\\u03bd \\u1f41\\u03bc\\u03bf\\u03b4\\u03bf\\u03be\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd \\u1f00\\u03bb\\u03bb\\u03ae\\u03bb\\u03bf\\u03b9\\u03c2, \\u1f45\\u03c3\\u03bf\\u03b9 \\u03b3\\u03b5 \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd \\u03bc\\u1f74 \\u03b4\\u03b9\\u03ac \\u03c4\\u03b9\\u03bd\\u03b1\\u03c2 \\u03c0\\u03c1\\u03bf\\u03ba\\u03b1\\u03c4\\u03b1\\u03b2\\u03b5\\u03b2\\u03bb\\u03b7\\u03bc\\u03ad\\u03bd\\u03b1\\u03c2 \\u03b4\\u03cc\\u03be\\u03b1\\u03c2 \\u1f51\\u03c6\\u2019 \\u03b1\\u1f51\\u03c4\\u1ff6\\u03bd \\u03b4\\u03b9\\u1f70 \\u03c4\\u1f78 \\u03c3\\u03ce\\u03b6\\u03b5\\u03b9\\u03bd \\u03b2\\u03bf\\u03cd\\u03bb\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u1f74\\u03bd \\u03c0\\u03c1\\u1f78\\u03c2 \\u03b1\\u1f50\\u03c4\\u1f70\\u03c2 \\u1f00\\u03ba\\u03bf\\u03bb\\u03bf\\u03c5\\u03b8\\u03af\\u03b1\\u03bd \\u1f04\\u03bb\\u03bb\\u03c9\\u03c2 \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03ac\\u03b6\\u03bf\\u03bd\\u03c4\\u03b1\\u03b9 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd\\u00b7 \\u03b4\\u03b9\\u2019 \\u1f23\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd \\u03bf\\u1f50\\u03b4\\u1f72 \\u1f08\\u03bd\\u03b1\\u03be\\u03b1\\u03b3\\u03cc\\u03c1\\u03b1\\u03c2 \\u1f41 K\\u03bb\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"290aec25-79e6-5af8-b17f-dec3d5ddb7c1\", \"excerpt\": \"That fate is something, and that it is a cause of certain things coming about in accordance with it, the preconception (prol\\u0113psis) of human beings sufficiently establishes. For the common nature of human beings is neither empty nor wide of the truth, in accordance with which they agree with one another about certain things \\u2014 at least those of them who are not compelled by certain opinions they hav\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"74b0f159-46a4-4035-b091-b6e1ae5eca4c\", \"excerpt\": \"\\u1f45\\u03c4\\u03b9 \\u03bc\\u1f72\\u03bd \\u03bf\\u1f56\\u03bd 8 \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd \\u03c4\\u03b9\\u03bd\\u1f70 \\u03c4\\u1f74\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03bb\\u03ad\\u03b3\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b5\\u03c2 \\u03bf\\u1f31 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u03bb\\u03ad\\u03b3\\u03bf\\u03bd\\u03c4\\u03ad\\u03c2 \\u03c4\\u03b9, \\u03b3\\u03bd\\u03ce\\u03c1\\u03b9\\u03bc\\u03bf\\u03bd (\\u03c4\\u03b1\\u03cd\\u03c4\\u03b7\\u03bd \\u03b3\\u1f70\\u03c1 \\u1f00\\u03c0\\u03bf\\u03b4\\u03b9\\u03b4\\u03cc\\u03b1\\u03c3\\u03af\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u03af \\u03c6\\u03b1\\u03c3\\u03b9\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u03bf\\u1fe6 \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u1f70 \\u03b3\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1 \\u1f43\\u03bd \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03bd \\u03b3\\u03af\\u03bd\\u03b5\\u03c4\\u03b1\\u03b9), \\u1f10\\u03c0\\u03b5\\u1f76 \\u03b4\\u1f72 \\u03c0\\u03bb\\u03b5\\u03bf\\u03bd\\u03b1\\u03c7\\u1ff6\\u03c2 \\u03bb\\u03ad\\u03b3\\u03b5\\u03c4\\u03b1\\u03b9 \\u03c4\\u1f70 \\u03b1\\u1f34\\u03c4\\u03b9\\u03b1, \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03b1\\u1fd6\\u03bf\\u03bd \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f10\\u03bd \\u03c4\\u03ac\\u03be\\u03b5\\u03b9 \\u03c4\\u1f78 \\u03c0\\u03c1\\u03cc\\u03b2\\u03bb\\u03b7\\u03bc\\u03b1 \\u03bc\\u03b5\\u03c4\\u03b9\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd \\u03c0\\u03c1\\u1ff6\\u03c4\\u03bf\\u03bd \\u03bb\\u03b1\\u03b2\\u03b5\\u1fd6\\u03bd, \\u1f51\\u03c0\\u1f78 \\u03c4\\u03af\\u03bd\\u03b1 \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03bd \\u03c4\\u1ff6\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03c9\\u03bd \\u03c7\\u03c1\\u1f74 \\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f74\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd\\u00b7 \\u03bf\\u1f50\\u03b4\\u1f72\\u03bd \\u03b3\\u1f70\\u03c1 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03bf\\u03bb\\u03bb\\u03b1\\u03c7\\u1ff6\\u03c2 \\u03bb\\u03b5\\u03b3\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"f8bf0d55-219f-54be-bd36-d302da32a06e\", \"excerpt\": \"Now that all who say something about fate say that fate is a certain cause of things that come about is well known (for they assign it this role and say it is the cause of things coming about in the way they come about). But since causes are spoken of in several senses, it is necessary for those who pursue the problem in an orderly fashion first to determine under which kind of cause one should pl\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"fe6fc065-9a84-4664-9630-752bc1c6bcad\", \"excerpt\": \"\\u03b1\\u1f30\\u03c4\\u03af\\u03c9\\u03bd \\u03c0\\u03bf\\u03b9\\u03ae\\u03c3\\u03b1\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u1f78\\u03bd \\u03bb\\u03cc\\u03b3\\u03bf\\u03bd. \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u03b3\\u1f70\\u03c1 \\u1f14\\u03c3\\u03c4\\u03b1\\u03b9 \\u03b3\\u03bd\\u03ce\\u03c1\\u03b9\\u03bc\\u03bf\\u03bd, \\u03b5\\u1f34 \\u03c4\\u03b5 \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u1ff6\\u03bd \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c7\\u03c1\\u1f74 \\u03c4\\u1f74\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03b1\\u1f30\\u03c4\\u03b9\\u1fb6\\u03c3\\u03b8\\u03b1\\u03b9, \\u03b5\\u1f34 \\u03c4\\u03b5 \\u03b4\\u03b5\\u1fd6 \\u03ba\\u03b1\\u1f76 \\u1f04\\u03bb\\u03bb\\u03bf\\u03b9\\u03c2 \\u03c4\\u03b9\\u03c3\\u1f76\\u03bd \\u03c0\\u03b1\\u03c1\\u1f70 \\u03c4\\u03ae\\u03bd\\u03b4\\u03b5 \\u03c3\\u03c5\\u03b3\\u03c7\\u03c9\\u03c1\\u03b5\\u1fd6\\u03bd \\u1f61\\u03c2 \\u03bf\\u1f56\\u03c3\\u03b9\\u03bd \\u03c0\\u03bf\\u03b9\\u03b7\\u03c4\\u03b9\\u03ba\\u03bf\\u1fd6\\u03c2 \\u03c4\\u03b9\\u03bd\\u03c9\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03bf\\u03b9\\u03c2. \\u1f00\\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03b4\\u1f74 \\u03c4\\u1ff6\\u03bd \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f08\\u03c1\\u03b9\\u03c3\\u03c4\\u03bf\\u03c4\\u03ad\\u03bb\\u03b7\\u03c2 \\u03c0\\u03bf\\u03b9\\u03bf\\u03cd\\u03bc\\u03b5\\u03bd\\u03bf\\u03c2 \\u03c4\\u1f74\\u03bd \\u03b4\\u03b9\\u03b1\\u03af\\u03c1\\u03b5\\u03c3\\u03b9\\u03bd \\u03c4\\u1f70 \\u03bc\\u1f72\\u03bd \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd \\u03c4\\u03b9\\u03bd\\u03bf\\u03c2 \\u03c7\\u03ac\\u03c1\\u03b9\\u03bd \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9 \\u03c3\\u03ba\\u03bf\\u03c0\\u03cc\\u03bd \\u03c4\\u03b9\\u03bd\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03c4\\u03ad\\u03bb\\u03bf\\u03c2 \\u03c4\\u1ff6\\u03bd \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c0\\u03c1\\u03bf\\u03ba\\u03b5\\u03af\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd \\u1f14\\u03c7\\u03bf\\u03bd\\u03c4\\u03bf\\u03c2 \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03bf\\u03b9\\u03bf\\u1fe6\\u03bd\\u03c4\\u03bf\\u03c2 \\u03b1\\u1f50\\u03c4\\u03ac, \\u03c4\\u1f70 \\u03b4\\u1f72 \\u03bf\\u1f50\\u03b4\\u03b5\\u03bd\\u03cc\\u03c2. \\u1f45\\u03c3\\u03b1 \\u03b3\\u1f70\\u03c1 \\u03bf\\u1f50 \\u03ba\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"b0309a9e-0a2b-5ca1-97a2-1fe7f761b6f8\", \"excerpt\": \"causes. For in this way it will become known whether one should attribute all things that come about to fate, or whether one should also grant to certain other things besides fate that they are efficient causes of certain things. Aristotle, making a division of all things that come about, says that some of them come about for the sake of something, the agent having a certain aim and end of the thi\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"b6c318f2-8577-49ee-8a73-26315325cccf\", \"excerpt\": \"\\u03c4\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd \\u03b4\\u2019 \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u1f10\\u03c7\\u03cc\\u03bd\\u03c4\\u03c9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u1ff6\\u03bd \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b5\\u1f30\\u03c2 \\u03c4\\u03bf\\u03cd\\u03c4\\u03bf\\u03c5\\u03c2 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03c5\\u03c2 \\u03bd\\u03b5\\u03bd\\u03b5\\u03bc\\u03b7\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f00\\u03ba\\u03cc\\u03bb\\u03bf\\u03c5\\u03b8\\u03bf\\u03bd \\u1f10\\u03c0\\u1f76 \\u03c4\\u03bf\\u03cd\\u03c4\\u03bf\\u03b9\\u03c2 \\u1f30\\u03b4\\u03b5\\u1fd6\\u03bd, \\u1f10\\u03bd \\u03c0\\u03bf\\u03af\\u1ff3 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03bf\\u03b9\\u03b7\\u03c4\\u03b9\\u03ba\\u1ff6\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03c9\\u03bd \\u03c7\\u03c1\\u1f74 \\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f74\\u03bd \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd. \\u1f06\\u03c1\\u03ac \\u03b3\\u03b5 \\u1f10\\u03bd \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03bf\\u1f50\\u03b4\\u03b5\\u03bd\\u1f78\\u03c2 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u03c7\\u03ac\\u03c1\\u03b9\\u03bd; \\u1f22 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03bc\\u1f72\\u03bd \\u03c0\\u03b1\\u03bd\\u03c4\\u03ac\\u03c0\\u03b1\\u03c3\\u03b9\\u03bd \\u1f04\\u03bb\\u03bf\\u03b3\\u03bf\\u03bd\\u00b7 \\u03b1\\u1f30\\u03b5\\u1f76 \\u03b3\\u1f70\\u03c1 \\u1f10\\u03c0\\u1f76 \\u03c4\\u03ad\\u03bb\\u03bf\\u03c5\\u03c2 \\u03c4\\u03b9\\u03bd\\u1f78\\u03c2 \\u03c4\\u1ff7 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u1f40\\u03bd\\u03cc\\u03bc\\u03b1\\u03c4\\u03b9 \\u03c7\\u03c1\\u03ce\\u03bc\\u03b5\\u03b8\\u03b1 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03b1\\u1f50\\u03c4\\u1f78 \\u03bb\\u03ad\\u03b3\\u03bf\\u03bd\\u03c4\\u03b5\\u03c2 \\u03b3\\u03b5\\u03b3\\u03bf\\u03bd\\u03ad\\u03bd\\u03b1\\u03b9. \\u03b4\\u03b9\\u1f78 \\u1f10\\u03bd \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f15\\u03bd\\u03b5\\u03ba\\u03ac \\u03c4\\u03bf\\u03c5 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03b1\\u1fd6\\u03bf\\u03bd \\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f74\\u03bd \", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"5cd0c423-896c-509f-be5a-3bcdc160ae22\", \"excerpt\": \"Since this is how things stand, and all things that come about are distributed into these kinds, it follows upon this to consider in which of the efficient causes one should place fate. Is it in those things that come about for the sake of nothing? But this is altogether unreasonable; for we always use the name of fate in connection with some end, saying that a thing has come about according to fa\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

