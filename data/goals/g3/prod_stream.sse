data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"71695c44-de4c-5221-b4cf-e62b09403741\", \"excerpt\": \"English paraphrase of Alexander of Aphrodisias, De Fato 13-15. Alexander argues that 'what is up to us' (to eph' hemin) involves the genuine power to do otherwise, not merely voluntary action under antecedent causal determination. He contends that the Stoic redefinition of eph' hemin fails to preserve the common human understanding of the term.\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Alexander of Aphrodisias, De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"851632f4-304e-5ae8-972a-561ccdfffac4\", \"excerpt\": \"Alexander Aphrod. de fato cp. 13 p. 181, 13 Bruns. \\u1f00\\u03bd\\u03b1\\u03b9\\u03c1\\u03bf\\u1fe6\\u03bd\\u03c4\\u03b5\\u03c2 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1f78 \\u1f10\\u03be\\u03bf\\u03c5\\u03c3\\u03af\\u03b1\\u03bd \\u1f14\\u03c7\\u03b5\\u03b9\\u03bd \\u03c4\\u1f78\\u03bd \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03bd \\u03c4\\u1fc6\\u03c2 \\u03b1\\u1f31\\u03c1\\u03ad\\u03c3\\u03b5\\u03ce\\u03c2 \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03c1\\u03ac\\u03be\\u03b5\\u03c9\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bd\\u03c4\\u03b9\\u03ba\\u03b5\\u03b9\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03bb\\u03ad\\u03b3\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f78 \\u03b3\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd \\u27e8\\u03ba\\u03b1\\u03b8\\u2019 \\u1f41\\u03c1\\u03bc\\u1f74\\u03bd\\u27e9 \\u03b4\\u03b9\\u2019 \\u1f21\\u03bc\\u1ff6\\u03bd. \\u1f10\\u03c0\\u03b5\\u1f76 \\u03b3\\u03ac\\u03c1, \\u03c6\\u03b1\\u03c3\\u03af\\u03bd, \\u03c4\\u1ff6\\u03bd \\u1f44\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f31 \\u03c6\\u03cd\\u03c3\\u03b5\\u03b9\\u03c2 \\u1f15\\u03c4\\u03b5\\u03c1\\u03b1\\u03af \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b9\\u03ac\\u03c6\\u03bf\\u03c1\\u03bf\\u03b9 (\\u03bf\\u1f50 \\u03b3\\u1f70\\u03c1 \\u03b1\\u1f31 \\u03b1\\u1f50\\u03c4\\u03b1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03bc\\u03c8\\u03cd\\u03c7\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03c8\\u03cd\\u03c7\\u03c9\\u03bd, \\u1f00\\u03bb\\u03bb\\u2019 \\u03bf\\u1f50\\u03b4\\u1f72 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03bc\\u03c8\\u03cd\\u03c7\\u03c9\\u03bd \\u1f01\\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03b1\\u1f31 \\u03b1\\u1f50\\u03c4\\u03b1\\u1f76 \\u03c0\\u03ac\\u03bb\\u03b9\\u03bd\\u00b7 \\u03b1\\u1f31 \\u03b3\\u1f70\\u03c1 \\u03ba\\u03b1\\u03c4\\u2019 \\u03b5\\u1f36\\u03b4\\u03bf\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f44\\u03bd\\u03c4\\u03c9\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"cd7e7c54-ff56-5d1a-8511-bb68cb00400d\", \"excerpt\": \"Alexander Aphrod. de fato cp. 8 p. 173, 13. \\u1f44\\u03bd\\u03c4\\u03c9\\u03bd \\u03b4\\u1f74 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03c0\\u1f78 \\u03c4\\u03cd\\u03c7\\u03b7\\u03c2 \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03b1\\u1f50\\u03c4\\u03bf\\u03bc\\u03ac\\u03c4\\u03c9\\u03c2 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c4\\u03bf\\u03b9\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd, \\u1f61\\u03c2 \\u03bc\\u1f74 \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c0\\u03c1\\u03bf\\u03b7\\u03b3\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd \\u2014 \\u2014 \\u03c0\\u1ff6\\u03c2 \\u1f02\\u03bd \\u03c3\\u1ff4\\u03b6\\u03bf\\u03b9\\u03c4\\u03cc \\u03c4\\u03b9 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03b5\\u03b9\\u03c1\\u03b7\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03ba\\u03b1\\u03b8\\u2019 \\u03bf\\u1f53\\u03c2 \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03c0\\u03c1\\u03bf\\u03b7\\u03b3\\u03b7\\u03c3\\u03b1\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u03c4\\u03b9\\u03c3\\u1f76\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03bf\\u03b9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03c1\\u03bf\\u03b7\\u03b3\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u1f10\\u03be \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03c2 \\u1f14\\u03c3\\u03c4\\u03b9 \\u03c4\\u03b5 \\u03c4\\u1f70 \\u1f44\\u03bd\\u03c4\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f70 \\u03b3\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1 \\u03b3\\u03af\\u03bd\\u03b5\\u03c4\\u03b1\\u03b9, \\u1f11\\u03ba\\u03ac\\u03c3\\u03c4\\u03bf\\u03c5 \\u03c4\\u1ff6\\u03bd \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f34\\u03c4\\u03b9\\u03cc\\u03bd \\u03c4\\u03b9 \\u03c0\\u03c1\\u03bf\\u03ba\\u03b1\\u03c4\\u03b1\\u03b2\\u03b5\\u03b2\\u03bb\\u03b7\\u03bc\\u03ad\\u03bd\\u03bf\\u03bd \\u1f14\\u03c7\\u03bf\\u03bd\\u03c4\\u03bf\\u03c2, \\u03bf\\u1f57 \\u1f44\\u03bd\\u03c4\\u03bf\\u03c2 \\u1f22 \\u03b3\\u03b5\\u03b3\\u03bf\\u03bd\\u03cc\\u03c4\\u03bf\\u03c2 \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7 \\u03ba\\u03b1\\u1f76 \\u03b1\\u1f50\\u03c4\\u1f78 \\u1f22 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"7daa3f8a-7094-5fe7-97e9-75636177596e\", \"excerpt\": \"Alexander Aphrod. de fato cp. 26 p. 196, 13 Bruns. \\u1f05 \\u03b4\\u1f72 \\u1f00\\u03c0\\u03bf\\u03c1\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd \\u03c0\\u03c1\\u1f78\\u03c2 \\u03c4\\u1f78 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u03bf\\u03b9\\u03bf\\u1fe6\\u03c4\\u03bf\\u03bd \\u03c4\\u1f78 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd, \\u1f41\\u03c0\\u03bf\\u1fd6\\u03bf\\u03bd \\u1f21 \\u03ba\\u03bf\\u03b9\\u03bd\\u1f74 \\u03c0\\u03c1\\u03cc\\u03bb\\u03b7\\u03c8\\u03b9\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd \\u03c0\\u03b5\\u03c0\\u03af\\u03c3\\u03c4\\u03b5\\u03c5\\u03ba\\u03b5\\u03bd, \\u1f00\\u03c0\\u03bf\\u03c1\\u03b5\\u1fd6\\u03bd \\u03bc\\u1f72\\u03bd \\u03bf\\u1f50\\u03ba \\u1f04\\u03bb\\u03bf\\u03b3\\u03bf\\u03bd, \\u03c4\\u1f78 \\u03b4\\u1f72 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f00\\u03c0\\u03bf\\u03c1\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u1f10\\u03c0\\u03bf\\u03c7\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u1f61\\u03c2 \\u1f41\\u03bc\\u03bf\\u03bb\\u03bf\\u03b3\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\uff0d \\u03c3\\u03c5\\u03bd\\u03b1\\u03b3\\u03c9\\u03bd\\u03af\\u03b6\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f00\\u03c0\\u03bf\\u03c1\\u03bf\\u03c5\\u03bc\\u03ad\\u03bf\\u03b9\\u03c2 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b1\\u1f51\\u03c4\\u1ff6\\u03bd, \\u03c0\\u1ff6\\u03c2 \\u03bf\\u1f50 \\u03c0\\u03b1\\u03bd\\u03c4\\u03ac\\u03c0\\u03b1\\u03c3\\u03b9\\u03bd \\u1f04\\u03bb\\u03bf\\u03b3\\u03bf\\u03bd; 21. \\u03bf\\u1f50 \\u03c7\\u03b5\\u1fd6\\u03c1\\u03bf\\u03bd \\u03b4\\u1f72 \\u1f34\\u03c3\\u03c9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f21\\u03bc\\u1fb6\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03c0\\u03bf\\u03c1\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f51\\u03c6' \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd, \\u03bf\\u1f37\\u03c2 \\u03bc\\u03ac\\u03bb\\u03b9\\u03c3\\u03c4\\u03b1 \\u03b8\\u03b1\\u1fe4\\u1fe5\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd, \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u03c0\\u03c1\\u03bf\\u03c7\\u03b5\\u03b9\\u03c1\\u03b9\\u03c3\\u03b1\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"d1cfa77d-b8d6-5e05-8d4f-dd1d91d24906\", \"excerpt\": \"Alexander Aphrod. de fato cp. 25 p. 194, 25 Bruns. \\u03c0\\u1ff6\\u03c2 \\u03b3\\u1f70\\u03c1 \\u03bf\\u1f50 \\u03c6\\u03b1\\u03bd\\u03b5\\u03c1\\u1ff6\\u03c2 \\u03c8\\u03b5\\u1fe6\\u03b4\\u03bf\\u03c2 \\u03c4\\u1f78 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd \\u03c0\\u1fb6\\u03bd \\u03c4\\u1f78 \\u1f11\\u03c0\\u03cc\\u03bc\\u03b5\\u03bd\\u03cc\\u03bd \\u03c4\\u03b9\\u03bd\\u03b9 \\u1f10\\u03be \\u1f10\\u03ba\\u03b5\\u03af\\u03bd\\u03bf\\u03c5 \\u03c4\\u1f74\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u1f14\\u03c7\\u03b5\\u03b9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c0\\u1fb6\\u03bd \\u03c4\\u1f78 \\u03c0\\u03c1\\u03bf\\u03b7\\u03b3\\u03bf\\u03cd\\u03bc\\u03b5\\u03bd\\u03cc\\u03bd \\u03c4\\u03b9\\u03bd\\u03bf\\u03c2 \\u03b1\\u1f34\\u03c4\\u03b9\\u03bf\\u03bd \\u1f51\\u03c0\\u03ac\\u03c1\\u03c7\\u03b5\\u03b9\\u03bd \\u1f10\\u03ba\\u03b5\\u03af\\u03bd\\u1ff3; p. 195, 1. \\u1f45\\u03b8\\u03b5\\u03bd \\u03ba\\u03b1\\u1f76 \\u03b8\\u03b1\\u03c5\\u03bc\\u03ac\\u03c3\\u03b5\\u03b9\\u03b5\\u03bd \\u1f04\\u03bd \\u03c4\\u03b9\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1f7a\\u03c2 \\u03c4\\u1f74\\u03bd \\u03c4\\u1ff6\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03c9\\u03bd \\u1f00\\u03c0\\u03cc\\u03b4\\u03bf\\u03c3\\u03b9\\u03bd \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf\\u03bd \\u03c0\\u03bf\\u03b9\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u03c4\\u1f78\\u03bd \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03bd \\u1f61\\u03c2 \\u03b1\\u1f30\\u03b5\\u1f76 \\u03c4\\u1f78 \\u03c0\\u03c1\\u1ff6\\u03c4\\u03bf\\u03bd \\u03b3\\u03b5\\u03b3\\u03bf\\u03bd\\u1f78\\u03c2 \\u03b1\\u1f30\\u03c4\\u03b9\\u1fb6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u03bf\\u1fe6 \\u03bc\\u03b5\\u03c4\\u1f70 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03ba\\u03b1\\u1f76 \\u03c0\\u03bf\\u03b9\\u03b5\\u1fd6\\u03bd \\u1f10\\u03c