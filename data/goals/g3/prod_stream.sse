data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"6d9d85c8-ffa3-48f5-b5fe-9ef25cd19aa0\", \"excerpt\": \"**Reference:** De Fato 15\\n**Author:** Alexander of Aphrodisias\\n**Work:** De Fato\\n**Edition:** Bruns (CAG Suppl. II.2)\\n\\n**Original Greek:**\\n\\u03b4\\u03b9\\u1f70 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1f74\\u03bd \\u03c4\\u03bf\\u03b9\\u03b1\\u03cd\\u03c4\\u03b7\\u03bd \\u1f10\\u03be\\u03bf\\u03c5\\u03c3\\u03af\\u03b1\\u03bd \\u1f10\\u03c3\\u03c4\\u03af \\u03c4\\u03b9 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd, \\u1f45\\u03c4\\u03b9 \\u03c4\\u1ff6\\u03bd \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f21\\u03bc\\u03b5\\u1fd6\\u03c2 \\u1f10\\u03c3\\u03bc\\u03b5\\u03bd \\u03ba\\u03cd\\u03c1\\u03b9\\u03bf\\u03b9, \\u1f00\\u03bb\\u03bb' \\u03bf\\u1f50\\u03ba \\u1f14\\u03be\\u03c9\\u03b8\\u03ad\\u03bd \\u03c4\\u03b9\\u03c2 \\u03b1\\u1f30\\u03c4\\u03af\\u03b1. [...] \\u1f41 \\u03b3\\u1f70\\u03c1 \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03c2 \\u1f00\\u03c1\\u03c7\\u1f74 \\u03ba\\u03b1\\u1f76 \\u03b1\\u1f30\\u03c4\\u03af\\u03b1 \\u03c4\\u1ff6\\u03bd \\u03b4\\u03b9' \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c0\\u03c1\\u03ac\\u03be\\u03b5\\u03c9\\u03bd.\\n\\n**English Translation (Sharples 1983):**\\nFor it is because of such power\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"603fb3ae-431c-57cd-b4bd-a02765aeacf8\", \"excerpt\": \"Alexander Aphrod. de fato cp. 15 p. 185, 7 Bruns. \\u03c4\\u1f78 \\u03b4\\u2019 \\u1f10\\u03c0\\u03bf\\u03c7\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u03c4\\u1ff7 \\u03b5\\u1f30 \\u03b4\\u1f74 \\u03c4\\u1ff6\\u03bd \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd \\u03c0\\u03b5\\u03c1\\u03b9\\u03b5\\u03c3\\u03c4\\u03ce\\u03c4\\u03c9\\u03bd \\u1f41\\u03c4\\u1f72 \\u03bc\\u1f72\\u03bd \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u1f41\\u03c4\\u1f72 \\u03b4\\u1f72 \\u1f04\\u03bb\\u03bb\\u03c9\\u03c2 \\u1f10\\u03bd\\u03b5\\u03c1\\u03b3\\u03ae\\u03c3\\u03b5\\u03b9 \\u03c4\\u03b9\\u03c2, \\u1f00\\u03bd\\u03b1\\u03af\\u03c4\\u03b9\\u03bf\\u03bd \\u03ba\\u03af\\u03bd\\u03b7\\u03c3\\u03b9\\u03bd \\u03b5\\u1f30\\u03c3\\u03ac\\u03b3\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03b4\\u03b9\\u1f70 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd \\u03bc\\u1f74 \\u03b4\\u03cd\\u03bd\\u03b1\\u03c3\\u03b8\\u03b1\\u03b9 \\u03bf\\u1f57 \\u03c0\\u03c1\\u03ac\\u03be\\u03b5\\u03b9 \\u03c4\\u03b9\\u03c2 \\u03c0\\u03c1\\u1fb6\\u03be\\u03b1\\u03b9 \\u03c4\\u1f78 \\u1f00\\u03bd\\u03c4\\u03b9\\u03ba\\u03b5\\u03af\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd, \\u03bc\\u03ae\\u03c0\\u03bf\\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03b1\\u1f50\\u03c4\\u1f78 \\u03c4\\u1ff6\\u03bd \\uff0d \\u03c0\\u03b1\\u03c1\\u03bf\\u03c1\\u03c9\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd.\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"9313cded-1ee5-56bf-9df0-1461ffe30850\", \"excerpt\": \"Alexander Aphrod. de fato cp. 15 p. 186, 3 Bruns. \\u03c4\\u1f78 \\u03b4\\u1f72 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03b2\\u03bf\\u03c5\\u03bb\\u03b5\\u03c5\\u03c3\\u03b1\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u03c4\\u1ff7 \\u03c6\\u03b1\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u1ff3 \\u03c3\\u03c5\\u03b3\\u03ba\\u03b1\\u03c4\\u03b1\\u03c4\\u03af\\u03b8\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b9\\u1f70 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03ba\\u03b1\\u1f76 \\u03c4\\u1fc7 \\u03c6\\u03b1\\u03bd\\u03c4\\u03b1\\u03c3\\u03af\\u1fb3 \\u1f41\\u03bc\\u03bf\\u03af\\u03c9\\u03c2 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f04\\u03bb\\u03bb\\u03bf\\u03b9\\u03c2 \\u03b6\\u1ff4\\u03bf\\u03b9\\u03c2 \\u1f15\\u03c0\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u03bf\\u1f50\\u03ba \\u1f00\\u03bb\\u03b7\\u03b8\\u03ad\\u03c2.\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

