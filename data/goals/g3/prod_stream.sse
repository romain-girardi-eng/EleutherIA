data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"8f09ece1-51c4-4ccb-9620-86f419890b38\", \"excerpt\": \"\\u03c4\\u1fc6\\u03c2 \\u1f00\\u03c1\\u03b5\\u03c4\\u1fc6\\u03c2 \\u03b4\\u1f72 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c0\\u03ac\\u03b8\\u03b7 \\u1f15\\u03c9\\u03c2 \\u03c4\\u1f78 \\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03b1\\u03b9 \\u1f00\\u03ba\\u03bf\\u03cd\\u03c3\\u03b9\\u03b1. \\u1f29 \\u03bc\\u1f72\\u03bd \\u03c0\\u03c1\\u03cc\\u03b8\\u03b5\\u03c3\\u03b9\\u03c2 \\u03c0\\u03b5\\u03c1\\u1f76 \\u1f00\\u03ba\\u03bf\\u03c5\\u03c3\\u03af\\u03bf\\u03c5 \\u03ba\\u03b1\\u1f76 \\u1f11\\u03ba\\u03bf\\u03c5\\u03c3\\u03af\\u03bf\\u03c5 \\u03b5\\u1f30\\u03c0\\u03b5\\u1fd6\\u03bd\\u00b7 \\u03c0\\u03c1\\u1ff6\\u03c4\\u03bf\\u03bd \\u03b4\\u1f72 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9, \\u1f45\\u03c4\\u03b9 \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03b1\\u03af\\u03b1 \\u1f21 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd \\u03b8\\u03b5\\u03c9\\u03c1\\u03af\\u03b1 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03c0\\u03b5\\u03c1\\u1f76 \\u1f00\\u03c1\\u03b5\\u03c4\\u1fc6\\u03c2 \\u1f10\\u03c0\\u03b9\\u03c3\\u03ba\\u03bf\\u03c0\\u03bf\\u1fe6\\u03c3\\u03b9 \\u03ba\\u03b1\\u1f76 \\u1f45\\u03bb\\u03c9\\u03c2 \\u03c4\\u1ff7 \\u03c0\\u03bf\\u03bb\\u03b9\\u03c4\\u03b9\\u03ba\\u1ff7 \\u03ba\\u03b1\\u1f76 \\u03bd\\u03bf\\u03bc\\u03bf\\u03b8\\u03b5\\u03c4\\u03b9\\u03ba\\u1ff7. \\u1f10\\u03c0\\u03b5\\u1f76 \\u03b3\\u1f70\\u03c1 \\u1f21 \\u1f00\\u03c1\\u03b5\\u03b9\\u1f74 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c0\\u03ac\\u03b8\\u03b7 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03c1\\u03ac\\u03be\\u03b5\\u03b9\\u03c2, \\u1f10\\u03bd \\u03bf\\u1f37\\u03c2 \\u03c4\\u1f78 \\u03bc\\u1f72\\u03bd \\u1f11\\u03ba\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03bd \\u1f10\\u03c0\\u03b1\\u03b9\\u03bd\\u03b5\\u1fd6\\u03c4\\u03b1\\u03b9, \\u1f02\\u03bd \\u03ba\\u03b1\\u03bb\\u1ff6\\u03c2 \\u03b3\\u03ad\\u03bd\\u03b7\\u03c4\\u03b1\\u03b9, \\u03c4\\u1f78 \\u03b4\\u2019 \\u1f00\\u03ba\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03bd \\u03c3\\u03c5\\u03b3\\u03b3\\u03bd\\u03ce\\u03bc\\u03b7\\u03c2 \\u03c4\\u03c5\\u03b3\\u03c7\\u03ac\\u03bd\\u03b5\\u03b9, \\u1f10\\u03bd\\u03af\\u03bf\\u03c4\\u03b5 \\u03b4\\u1f72 \\u03ba\\u03b1\\u1f76 \\u1f10\\u03bb\\u03ad\\u03bf\\u03c5, \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03b1\\u1fd6\\u03bf\\u03bd \\u03c4\\u1ff7 \\u03c0\\u03b5\\u03c1\\u1f76 \\u1f00\\u03c1\\u03b5\\u03c4\\u1fc6\\u03c2 \\u1f10\\u03c0\\u03b9\\u03c3\\u03ba\\u03bf\\u03c0\\u03bf\\u1fe6\\u03bd\\u03c4\\u03b9\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"In Ethica Nicomachea Commentaria\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"e311f0e8-1149-4a8d-923e-d30893414a99\", \"excerpt\": \"\\u03a4\\u03bf\\u1fe6 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u03c7\\u03c1\\u03b7\\u03c3\\u03c4\\u03b7\\u03c1\\u03af\\u03c9\\u03bd \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03c5 \\u03b4\\u03b9\\u1f70 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03b4\\u03b9\\u03b7\\u03bd\\u03c5\\u03c3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f50\\u03c4\\u03ac\\u03c1\\u03ba\\u03c9\\u03c2 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f00\\u03c0\\u03b5\\u03bb\\u03b7\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5, \\u03ba\\u03b1\\u1f76 \\u03c4\\u1fc6\\u03c2 \\u03b8\\u03b5\\u03af\\u03b1\\u03c2 \\u03b4\\u03c5\\u03bd\\u03ac\\u03bc\\u03b5\\u03c9\\u03c2 \\u03c4\\u03bf\\u1fe6 \\u03c3\\u03c9\\u03c4\\u1fc6\\u03c1\\u03bf\\u03c2 \\u1f21\\u03bc\\u1ff6\\u03bd \\u03b4\\u03b9\\u1f70 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f50\\u03b1\\u03b3\\u03b3\\u03b5\\u03bb\\u03b9\\u03ba\\u1fc6\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03b4\\u03b9\\u03b4\\u03b1\\u03c3\\u03ba\\u03b1\\u03bb\\u03af\\u03b1\\u03c2 \\u03c4\\u1f78 \\u03b8\\u03b5\\u03bf\\u03c0\\u03c1\\u03b5\\u03c0\\u1f72\\u03c2 \\u1f05\\u03bc\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03b2\\u03b9\\u03c9\\u03c6\\u03b5\\u03bb\\u1f72\\u03c2 \\u1f10\\u03c0\\u03b9\\u03b4\\u03b5\\u03b4\\u03b5\\u03b9\\u03b3\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2, \\u1f45\\u03c4\\u03b9 \\u03b4\\u1f74 \\u03b4\\u03b9\\u1f70 \\u03bc\\u03cc\\u03bd\\u03b7\\u03c2 \\u03b1\\u1f50\\u03c4\\u1fc6\\u03c2, \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f50 \\u03b4\\u03b9\\u1fbf \\u1f04\\u03bb\\u03bb\\u03b7\\u03c2, \\u03c4\\u1ff6\\u03bd \\u1f10\\u03be \\u03b1\\u1f30\\u1ff6\\u03bd\\u03bf\\u03c2 \\u03c4\\u1f78\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b2\\u03af\\u03bf\\u03bd \\u1f10\\u03c0\\u03b9\\u03c3\\u03ba\\u03bf\\u03c4\\u03b9\\u03c3\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03bb\\u03c5\\u03bc\\u03b7\\u03bd\\u03b1\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b4\\u03b1\\u03b9\\u03bc\\u03bf\\u03bd\\u03b9\\u03ba\\u1ff6\\u03bd \\u03c6\\u03b1\\u03bd\\u03c4\\u03b1\\u03c3\\u03bc\\u03ac\\u03c4\\u03c9\\u03bd \\u1f10\\u03bb\\u03b5\\u03c5\\u03b8\\u03b5\\u03c1\\u03af\\u03b1 \\u03c0\\u1fb6\\u03c3\\u03b9\\u03bd \\u1f51\\u03c0\\u1fc6\\u03c1\\u03c7\\u03b5\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03bf\\u03b9\\u03c2, \\u03c6\\u03ad\\u03c1\\u03b5 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Praeparatio Evangelica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"ae88c271-a54c-4da5-8842-fc4eecc661c2\", \"excerpt\": \"\\u1f14\\u03bd\\u03b5\\u03c3\\u03c4\\u03b9 \\u03b4\\u2019 \\u1f41\\u03c1\\u1fb6\\u03bd, \\u03b5\\u1f30 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u03bb\\u03ad\\u03b3\\u03bf\\u03bd\\u03c4\\u03b5\\u03c2 \\u03c3\\u03ce\\u03b6\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd \\u03c4\\u1f70\\u03c2 \\u03ba\\u03bf\\u03b9\\u03bd\\u1f70\\u03c2 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd \\u03c0\\u03c1\\u03bf\\u03bb\\u03ae\\u03c8\\u03b5\\u03b9\\u03c2. \\u03bf\\u1f31 \\u03b3\\u1f70\\u03c1 \\u1f00\\u03c0\\u03b1\\u03b9\\u03c4\\u03bf\\u1fe6\\u03bd\\u03c4\\u03b5\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u03cd\\u03c2, \\u03c0\\u1ff6\\u03c2 \\u03bf\\u1f37\\u03cc\\u03bd \\u03c4\\u03b5 \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u1f44\\u03bd\\u03c4\\u03c9\\u03bd \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03c4\\u1f78 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c3\\u03ce\\u03b6\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u03bf\\u1f50\\u03ba \\u1f44\\u03bd\\u03bf\\u03bc\\u03b1 \\u03bc\\u03cc\\u03bd\\u03bf\\u03bd \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03c4\\u03b5\\u03c2 \\u03c4\\u03bf\\u1fe6\\u03c4\\u2019 \\u1f00\\u03c0\\u03b1\\u03b9\\u03c4\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03ba\\u03b1\\u1f76 \\u03c3\\u03b7\\u03bc\\u03b1\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd \\u1f10\\u03ba\\u03b5\\u1fd6\\u03bd\\u03bf \\u03c4\\u1f78 \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03bd. \\u03b4\\u03b9\\u1f70 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1f78 \\u03c4\\u03bf\\u03b9\\u03bf\\u1fe6\\u03c4\\u03bf\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f78 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c0\\u03b5\\u03c0\\u03b9\\u03c3\\u03c4\\u03b5\\u1fe6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03b5\\u1f50\\u03b8\\u03cd\\u03bd\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd \\u03c4\\u03bf\\u1f7a\\u03c2 \\u1f10\\u03be \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03c2 \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03bb\\u03ad\\u03b3\\u03bf\\u03bd\\u03c4\\u03b1\\u03c2. \\u03bf\\u1f31 \\u03b4\\u1f72 \\u03b4\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"6ec36c57-dbc9-5bce-aca5-6487b10ba05a\", \"excerpt\": \"Origenes comment. in Genesin Tom. II p. 13 Delarue. \\u1f45\\u03c4\\u03b9 \\u03bc\\u03ad\\u03bd\\u03c4\\u03bf\\u03b9 \\u03b3\\u03b5 \\u03c0\\u03bf\\u03bb\\u03bb\\u1ff6\\u03bd \\u03c4\\u1ff6\\u03bd \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03b1\\u1f34\\u03c4\\u03b9\\u03b1 \\u03c0\\u03bb\\u03b5\\u1fd6\\u03c3\\u03c4\\u03b1 \\u03c4\\u1ff6\\u03bd \\u03bf\\u1f50\\u03ba \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9 \\u03ba\\u03b1\\u1f76 \\u1f21\\u03bc\\u03b5\\u1fd6\\u03c2 \\u1f41\\u03bc\\u03bf\\u03bb\\u03bf\\u03b3\\u03ae\\u03c3\\u03bf\\u03bc\\u03b5\\u03bd\\u00b7 \\u1f67\\u03bd \\u03bc\\u1f74 \\u03b3\\u03b5\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd, \\u03bb\\u03ad\\u03b3\\u03c9 \\u03b4\\u1f72 \\u03c4\\u1ff6\\u03bd \\u03bf\\u1f50\\u03ba \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd, \\u03bf\\u1f50\\u03ba \\u1f02\\u03bd \\u03c4\\u03ac\\u03b4\\u03b5 \\u03c4\\u03b9\\u03bd\\u1f70 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f10\\u03c0\\u03c1\\u03ac\\u03c4\\u03c4\\u03b5\\u03c4\\u03bf\\u00b7 \\u03c0\\u03c1\\u03ac\\u03c4\\u03c4\\u03b5\\u03c4\\u03b1\\u03b9 \\u03b4\\u1f72 \\u03c4\\u03ac\\u03b4\\u03b5 \\u03c4\\u03b9\\u03bd\\u1f70 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f00\\u03ba\\u03cc\\u03bb\\u03bf\\u03c5\\u03b8\\u03b1 \\u03c4\\u03bf\\u1fd6\\u03c3\\u03b4\\u03b5 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03c0\\u03c1\\u03bf\\u03b3\\u03b5\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u03bf\\u1f50\\u03ba \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd, \\u1f10\\u03bd\\u03b4\\u03b5\\u03c7\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5 \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c0\\u1f76 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fd6\\u03c2 \\u03c0\\u03c1\\u03bf\\u03b3\\u03b5\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f15\\u03c4\\u03b5\\u03c1\\u03b1 \\u03c0\\u03c1\\u1fb6\\u03be\\u03b1\\u03b9 \\u03c0\\u03b1\\u03c1\\u2019 \\u1f03 \\u03c0\\u03c1\\u03ac\\u03c4\\u03c4\\u03bf\\u03bc\\u03b5\\u03bd. \\u03b5\\u1f30 \\u03b4\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"a343b50a-6de2-55be-b2d7-80e1c89133e5\", \"excerpt\": \"<\\u03a0\\u0395\\u03a1\\u0399 \\u0391\\u03a1\\u03a7\\u03a9\\u039d \\u03a4\\u039f\\u039c\\u039f\\u03a3 \\u03a4\\u03a1\\u0399\\u03a4\\u039f\\u03a3>\\u03b1\\u02b9. \\u03a0\\u03b5\\u03c1\\u1f76 \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03c5\\u03c3\\u03af\\u03bf\\u03c5, \\u03ba\\u03b1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u03b4\\u03bf\\u03ba\\u03bf\\u03cd\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u1f00\\u03bd\\u03b1\\u03b9\\u03c1\\u03b5\\u1fd6\\u03bd\\u1fe5\\u03b7\\u03c4\\u1ff6\\u03bd \\u03b3\\u03c1\\u03b1\\u03c6\\u03b9\\u03ba\\u1ff6\\u03bd \\u03bb\\u03cd\\u03c3\\u03b9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f11\\u03c1\\u03bc\\u03b7\\u03bd\\u03b5\\u03af\\u03b11. \\u1f18\\u03c0\\u03b5\\u1f76 \\u03b4\\u1f72 \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03ba\\u03b7\\u03c1\\u03cd\\u03b3\\u03bc\\u03b1\\u03c4\\u03b9 \\u03c4\\u1ff7 \\u1f10\\u03ba\\u03ba\\u03bb\\u03b7\\u03c3\\u03b9\\u03b1\\u03c3\\u03c4\\u03b9\\u03ba\\u1ff7 \\u03c0\\u03b5\\u03c1\\u03b9\\u03ad\\u03c7\\u03b5\\u03c4\\u03b1\\u03b9\\u1f41 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03ba\\u03c1\\u03af\\u03c3\\u03b5\\u03c9\\u03c2 \\u03b4\\u03b9\\u03ba\\u03b1\\u03af\\u03b1\\u03c2 \\u03b8\\u03b5\\u03bf\\u1fe6 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c2, \\u1f45\\u03c3\\u03c4\\u03b9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u1f00\\u03ba\\u03bf\\u03cd\\u03bf\\u03bd\\u03c4\\u03b1\\u03c2,\\u03c0\\u03b9\\u03c3\\u03c4\\u03b5\\u03c5\\u03b8\\u03b5\\u1f76\\u03c2 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u1f00\\u03bb\\u03b7\\u03b8\\u03ae\\u03c2, \\u03c0\\u03c1\\u03bf\\u03ba\\u03b1\\u03bb\\u03b5\\u1fd6\\u03c4\\u03b1\\u03b9 \\u1f10\\u03c0\\u1f76 \\u03c4\\u1f78 \\u03ba\\u03b1\\u03bb\\u1ff6\\u03c2 \\u03b2\\u03b9\\u03bf\\u1fe6\\u03bd\\u03ba\\u03b1\\u1f76 \\u03c0\\u03b1\\u03bd\\u03c4\\u1f76 \\u03c4\\u03c1\\u03cc\\u03c0\\u1ff3 \\u03c6\\u03b5\\u03cd\\u03b3\\u03b5\\u03b9\\u03bd \\u03c4\\u1f74\\u03bd \\u1f01\\u03bc\\u03b1\\u03c1\\u03c4\\u03af\\u03b1\\u03bd, \\u03b4\\u03b7\\u03bb\\u03bf\\u03bd\\u03cc\\u03c4\\u03b9 \\u03c3\\u03c5\\u03b3\\u03ba\\u03b1\\u03c4\\u03b1-\\u03c4\\u03b9\\u03b8\\u03b5\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u03c4\\u1f78 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f70 \\u1f10\\u03c0\\u03b1\\u03af\\u03bd\\u03bf\\u03c5 \\u03ba\\u03b1\\u1f76 \\u03c8\\u03cc\\u03b3\\u03bf\\u03c5 \\u1f04\\u03be\\u03b9\\u03b1,\\u03c6\\u03ad\\u03c1\\u03b5 \\u03ba\\u03b1\\u1f76 \", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Principiis (Peri Archon)\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"15bb8fb6-af46-5d9a-a659-03e710004452\", \"excerpt\": \"\\u1f45\\u03c4\\u03b9 \\u03bc\\u1f73\\u03bd\\u03c4\\u03bf\\u03b9 \\u03b3\\u03b5 \\u03c0\\u03bf\\u03bb\\u03bb\\u1ff6\\u03bd \\u03c4\\u1ff6\\u03bd \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03b1\\u1f34\\u03c4\\u03b9\\u03b1 \\u03c0\\u03bb\\u03b5\\u1fd6\\u03c3\\u03c4\\u03b1 \\u03c4\\u1f79\\u03bd \\u03bf\\u1f50\\u03ba \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9 \\u03ba\\u03b1\\u1f76 \\u1f21\\u03bc\\u03b5\\u1fd6\\u03c2 \\u1f41\\u03bc\\u03bf\\u03bb\\u03bf\\u03b3\\u1f75\\u03c3\\u03bf\\u03bc\\u03b5\\u03bd\\u0387 \\u1f67\\u03bd \\u03bc\\u1f74 \\u03b3\\u03b5\\u03bd\\u03bf\\u03bc\\u1f73\\u03bd\\u03c9\\u03bd, \\u03bb\\u1f73\\u03b3\\u03c9 \\u03b4\\u1f72 \\u03c4\\u1ff6\\u03bd \\u03bf\\u1f50\\u03ba \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd, \\u03bf\\u1f50\\u03ba \\u1f02\\u03bd \\u03c4\\u1f71\\u03b4\\u03b5 \\u03c4\\u03b9\\u03bd\\u1f70 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f10\\u03c0\\u03c1\\u1f71\\u03c4\\u03c4\\u03b5\\u03c4\\u03bf. \\u03c0\\u03c1\\u1f71\\u03c4\\u03c4\\u03b5\\u03c4\\u03b1\\u03b9 \\u03b4\\u1f72 \\u03c4\\u1f71\\u03b4\\u03b5 \\u03c4\\u03b9\\u03bd\\u1f70 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f00\\u03ba\\u1f79\\u03bb\\u03bf\\u03c5\\u03b8\\u03b1 \\u03c4\\u03bf\\u1fd6\\u03c3\\u03b4\\u03b5 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03c0\\u03c1\\u03bf\\u03b3\\u03b5\\u03bd\\u03bf\\u03bc\\u1f73\\u03bd\\u03bf\\u03b9\\u03c2 \\u03bf\\u1f50\\u03ba \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd, \\u1f10\\u03bd\\u03b4\\u03b5\\u03c7\\u03bf\\u03bc\\u1f73\\u03bd\\u03bf\\u03c5 \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c0\\u1f76 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fd6\\u03c2 \\u03c0\\u03c1\\u03bf- \\u03b3\\u03b5\\u03bd\\u03bf\\u03bc\\u1f73\\u03bd\\u03bf\\u03b9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f15\\u03c4\\u03b5\\u03c1\\u03b1 \\u03c0\\u03c1\\u1fb6\\u03be\\u03b1\\u03b9 \\u03c0\\u03b1\\u03c1\\u2019 \\u1f03 \\u03c0\\u03c1\\u1f71\\u03c4\\u03c4\\u03bf\\u03bc\\u03b5\\u03bd.\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Praeparatio Evangelica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"dd5cfa96-1255-5ec7-8772-7f5ebe25b298\", \"excerpt\": \"**Reference:** Discourses I.1.1\\n**Author:** Epictetus\\n**Work:** Discourses (\\u0394\\u03b9\\u03b1\\u03c4\\u03c1\\u03b9\\u03b2\\u03b1\\u03af)\\n**Edition:** Schenkl (Teubner)\\n\\n**Original Greek:**\\n\\u03a4\\u1ff6\\u03bd \\u1f44\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u1f70 \\u03bc\\u03ad\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9\\u03bd \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd, \\u03c4\\u1f70 \\u03b4\\u1f72 \\u03bf\\u1f50\\u03ba \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd. \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03bc\\u1f72\\u03bd \\u1f51\\u03c0\\u03cc\\u03bb\\u03b7\\u03c8\\u03b9\\u03c2, \\u1f41\\u03c1\\u03bc\\u03ae, \\u1f44\\u03c1\\u03b5\\u03be\\u03b9\\u03c2, \\u1f14\\u03ba\\u03ba\\u03bb\\u03b9\\u03c3\\u03b9\\u03c2, \\u03ba\\u03b1\\u1f76 \\u1f11\\u03bd\\u1f76 \\u03bb\\u03cc\\u03b3\\u1ff3 \\u1f45\\u03c3\\u03b1 \\u1f21\\u03bc\\u03ad\\u03c4\\u03b5\\u03c1\\u03b1 \\u1f14\\u03c1\\u03b3\\u03b1\\u00b7 \\u03bf\\u1f50\\u03ba \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03b4\\u1f72 \\u03c4\\u1f78 \\u03c3\\u1ff6\\u03bc\\u03b1, \\u1f21 \\u03ba\\u03c4\\u1fc6\\u03c3\\u03b9\\u03c2, \\u03b4\\u03cc\\u03be\\u03b1\\u03b9, \\u1f00\\u03c1\\u03c7\\u03b1\\u03af, \\u03ba\\u03b1\\u1f76 \\u1f11\\u03bd\\u1f76 \\u03bb\\u03cc\\u03b3\\u1ff3 \\u1f45\\u03c3\\u03b1 \\u03bf\\u1f50\\u03c7 \\u1f21\\u03bc\\u03ad\\u03c4\\u03b5\\u03c1\\u03b1 \\u1f14\\u03c1\\u03b3\\u03b1.\\n\\n**Key Terms:** \\u03c4\\u1f70 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd, \\u1f51\\u03c0\\u03cc\\u03bb\\u03b7\\u03c8\\u03b9\\u03c2, \\u1f41\\u03c1\\u03bc\\u03ae, \\u1f44\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Discourses\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"94409d47-4f77-4e3d-a86d-f2c86e4f3984\", \"excerpt\": \"\\u03a4\\u1f78 \\u03b4\\u1f72 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd \\u1f21\\u03b3\\u03b5\\u1fd6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03bf\\u1f50\\u03c7 \\u1f21\\u03b3\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03c3\\u03ce\\u03b6\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u1f74\\u03bd \\u03ba\\u03b1\\u03b8\\u2019 \\u1f41\\u03c1\\u03bc\\u1f74\\u03bd \\u03c4\\u1ff6\\u03bd \\u03b6\\u1ff4\\u03c9\\u03bd \\u1f10\\u03bd\\u03ad\\u03c1\\u03b3\\u03b5\\u03b9\\u03b1\\u03bd \\u1f24\\u03b4\\u03b7 \\u03c3\\u03ce\\u03b6\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c4\\u1ff7 \\u03c0\\u1fb6\\u03bd \\u03c4\\u1f78 \\u03ba\\u03b1\\u03b8\\u2019 \\u1f41\\u03c1\\u03bc\\u1f74\\u03bd \\u03b3\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd \\u1f10\\u03c0\\u1f76 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f41\\u03c1\\u03bc\\u1ff6\\u03c3\\u03b9\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b9\\u1f70 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u1f10\\u03c1\\u03c9\\u03c4\\u1fb6\\u03bd, \\u03b5\\u1f30 \\u03bc\\u1f74 \\u1f10\\u03bd\\u03ad\\u03c1\\u03b3\\u03b7\\u03bc\\u03ac \\u03c4\\u03b9 \\u03c4\\u1f78 \\u1f10\\u03c6\\u2019 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9, \\u03ba\\u03b1\\u1f76 \\u03bb\\u03b1\\u03b2\\u03cc\\u03bd\\u03c4\\u03b1\\u03c2 \\u1f10\\u03c0\\u1f76 \\u03c4\\u03bf\\u03cd\\u03c4\\u1ff3 \\u03c0\\u03ac\\u03bb\\u03b9\\u03bd \\u1f10\\u03c1\\u03c9\\u03c4\\u1fb6\\u03bd, \\u03b5\\u1f30 \\u03bc\\u1f74 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03bd\\u03b5\\u03c1\\u03b3\\u03b7\\u03bc\\u03ac\\u03c4\\u03c9\\u03bd \\u03c4\\u1f70 \\u03bc\\u1f72\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03b4\\u03bf\\u03ba\\u03b5\\u1fd6 \\u03ba\\u03b1\\u03b8\\u2019 \\u1f41\\u03c1\\u03bc\\u03ae\\u03bd, \\u03c4\\u1f70 \\u03b4\\u2019 \\u03bf\\u1f50 \\u03ba\\u03b1\\u03b8\\u2019 \\u1f41\\u03c1\\u03bc\\u03ae\\u03bd, \\u1f43 \\u03bb\\u03b1\\u03b2\\u03cc\\u03bd\\u03c4\\u03b1\\u03c2 \\u03c0\\u03ac\\u03bb\\u03b9\\u03bd \\u03c0\\u03c1\\u03bf\\u03c3\\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03b1\\u03b9 \\u03c4\\u03bf\\u03cd\\u03c4\\u1ff3 \\u03c4\\u1f78 \\u03bc\\u1f74 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03bd\\u03b5\\u03c1\\u03b3\\u03b7\\u03bc\\u03ac\\u03c4\\u03c9\\u03bd \", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"fb28ddc6-0bdd-5387-8ed0-8e0c436ddeca\", \"excerpt\": \"Origenes de oratione 6 Vol. II p. 311, 16 K\\u00f6. (p. 206 ed. Delarue). \\u03a4\\u1ff6\\u03bd \\u03ba\\u03b9\\u03bd\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c4\\u1f70 \\u03bc\\u03ad\\u03bd \\u03c4\\u03b9\\u03bd\\u03b1 \\u03c4\\u1f78 \\u03ba\\u03b9\\u03bd\\u03bf\\u1fe6\\u03bd \\u1f14\\u03be\\u03c9\\u03b8\\u03b5\\u03bd \\u1f14\\u03c7\\u03b5\\u03b9, \\u1f65\\u03c3\\u03c0\\u03b5\\u03c1 \\u03c4\\u1f70 \\u1f04\\u03c8\\u03c5\\u03c7\\u03b1 \\u03ba\\u03b1\\u1f76 \\u1f51\\u03c0\\u1f78 \\u1f15\\u03be\\u03b5\\u03c9\\u03c2 \\u03bc\\u03cc\\u03bd\\u03b7\\u03c2 \\u03c3\\u03c5\\u03bd\\u03b5\\u03c7\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1\\u00b7 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f70 \\u1f51\\u03c0\\u1f78 \\u03c6\\u03cd\\u03c3\\u03b5\\u03c9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c8\\u03c5\\u03c7\\u1fc6\\u03c2 \\u03ba\\u03b9\\u03bd\\u03bf\\u03cd\\u03bc\\u03b5\\u03bd\\u03b1 \\u03bf\\u1f50\\u03c7 \\u1f97 \\u03c4\\u03bf\\u03b9\\u03b1\\u1fe6\\u03c4\\u03b1 \\u1f14\\u03c3\\u03b8\\u2019 \\u1f45\\u03c4\\u03b5 \\u03ba\\u03b9\\u03bd\\u03bf\\u03cd\\u03bc\\u03b5\\u03bd\\u03b1, \\u1f00\\u03bb\\u03bb\\u2019 \\u1f41\\u03bc\\u03bf\\u03af\\u03c9\\u03c2 \\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f51\\u03c0\\u1f78 \\u1f15\\u03be\\u03b5\\u03c9\\u03c2 \\u03bc\\u03cc\\u03bd\\u03b7\\u03c2 \\u03c3\\u03c5\\u03bd\\u03b5\\u03c7\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03b9\\u03c2. \\u039b\\u03af\\u03b8\\u03bf\\u03b9 \\u03b3\\u1f70\\u03c1 \\u03ba\\u03b1\\u1f76 \\u03be\\u03cd\\u03bb\\u03b1 \\u03c4\\u1f70 \\u1f10\\u03ba\\u03ba\\u03bf\\u03c0\\u03ad\\u03bd\\u03c4\\u03b1 \\u03c4\\u03bf\\u1fe6 \\u03bc\\u03b5\\u03c4\\u03ac\\u03bb\\u03bb\\u03bf\\u03c5 \\u1f22 \\u03c4\\u1f78 \\u03c6\\u03cd\\u03b5\\u03b9\\u03bd \\u1f00\\u03c0\\u03bf\\u03bb\\u03c9\\u03bb\\u03b5\\u03ba\\u03cc\\u03c4\\u03b1, \\u1f51\\u03c0\\u1f78 \\u1f15\\u03be\\u03b5\\u03c9\\u03c2 \\u03bc\\u03cc\\u03bd\\u03b7\\u03c2 \\u03c3\\u03c5\\u03bd\\u03b5\\u03c7\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1, \\u03c4\\u1f78 \\u03ba\\u03b9\\u03bd\\u03bf\\u1fe6\\u03bd \\u1f14\\u03be\\u03c9\\u03b8\\u03b5\\u03bd \\u1f14\\u03c7\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"aa06ed04-ba9d-4a55-9701-3f8826c977d5\", \"excerpt\": \"ARISTOTLE ON DELIBERATION AND THE SCOPE OF HUMAN AGENCY\\n\\nThis chapter defines the domain of deliberation and thereby the scope of \\u03c4\\u1f78 \\u1f10\\u03c6\\u02bc \\u1f21\\u03bc\\u1fd6\\u03bd (what is up to us) - the crucial concept for all subsequent free will debates.\\n\\nGreek: \\u03b2\\u03bf\\u03c5\\u03bb\\u03b5\\u03cd\\u03bf\\u03bd\\u03c4\\u03b1\\u03b9 \\u03b4\\u1f72 \\u03c0\\u03cc\\u03c4\\u03b5\\u03c1\\u03bf\\u03bd \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd, \\u03ba\\u03b1\\u1f76 \\u03c0\\u1fb6\\u03bd \\u03b2\\u03bf\\u03c5\\u03bb\\u03b5\\u03c5\\u03c4\\u03cc\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9\\u03bd, \\u1f22 \\u03c0\\u03b5\\u03c1\\u1f76 \\u1f10\\u03bd\\u03af\\u03c9\\u03bd \\u03bf\\u1f50\\u03ba \\u1f14\\u03c3\\u03c4\\u03b9 \\u03b2\\u03bf\\u03c5\\u03bb\\u03ae;... \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b4\\u1f74 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03b9\\u03b4\\u03af\\u03c9\\u03bd \\u03bf\\u1f50\\u03b4\\u03b5\\u1f76\\u03c2 \\u03b2\\u03bf\\u03c5\\u03bb\\u03b5\\u03cd\\u03b5\\u03c4\\u03b1\\u03b9, \\u03bf\\u1f37\\u03bf\\u03bd \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u03bf\\u1fe6 \\u03ba\\u03cc\\u03c3\\u03bc\\u03bf\\u03c5 \\u1f22 \\u03c4\\u1fc6\\u03c2 \\u03b4\\u03b9\\u03b1\\u03bc\\u03ad\\u03c4\\u03c1\\u03bf\\u03c5 \\u03ba\\u03b1\\u1f76\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Ethica Nicomachea\"}"}

