data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"d3a3c37e-a837-484f-961d-c8de568ecbc3\", \"excerpt\": \"Nec, si omne enuntiatum aut verum aut falsum est, sequitur ilico esse causas inmutabilis, easque aeternas, quae prohibeant quicquam secus cadere, atque casurum sit; fortuitae sunt causae, quae efficiant, ut vere dicantur, quae ita dicentur: 'Veniet in senatum Cato', non inclusae in rerum natura atque mundo; et tamen tam est inmutabile venturum, cum est verum, quam venisse (nec ob eam causam fatum \", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"01aa3782-db59-442d-8887-b74f4f32df38\", \"excerpt\": \"item, si fatum tibi est ex hoc morbo non convalescere, sive tu medicum adhibueris sive non adhibueris, non convalesces; et alterutrum fatum est; medicum ergo adhibere nihil attinet.' Recte genus hoc interrogationis ignavum atque iners nominatum est, quod eadem ratione omnis e vita tolletur actio. Licet etiam inmutare, ut fati nomen ne adiungas et eandem tamen teneas sententiam, hoc modo: 'Si ex ae\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"De Fato\"}"}

