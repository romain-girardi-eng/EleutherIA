data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"618df587-564c-5364-88f0-14e76a120657\", \"excerpt\": \"Alexander Aphrod. de fato cp. 10 p. 176, 14 Bruns. \\u03c4\\u1f78 \\u03b4\\u1f72 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd \\u03bc\\u1f74 \\u1f00\\u03bd\\u03b1\\u03b9\\u03c1\\u03b5\\u1fd6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03c4\\u1f78 \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u03cc\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u1f10\\u03bd\\u03b4\\u03b5\\u03c7\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd, \\u03c4\\u1ff7 \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u1f78\\u03bd \\u03bc\\u1f72\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03b3\\u03b5\\u03bd\\u03ad\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u1f43 \\u1f51\\u03c0\\u2019 \\u03bf\\u1f50\\u03b4\\u03b5\\u03bd\\u1f78\\u03c2 \\u03ba\\u03c9\\u03bb\\u03cd\\u03b5\\u03c4\\u03b1\\u03b9 \\u03b3\\u03b5\\u03bd\\u03ad\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u1f02\\u03bd \\u03bc\\u1f74 \\u03b3\\u03ad\\u03bd\\u03b7\\u03c4\\u03b1\\u03b9, \\u03c4\\u1ff6\\u03bd \\u03b4\\u1f72 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03b3\\u03b9\\u03bd\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03bf\\u1f50 \\u03ba\\u03b5\\u03ba\\u03ce\\u03bb\\u03c5\\u03c4\\u03b1\\u03b9 \\u03c4\\u1f70 \\u1f00\\u03bd\\u03c4\\u03b9\\u03ba\\u03b5\\u03af\\u03bc\\u03b5\\u03bd\\u03b1 \\u03b3\\u03b5\\u03bd\\u03ad\\u03c3\\u03b8\\u03b1\\u03b9\\u00b7 \\u03b4\\u03b9\\u1f78 \\u03ba\\u03b1\\u03af\\u03c4\\u03bf\\u03b9 \\u03bc\\u1f74 \\u03b3\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1 \\u1f45\\u03bc\\u03c9\\u03c2 \\u1f10\\u03c3\\u03c4\\u1f76 \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u03ac \\u03ba\\u03b1\\u1f76 \\u03c4\\u03bf\\u1fe6 \\u03bc\\u1f74 \\u0