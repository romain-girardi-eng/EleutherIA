data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"e311f0e8-1149-4a8d-923e-d30893414a99\", \"excerpt\": \"\\u03a4\\u03bf\\u1fe6 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u03c7\\u03c1\\u03b7\\u03c3\\u03c4\\u03b7\\u03c1\\u03af\\u03c9\\u03bd \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03c5 \\u03b4\\u03b9\\u1f70 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03b4\\u03b9\\u03b7\\u03bd\\u03c5\\u03c3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f50\\u03c4\\u03ac\\u03c1\\u03ba\\u03c9\\u03c2 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f00\\u03c0\\u03b5\\u03bb\\u03b7\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5, \\u03ba\\u03b1\\u1f76 \\u03c4\\u1fc6\\u03c2 \\u03b8\\u03b5\\u03af\\u03b1\\u03c2 \\u03b4\\u03c5\\u03bd\\u03ac\\u03bc\\u03b5\\u03c9\\u03c2 \\u03c4\\u03bf\\u1fe6 \\u03c3\\u03c9\\u03c4\\u1fc6\\u03c1\\u03bf\\u03c2 \\u1f21\\u03bc\\u1ff6\\u03bd \\u03b4\\u03b9\\u1f70 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f50\\u03b1\\u03b3\\u03b3\\u03b5\\u03bb\\u03b9\\u03ba\\u1fc6\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03b4\\u03b9\\u03b4\\u03b1\\u03c3\\u03ba\\u03b1\\u03bb\\u03af\\u03b1\\u03c2 \\u03c4\\u1f78 \\u03b8\\u03b5\\u03bf\\u03c0\\u03c1\\u03b5\\u03c0\\u1f72\\u03c2 \\u1f05\\u03bc\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03b2\\u03b9\\u03c9\\u03c6\\u03b5\\u03bb\\u1f72\\u03c2 \\u1f10\\u03c0\\u03b9\\u03b4\\u03b5\\u03b4\\u03b5\\u03b9\\u03b3\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2, \\u1f45\\u03c4\\u03b9 \\u03b4\\u1f74 \\u03b4\\u03b9\\u1f70 \\u03bc\\u03cc\\u03bd\\u03b7\\u03c2 \\u03b1\\u1f50\\u03c4\\u1fc6\\u03c2, \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f50 \\u03b4\\u03b9\\u1fbf \\u1f04\\u03bb\\u03bb\\u03b7\\u03c2, \\u03c4\\u1ff6\\u03bd \\u1f10\\u03be \\u03b1\\u1f30\\u1ff6\\u03bd\\u03bf\\u03c2 \\u03c4\\u1f78\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b2\\u03af\\u03bf\\u03bd \\u1f10\\u03c0\\u03b9\\u03c3\\u03ba\\u03bf\\u03c4\\u03b9\\u03c3\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03bb\\u03c5\\u03bc\\u03b7\\u03bd\\u03b1\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b4\\u03b1\\u03b9\\u03bc\\u03bf\\u03bd\\u03b9\\u03ba\\u1ff6\\u03bd \\u03c6\\u03b1\\u03bd\\u03c4\\u03b1\\u03c3\\u03bc\\u03ac\\u03c4\\u03c9\\u03bd \\u1f10\\u03bb\\u03b5\\u03c5\\u03b8\\u03b5\\u03c1\\u03af\\u03b1 \\u03c0\\u1fb6\\u03c3\\u03b9\\u03bd \\u1f51\\u03c0\\u1fc6\\u03c1\\u03c7\\u03b5\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03bf\\u03b9\\u03c2, \\u03c6\\u03ad\\u03c1\\u03b5 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Praeparatio Evangelica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"168ce62d-0416-48b4-80f7-c0a56a7584e1\", \"excerpt\": \"Justin Martyr's famous antifatalist argument, central to early Christian apologetics on free will. This is the locus classicus for understanding how the Apologists rejected Stoic fate while affirming divine foreknowledge.\\n\\nGREEK TEXT (verified from database, passage_id: 168ce62d-0416-48b4-80f7-c0a56a7584e1):\\n\\u1f4d\\u03c0\\u03c9\\u03c2 \\u03b4\\u1f72 \\u03bc\\u03ae \\u03c4\\u03b9\\u03bd\\u03b5\\u03c2 \\u1f10\\u03ba \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03bb\\u03b5\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f51\\u03c6\\u1fbf \\u1f21\\u03bc\\u1ff6\\u03bd \\u03b4\\u03bf\\u03be\\u03ac\\u03c3\\u03c9\\u03c3\\u03b9 \\u03ba\\u03b1\\u03b8\\u1fbf \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03bd \\u03c6\\u03ac\\u03c3\\u03ba\\u03b5\\u03b9\\u03bd \\u1f21\\u03bc\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Apologia Prima\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"688bbd38-3ae3-5c2a-bffc-6d11dd2f039b\", \"excerpt\": \"Justin Martyr's famous antifatalist argument, central to early Christian apologetics on free will. This is the locus classicus for understanding how the Apologists rejected Stoic fate while affirming divine foreknowledge.\\n\\n\\\"But lest some suppose, from what we have said, that we say that events happen by fated necessity (\\u03ba\\u03b1\\u03b8\\u1fbf \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03bd), because they are foreknown, we shall resolve this to\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"First Apology (\\u1f08\\u03c0\\u03bf\\u03bb\\u03bf\\u03b3\\u03af\\u03b1 \\u03c0\\u03c1\\u03ce\\u03c4\\u03b7)\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"0e8c1f8b-5a0b-53a8-8e92-8fcb98ce6936\", \"excerpt\": \"Iustinus apol. II 7. \\u03bf\\u1f31 \\u03a3\\u03c4\\u03c9\\u03ca\\u03ba\\u03bf\\u1f76 \\u03ba\\u03b1\\u03b8\\u2019 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u1f00\\u03c0\\u03b5\\u03c6\\u03ae\\u03bd\\u03b1\\u03bd\\u03c4\\u03bf. ibidem paulo post: \\u03b3\\u03b5\\u03bd\\u03bd\\u03b7\\u03c4\\u03bf\\u1fe6 \\u03b4\\u1f72 \\u03c0\\u03b1\\u03bd\\u03c4\\u1f78\\u03c2 \\u1f25\\u03b4\\u03b5 \\u1f21 \\u03c6\\u03cd\\u03c3\\u03b9\\u03c2, \\u03ba\\u03b1\\u03ba\\u03af\\u03b1\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03c1\\u03b5\\u03c4\\u1fc6\\u03c2 \\u03b4\\u03b5\\u03ba\\u03c4\\u03b9\\u03ba\\u1f78\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9\\u00b7 \\u03bf\\u1f50 \\u03b3\\u1f70\\u03c1 \\u1f02\\u03bd \\u1f26\\u03bd \\u1f10\\u03c0\\u03b1\\u03b9\\u03bd\\u03b5\\u03c4\\u1f78\\u03bd \\u03bf\\u1f50\\u03b4\\u1f72\\u03bd \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd, \\u03b5\\u1f30 \\u03bf\\u1f50\\u03ba \\u1f02\\u03bd \\u1f10\\u03c0\\u2019 \\u1f00\\u03bc\\u03c6\\u03cc\\u03c4\\u03b5\\u03c1\\u03b1 \\u03c4\\u03c1\\u03ad\\u03c0\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03cd\\u03bd\\u03b1\\u03bc\\u03b9\\u03bd \\u03b5\\u1f36\\u03c7\\u03b5. \\u0394\\u03b5\\u03b9\\u03ba\\u03bd\\u03cd\\u03bf\\u03c5\\u03c3\\u03b9 \\u03b4\\u1f72 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f31 \\u03c0\\u03b1\\u03bd\\u03c4\\u03b1\\u03c7\\u03bf\\u1fe6 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03bb\\u03cc\\u03b3\\u03bf\\u03bd \\u03c4\\u1f78\\u03bd \\u1f40\\u03c1\\u03b8\\u1f78\\u03bd \\u03bd\\u03bf\\u03bc\\u03bf\\u03b8\\u03b5\\u03c4\\u03ae\\u03c3\\u03b1\\u03bd\\u03c4\\u03b5\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c6\\u03b9\\u03bb\\u03bf\\u03c3\\u03bf\\u03c6\\u03ae\\u03c3\\u03b1\\u03bd\\u03c4\\u03b5\\u03c2 \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03b9 \\u1f10\\u03ba \\u03c4\\u03bf\\u1fe6 \\u1f51\\u03c0\\u03b1\\u03b3\\u03bf\\u03c1\\u03b5\\u03cd\\u03b5\\u03b9\\u03bd \\u03c4\\u03ac\\u03b4\\u03b5 \\u03bc\\u1f72\\u03bd \\u03c0\\u03c1\\u03ac\\u03c4\\u03c4\\u03b5\\u03b9\\u03bd, \\u03c4\\u1ff6\\u03bd\\u03b4\\u03b5 \\u03b4\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"c2b1124e-da5c-55e6-9549-79033bc71a2f\", \"excerpt\": \"1. \\u1f4d\\u03c0\\u03c9\\u03c2 \\u03b4\\u1f72 \\u03bc\\u03ae \\u03c4\\u03b9\\u03bd\\u03b5\\u03c2 \\u1f10\\u03ba \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03bb\\u03b5\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f51\\u03c6' \\u1f21\\u03bc\\u1ff6\\u03bd \\u03b4\\u03bf\\u03be\\u03ac\\u03c3\\u03c9\\u03c3\\u03b9 \\u03ba\\u03b1\\u03b8' \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03bd \\u03c6\\u03ac\\u03c3\\u03ba\\u03b5\\u03b9\\u03bd \\u1f21\\u03bc\\u1fb6\\u03c2 \\u03c4\\u1f70 \\u03b3\\u03b9\\u03bd\\u03cc-\\u03bc\\u03b5\\u03bd\\u03b1 \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u1f10\\u03ba \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03c1\\u03bf\\u03b5\\u03b9\\u03c0\\u03b5\\u1fd6\\u03bd \\u03c0\\u03c1\\u03bf\\u03b5\\u03b3\\u03bd\\u03c9\\u03c3\\u03bc\\u03ad\\u03bd\\u03b1, \\u03ba\\u03b1\\u1f76 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03b4\\u03b9\\u03b1\\u03bb\\u03cd<\\u03c3>\\u03bf\\u03bc\\u03b5\\u03bd. 2. \\u03a4\\u1f70\\u03c2 \\u03c4\\u03b9\\u03bc\\u03c9\\u03c1\\u03af\\u03b1\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f70\\u03c2 \\u03ba\\u03bf\\u03bb\\u03ac\\u03c3\\u03b5\\u03b9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f70\\u03c2 \\u1f00\\u03b3\\u03b1\\u03b8\\u1f70\\u03c2 \\u1f00\\u03bc\\u03bf\\u03b9\\u03b2\\u1f70\\u03c2 \\u03ba\\u03b1\\u03c4' \\u1f00\\u03be\\u03af\\u03b1\\u03bd \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03ac\\u03be\\u03b5\\u03c9\\u03bd \\u1f11\\u03ba\\u03ac\\u03c3\\u03c4\\u03bf\\u03c5 \\u1f00\\u03c0\\u03bf\\u03b4\\u03af\\u03b4\\u03bf-\\u03c3\\u03b8\\u03b1\\u03b9 \\u03b4\\u03b9\\u1f70 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03c6\\u03b7\\u03c4\\u1ff6\\u03bd \\u03bc\\u03b1\\u03b8\\u03cc\\u03bd\\u03c4\\u03b5\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03bb\\u03b7\\u03b8\\u1f72\\u03c2 \\u1f00\\u03c0\\u03bf\\u03c6\\u03b1\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5-\\u03b8\\u03b1 \\u00b7 \\u1f10\\u03c0\\u03b5\\u1f76 \\u03b5\\u1f30 \\u03bc\\u1f74 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03cc \\u1f10\\u03c3\\u03c4\\u03b9\\u03bd, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03ba\\u03b1\\u03b8' \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b3\\u03af\\u03bd\\u03b5\\u03c4\\u03b1\\u03b9, \\u03bf\\u1f50\\u03b4\\u1f72 \\u03c4\\u1f78 \\u1f10\\u03c6' \\u1f21\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Apologia I\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"0b68baff-e316-4734-a491-acb5acdafee3\", \"excerpt\": \"\\u1f4d\\u03b8\\u03b5\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f10\\u03c0\\u03b9\\u03bc\\u03ad\\u03bd\\u03b5\\u03b9 \\u1f41 \\u03b8\\u03b5\\u1f78\\u03c2 \\u03c4\\u1f74\\u03bd \\u03c3\\u03cd\\u03b3\\u03c7\\u03c5\\u03c3\\u03b9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03ba\\u03b1\\u03c4\\u03ac\\u03bb\\u03c5\\u03c3\\u03b9\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03b1\\u03bd\\u03c4\\u1f78\\u03c2 \\u03ba\\u03cc\\u03c3\\u03bc\\u03bf\\u03c5 \\u03bc\\u1f74 \\u03c0\\u03bf\\u03b9\\u1fc6\\u03c3\\u03b1\\u03b9, \\u1f35\\u03bd\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f31 \\u03c6\\u03b1\\u1fe6\\u03bb\\u03bf\\u03b9 \\u1f04\\u03b3\\u03b3\\u03b5\\u03bb\\u03bf\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b1\\u03af\\u03bc\\u03bf\\u03bd\\u03b5\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03b9 \\u03bc\\u03b7\\u03ba\\u03ad\\u03c4\\u03b9 \\u1f66\\u03c3\\u03b9, \\u03b4\\u03b9\\u1f70 \\u03c4\\u1f78 \\u03c3\\u03c0\\u03ad\\u03c1\\u03bc\\u03b1 \\u03c4\\u1ff6\\u03bd \\u03a7\\u03c1\\u03b9\\u03c3\\u03c4\\u03b9\\u03b1\\u03bd\\u1ff6\\u03bd, \\u1f43 \\u03b3\\u03b9\\u03bd\\u03ce\\u03c3\\u03ba\\u03b5\\u03b9 \\u1f10\\u03bd \\u03c4\\u1fc7 \\u03c6\\u03cd\\u03c3\\u03b5\\u03b9 \\u1f45\\u03c4\\u03b9 \\u03b1\\u1f34\\u03c4\\u03b9\\u03cc\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9\\u03bd. \\u1f18\\u03c0\\u03b5\\u1f76 \\u03b5\\u1f30 \\u03bc\\u1f74 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u1f26\\u03bd, \\u03bf\\u1f50\\u03ba \\u1f02\\u03bd \\u03bf\\u1f50 \\u03b4\\u1f72 \\u1f51\\u03bc\\u1fd6\\u03bd \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u1f14\\u03c4\\u03b9 \\u03c0\\u03bf\\u03b9\\u03b5\\u1fd6\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f10\\u03bd\\u03b5\\u03c1\\u03b3\\u03b5\\u1fd6\\u03c3\\u03b8\\u03b1\\u03b9 \\u1f51\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03c6\\u03b1\\u03cd\\u03bb\\u03c9\\u03bd \\u03b4\\u03b1\\u03b9\\u03bc\\u03cc\\u03bd\\u03c9\\u03bd \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u1f78\\u03bd \\u1f26\\u03bd, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03c4\\u1f78 \\u03c0\\u1fe6\\u03c1 \\u03c4\\u1f78 \\u03c4\\u1fc6\\u03c2 \\u03ba\\u03c1\\u03af\\u03c3\\u03b5\\u03c9\\u03c2 \\u03ba\\u03b1\\u03c4\\u03b5\\u03bb\\u03b8\\u1f78\\u03bd \\u1f00\\u03bd\\u03ad\\u03b4\\u03b7\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b4\\u03b9\\u03ad\\u03ba\\u03c1\\u03b9\\u03bd\\u03b5\\u03bd, \\u1f61\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03c1\\u03cc\\u03c4\\u03b5\\u03c1\\u03bf\\u03bd\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Apologia Secunda\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"db157437-31b2-58fa-b9fa-f30b58f4c4af\", \"excerpt\": \"1. \\u1f4d\\u03b8\\u03b5\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f10\\u03c0\\u03b9\\u03bc\\u03ad\\u03bd\\u03b5\\u03b9 \\u1f41 \\u03b8\\u03b5\\u1f78\\u03c2 \\u03c4\\u1f74\\u03bd \\u03c3\\u03cd\\u03b3\\u03c7\\u03c5\\u03c3\\u03b9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03ba\\u03b1\\u03c4\\u03ac\\u03bb\\u03c5\\u03c3\\u03b9\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03b1\\u03bd\\u03c4\\u1f78\\u03c2 \\u03ba\\u03cc\\u03c3\\u03bc\\u03bf\\u03c5 \\u03bc\\u1f74 \\u03c0\\u03bf\\u03b9\\u1fc6\\u03c3\\u03b1\\u03b9, \\u1f35\\u03bd\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f31 \\u03c6\\u03b1\\u1fe6\\u03bb\\u03bf\\u03b9 \\u1f04\\u03b3\\u03b3\\u03b5\\u03bb\\u03bf\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b1\\u03af\\u03bc\\u03bf\\u03bd\\u03b5\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03b9 \\u03bc\\u03b7\\u03ba\\u03ad\\u03c4\\u03b9 \\u1f66\\u03c3\\u03b9, \\u03b4\\u03b9\\u1f70 \\u03c4\\u1f78 \\u03c3\\u03c0\\u03ad\\u03c1\\u03bc\\u03b1 \\u03c4\\u1ff6\\u03bd \\u03a7\\u03c1\\u03b9\\u03c3-\\u03c4\\u03b9\\u03b1\\u03bd\\u1ff6\\u03bd, \\u1f43 \\u03b3\\u03b9\\u03bd\\u03ce\\u03c3\\u03ba\\u03b5\\u03b9 \\u1f10\\u03bd \\u03c4\\u1fc7 \\u03c6\\u03cd\\u03c3\\u03b5\\u03b9, \\u1f45\\u03c4\\u03b9 \\u03b1\\u1f34\\u03c4\\u03b9\\u03cc\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9\\u03bd. 2. \\u1f18\\u03c0\\u03b5\\u1f76 \\u03b5\\u1f30 \\u03bc\\u1f74 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u1f26\\u03bd, \\u03bf\\u1f50\\u03ba \\u1f02\\u03bd \\u03bf\\u1f50\\u03b4\\u1f72 \\u1f51\\u03bc\\u1fd6\\u03bd \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u1f14\\u03c4\\u03b9 \\u03c0\\u03bf\\u03b9\\u03b5\\u1fd6\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f10\\u03bd\\u03b5\\u03c1\\u03b3\\u03b5\\u1fd6\\u03c3-\\u03b8\\u03b1\\u03b9 \\u1f51\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03c6\\u03b1\\u03cd\\u03bb\\u03c9\\u03bd \\u03b4\\u03b1\\u03b9\\u03bc\\u03cc\\u03bd\\u03c9\\u03bd \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u1f78\\u03bd \\u1f26\\u03bd, \\u1f00\\u03bb\\u03bb\\u1f70 | \\u03c4\\u1f78 \\u03c0\\u1fe6\\u03c1 \\u03c4\\u1f78 \\u03c4\\u1fc6\\u03c2 \\u03ba\\u03c1\\u03af\\u03c3\\u03b5\\u03c9\\u03c2 \\u03ba\\u03b1\\u03c4\\u03b5\\u03bb\\u03b8\\u1f78\\u03bd \\u1f00\\u03bd\\u03ad\\u03b4\\u03b7\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b4\\u03b9\\u03ad\\u03ba\\u03c1\\u03b9\\u03bd\\u03b5\\u03bd, \\u1f61\\u03c2 \\u03ba\\u03b1\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Apologia I\"}"}

