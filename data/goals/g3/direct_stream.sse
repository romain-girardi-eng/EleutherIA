data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"980347a7-bcdc-4b36-afa0-6a57c1feb8eb\", \"excerpt\": \"Justin's continuation of the antifatalist argument, providing scriptural proof for free will from Moses and Isaiah. Notable for citing Plato's \\\"\\u03b1\\u1f30\\u03c4\\u03af\\u03b1 \\u1f11\\u03bb\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5, \\u03b8\\u03b5\\u1f78\\u03c2 \\u03b4\\u1fbf \\u1f00\\u03bd\\u03b1\\u03af\\u03c4\\u03b9\\u03bf\\u03c2\\\" (Republic 617e) and claiming Plato borrowed from Moses.\\n\\nGREEK TEXT (verified from database, passage_id: 980347a7-bcdc-4b36-afa0-6a57c1feb8eb):\\n\\u1f18\\u03b4\\u03af\\u03b4\\u03b1\\u03be\\u03b5 \\u03b4\\u1f72 \\u1f21\\u03bc\\u1fb6\\u03c2 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u03c4\\u1f78 \\u1f05\\u03b3\\u03b9\\u03bf\\u03bd \\u03c0\\u03c1\\u03bf\\u03c6\\u03b7\\u03c4\\u03b9\\u03ba\\u1f78\\u03bd \\u03c0\\u03bd\\u03b5\\u1fe6\\u03bc\\u03b1, \\u03b4\\u03b9\\u1f70 \\u039c\\u03c9\\u03cb\\u03c3\\u03ad\\u03c9\\u03c2 \\u03c6\\u1fc6\\u03c3\\u03b1\\u03bd \\u03c4\\u1ff7 \\u03c0\\u03c1\\u03ce\\u03c4\\u1ff3 \\u03c0\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Apologia Prima\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"9c4fdc4f-411d-5505-9a7f-5e7349e14b77\", \"excerpt\": \"**Reference:** Republic X, 617d-e\\n**Author:** Plato\\n**Work:** Republic\\n**Edition:** Burnet (OCT)\\n\\n**Original Greek:**\\n\\u03bf\\u1f50\\u03c7 \\u1f51\\u03bc\\u1fb6\\u03c2 \\u03b4\\u03b1\\u03af\\u03bc\\u03c9\\u03bd \\u03bb\\u03ae\\u03be\\u03b5\\u03c4\\u03b1\\u03b9, \\u1f00\\u03bb\\u03bb' \\u1f51\\u03bc\\u03b5\\u1fd6\\u03c2 \\u03b4\\u03b1\\u03af\\u03bc\\u03bf\\u03bd\\u03b1 \\u03b1\\u1f31\\u03c1\\u03ae\\u03c3\\u03b5\\u03c3\\u03b8\\u03b5. \\u03c0\\u03c1\\u1ff6\\u03c4\\u03bf\\u03c2 \\u03b4' \\u1f41 \\u03bb\\u03b1\\u03c7\\u1f7c\\u03bd \\u03c0\\u03c1\\u1ff6\\u03c4\\u03bf\\u03c2 \\u03b1\\u1f31\\u03c1\\u03b5\\u03af\\u03c3\\u03b8\\u03c9 \\u03b2\\u03af\\u03bf\\u03bd \\u1fa7 \\u03c3\\u03c5\\u03bd\\u03ad\\u03c3\\u03c4\\u03b1\\u03b9 \\u1f10\\u03be \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03c2. \\u1f00\\u03c1\\u03b5\\u03c4\\u1f74 \\u03b4\\u1f72 \\u1f00\\u03b4\\u03ad\\u03c3\\u03c0\\u03bf\\u03c4\\u03bf\\u03bd, \\u1f23\\u03bd \\u03c4\\u03b9\\u03bc\\u1ff6\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f00\\u03c4\\u03b9\\u03bc\\u03ac\\u03b6\\u03c9\\u03bd \\u03c0\\u03bb\\u03ad\\u03bf\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f14\\u03bb\\u03b1\\u03c4\\u03c4\\u03bf\\u03bd \\u03b1\\u1f50\\u03c4\\u1fc6\\u03c2 \\u1f15\\u03ba\\u03b1\\u03c3\\u03c4\\u03bf\\u03c2 \\u1f15\\u03be\\u03b5\\u03b9. \\u03b1\\u1f30\\u03c4\\u03af\\u03b1 \\u1f11\\u03bb\\u03bf\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u00b7 \\u03b8\\u03b5\\u1f78\\u03c2 \\u1f00\\u03bd\\u03b1\\u03af\\u03c4\\u03b9\\u03bf\\u03c2.\\n\\n**English Translation:**\\nA daimon will not be allotte\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Republic\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"c4601d92-d266-511f-b1b8-e2a196962951\", \"excerpt\": \"1. \\u1f18\\u03b4\\u03af\\u03b4\\u03b1\\u03be\\u03b5 \\u03b4\\u1f72 \\u1f21\\u03bc\\u1fb6\\u03c2 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u03c4\\u1f78 \\u1f05\\u03b3\\u03b9\\u03bf\\u03bd \\u03c0\\u03c1\\u03bf\\u03c6\\u03b7\\u03c4\\u03b9\\u03ba\\u1f78\\u03bd \\u03c0\\u03bd\\u03b5\\u1fe6\\u03bc\\u03b1, \\u03b4\\u03b9\\u1f70 \\u039c\\u03c9\\u03c3\\u03ad\\u03c9\\u03c2 \\u03c6\\u1fc6\\u03c3\\u03b1\\u03bd \\u03c4\\u1ff7 \\u03c0\\u03c1\\u03ce\\u03c4\\u1ff3 \\u03c0\\u03bb\\u03b1\\u03c3\\u03b8\\u03ad\\u03bd\\u03c4\\u03b9 \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u1ff3 \\u03b5\\u1f30\\u03c1\\u1fc6\\u03c3\\u03b8\\u03b1\\u03b9 \\u1f51\\u03c0\\u1f78 \\u03c4\\u03bf\\u1fe6 \\u03b8\\u03b5\\u03bf\\u1fe6 \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u00b7 \\u00ab \\u1f38\\u03b4\\u03bf\\u1f7a \\u03c0\\u03c1\\u1f78 \\u03c0\\u03c1\\u03bf\\u03c3\\u03ce\\u03c0\\u03bf\\u03c5 \\u03c3\\u03bf\\u03c5 \\u03c4\\u1f78 \\u1f00\\u03b3\\u03b1\\u03b8\\u1f78\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78 \\u03ba\\u03b1\\u03ba\\u03cc\\u03bd, \\u1f14\\u03ba\\u03bb\\u03b5\\u03be\\u03b1\\u03b9 \\u03c4\\u1f78 \\u1f00\\u03b3\\u03b1\\u03b8\\u03cc\\u03bd. \\u00bb 2. \\u039a\\u03b1\\u1f76 \\u03c0\\u03ac\\u03bb\\u03b9\\u03bd \\u03b4\\u03b9\\u1f70 \\u1f29\\u03c3\\u03b1\\u0390\\u03bf\\u03c5, \\u03c4\\u03bf\\u1fe6 \\u1f11\\u03c4\\u03ad\\u03c1\\u03bf\\u03c5 \\u03c0\\u03c1\\u03bf\\u03c6\\u03ae\\u03c4\\u03bf\\u03c5, \\u1f61\\u03c2 \\u1f00\\u03c0\\u1f78 \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03b1\\u03c4\\u03c1\\u1f78\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f45\\u03bb\\u03c9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b5\\u03c3\\u03c0\\u03cc\\u03c4\\u03bf\\u03c5 \\u03b8\\u03b5\\u03bf\\u1fe6 \\u03b5\\u1f30\\u03c2 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03bb\\u03b5\\u03c7\\u03b8\\u1fc6\\u03bd\\u03b1\\u03b9 \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u00b7 3. \\u00ab \\u039b\\u03bf\\u03cd\\u03c3\\u03b1\\u03c3\\u03b8\\u03b5, | \\u03ba\\u03b1\\u03b8\\u03b1\\u03c1\\u03bf\\u1f76 \\u03b3\\u03ad\\u03bd\\u03b5\\u03c3\\u03b8\\u03b5, \\u1f00\\u03c6\\u03ad\\u03bb\\u03b5\\u03c4\\u03b5 \\u03c4\\u1f70\\u03c2 \\u03c0\\u03bf\\u03bd\\u03b7\\u03c1\\u03af\\u03b1\\u03c2 \\u1f00\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03c8\\u03c5\\u03c7\\u1ff6\\u03bd \\u1f51\\u03bc\\u1ff6\\u03bd, \\u03bc\\u03ac\\u03b8\\u03b5\\u03c4\\u03b5 \\u03ba\\u03b1\\u03bb\\u1f78\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Apologia I\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"b84d1671-6ec1-41ae-94df-b59b694008f9\", \"excerpt\": \"\\u03ba\\u03b1\\u1f76 \\u03c4\\u1f78\\u03bd \\u03bc\\u1f72\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03bc\\u03b5\\u03b3\\u03af\\u03c3\\u03c4\\u03bf\\u03c5 \\u03c0\\u03bf\\u03b9\\u03ba\\u03af\\u03bb\\u03bf\\u03bd, \\u03c4\\u1f78\\u03bd \\u03b4\\u1f72 \\u03c4\\u03bf\\u1fe6 \\u1f11\\u03b2\\u03b4\\u03cc\\u03bc\\u03bf\\u03c5 \\u03bb\\u03b1\\u03bc\\u03c0\\u03c1\\u03cc\\u03c4\\u03b1\\u03c4\\u03bf\\u03bd, \\u03c4\\u1f78\\u03bd \\u03b4\\u1f72 \\u03c4\\u03bf\\u1fe6 \\u1f40\\u03b3\\u03b4\\u03cc\\u03bf\\u03c5 \\u03c4\\u1f78 \\u03c7\\u03c1\\u1ff6\\u03bc\\u03b1 \\u1f00\\u03c0\\u1f78 \\u03c4\\u03bf\\u1fe6 \\u1f11\\u03b2\\u03b4\\u03cc\\u03bc\\u03bf\\u03c5 \\u1f14\\u03c7\\u03b5\\u03b9\\u03bd \\u03c0\\u03c1\\u03bf\\u03c3\\u03bb\\u03ac\\u03bc\\u03c0\\u03bf\\u03bd\\u03c4\\u03bf\\u03c2, \\u03c4\\u1f78\\u03bd \\u03b4\\u1f72 \\u03c4\\u03bf\\u1fe6 \\u03b4\\u03b5\\u03c5\\u03c4\\u03ad\\u03c1\\u03bf\\u03c5 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03ad\\u03bc\\u03c0\\u03c4\\u03bf\\u03c5 \\u03c0\\u03b1\\u03c1\\u03b1\\u03c0\\u03bb\\u03ae\\u03c3\\u03b9\\u03b1 \\u1f00\\u03bb\\u03bb\\u03ae\\u03bb\\u03bf\\u03b9\\u03c2, \\u03be\\u03b1\\u03bd\\u03b8\\u03cc\\u03c4\\u03b5\\u03c1\\u03b1 \\u1f10\\u03ba\\u03b5\\u03af\\u03bd\\u03c9\\u03bd, \\u03c4\\u03c1\\u03af\\u03c4\\u03bf\\u03bd \\u03b4\\u1f72 \\u03bb\\u03b5\\u03c5\\u03ba\\u03cc\\u03c4\\u03b1\\u03c4\\u03bf\\u03bd \\u03c7\\u03c1\\u1ff6\\u03bc\\u03b1 \\u1f14\\u03c7\\u03b5\\u03b9\\u03bd, \\u03c4\\u03ad\\u03c4\\u03b1\\u03c1\\u03c4\\u03bf\\u03bd \\u03b4\\u1f72 \\u1f51\\u03c0\\u03ad\\u03c1\\u03c5\\u03b8\\u03c1\\u03bf\\u03bd, \\u03b4\\u03b5\\u03cd\\u03c4\\u03b5\\u03c1\\u03bf\\u03bd \\u03b4\\u1f72 \\u03bb\\u03b5\\u03c5\\u03ba\\u03cc\\u03c4\\u03b7\\u03c4\\u03b9 \\u03c4\\u1f78\\u03bd \\u1f15\\u03ba\\u03c4\\u03bf\\u03bd. \\u03ba\\u03c5\\u03ba\\u03bb\\u03b5\\u1fd6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03b4\\u1f72 \\u03b4\\u1f74 \\u03c3\\u03c4\\u03c1\\u03b5\\u03c6\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03bd \\u03c4\\u1f78\\u03bd \\u1f04\\u03c4\\u03c1\\u03b1\\u03ba\\u03c4\\u03bf\\u03bd \\u1f45\\u03bb\\u03bf\\u03bd \\u03bc\\u1f72\\u03bd \\u03c4\\u1f74\\u03bd \\u03b1\\u1f50\\u03c4\\u1f74\\u03bd \\u03c6\\u03bf\\u03c1\\u03ac\\u03bd, \\u1f10\\u03bd \\u03b4\\u1f72 \\u03c4\\u1ff7 \\u1f45\\u03bb\\u1ff3 \\u03c0\\u03b5\\u03c1\\u03b9\\u03c6\\u03b5\\u03c1\\u03bf\\u03bc\\u03ad\\u03bd\\u1ff3 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03bc\\u1f72\\u03bd \\u1f10\\u03bd\\u03c4\\u1f78\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Republic (\\u03a0\\u03bf\\u03bb\\u03b9\\u03c4\\u03b5\\u03af\\u03b1)\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"e311f0e8-1149-4a8d-923e-d30893414a99\", \"excerpt\": \"\\u03a4\\u03bf\\u1fe6 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u03c7\\u03c1\\u03b7\\u03c3\\u03c4\\u03b7\\u03c1\\u03af\\u03c9\\u03bd \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03c5 \\u03b4\\u03b9\\u1f70 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03b4\\u03b9\\u03b7\\u03bd\\u03c5\\u03c3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f50\\u03c4\\u03ac\\u03c1\\u03ba\\u03c9\\u03c2 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f00\\u03c0\\u03b5\\u03bb\\u03b7\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5, \\u03ba\\u03b1\\u1f76 \\u03c4\\u1fc6\\u03c2 \\u03b8\\u03b5\\u03af\\u03b1\\u03c2 \\u03b4\\u03c5\\u03bd\\u03ac\\u03bc\\u03b5\\u03c9\\u03c2 \\u03c4\\u03bf\\u1fe6 \\u03c3\\u03c9\\u03c4\\u1fc6\\u03c1\\u03bf\\u03c2 \\u1f21\\u03bc\\u1ff6\\u03bd \\u03b4\\u03b9\\u1f70 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f50\\u03b1\\u03b3\\u03b3\\u03b5\\u03bb\\u03b9\\u03ba\\u1fc6\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03b4\\u03b9\\u03b4\\u03b1\\u03c3\\u03ba\\u03b1\\u03bb\\u03af\\u03b1\\u03c2 \\u03c4\\u1f78 \\u03b8\\u03b5\\u03bf\\u03c0\\u03c1\\u03b5\\u03c0\\u1f72\\u03c2 \\u1f05\\u03bc\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03b2\\u03b9\\u03c9\\u03c6\\u03b5\\u03bb\\u1f72\\u03c2 \\u1f10\\u03c0\\u03b9\\u03b4\\u03b5\\u03b4\\u03b5\\u03b9\\u03b3\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2, \\u1f45\\u03c4\\u03b9 \\u03b4\\u1f74 \\u03b4\\u03b9\\u1f70 \\u03bc\\u03cc\\u03bd\\u03b7\\u03c2 \\u03b1\\u1f50\\u03c4\\u1fc6\\u03c2, \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f50 \\u03b4\\u03b9\\u1fbf \\u1f04\\u03bb\\u03bb\\u03b7\\u03c2, \\u03c4\\u1ff6\\u03bd \\u1f10\\u03be \\u03b1\\u1f30\\u1ff6\\u03bd\\u03bf\\u03c2 \\u03c4\\u1f78\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b2\\u03af\\u03bf\\u03bd \\u1f10\\u03c0\\u03b9\\u03c3\\u03ba\\u03bf\\u03c4\\u03b9\\u03c3\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03bb\\u03c5\\u03bc\\u03b7\\u03bd\\u03b1\\u03bc\\u03ad\\u03b