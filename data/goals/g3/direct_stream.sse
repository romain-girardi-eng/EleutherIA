data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"2431034a-7173-50c2-b156-fb33577c3bf9\", \"excerpt\": \"Stobaeus eclog. I 79, 1 W. \\u03a7\\u03c1\\u03cd\\u03c3\\u03b9\\u03c0\\u03c0\\u03bf\\u03c2 \\u03b4\\u03cd\\u03bd\\u03b1\\u03bc\\u03b9\\u03bd \\u03c0\\u03bd\\u03b5\\u03c5\\u03bc\\u03b1\\u03c4\\u03b9\\u03ba\\u1f74\\u03bd \\u03c4\\u1f74\\u03bd \\u03bf\\u1f50\\u03c3\\u03af\\u03b1\\u03bd \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2, \\u03c4\\u03ac\\u03be\\u03b5\\u03b9 \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03b1\\u03bd\\u03c4\\u1f78\\u03c2 \\u03b4\\u03b9\\u03bf\\u03b9\\u03ba\\u03c4\\u03b9\\u03ba\\u03ae\\u03bd. \\u03a4\\u03bf\\u1fe6\\u03c4\\u03bf \\u03bc\\u1f72\\u03bd \\u03bf\\u1f56\\u03bd \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03b4\\u03b5\\u03c5\\u03c4\\u03ad\\u03c1\\u1ff3 \\u03a0\\u03b5\\u03c1\\u1f76 \\u039a\\u03cc\\u03c3\\u03bc\\u03bf\\u03c5. \\u1f18\\u03bd \\u03b4\\u1f72 \\u03c4\\u1ff7 \\u03b4\\u03b5\\u03c5\\u03c4\\u03ad\\u03c1\\u1ff3 \\u03a0\\u03b5\\u03c1\\u1f76 \\u1f4d\\u03c1\\u03c9\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f10\\u03bd \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03a0\\u03b5\\u03c1\\u1f76 \\u03a4\\u1fc6\\u03c2 \\u0395\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f10\\u03bd \\u1f04\\u03bb\\u03bb\\u03bf\\u03b9\\u03c2 \\u03c3\\u03c0\\u03bf\\u03c1\\u03ac\\u03b4\\u03b7\\u03bd \\u03c0\\u03bf\\u03bb\\u03c5\\u03c4\\u03c1\\u03cc\\u03c0\\u03c9\\u03c2 \\u1f00\\u03c0\\u03bf\\u03c6\\u03b1\\u03af\\u03bd\\u03b5\\u03c4\\u03b1\\u03b9 \\u03bb\\u03ad\\u03b3\\u03c9\\u03bd\\u00b7 \\u0395\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03b7 \\u1f10\\u03c3\\u03c4\\u1f76\\u03bd \\u1f41 \\u03c4\\u03bf\\u1fe6 \\u03ba\\u03cc\\u03c3\\u03bc\\u03bf\\u03c5 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c2 \\u1f22 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03bd \\u03c4\\u1ff6 \\u03ba\\u03cc\\u03c3\\u03bc\\u1ff3 \\u03c0\\u03c1\\u03bf\\u03bd\\u03bf\\u03af\\u1fb3 \\u03b4\\u03b9\\u03bf\\u03b9\\u03ba\\u03bf\\u03c5\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u1f22 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c2 \\u03ba\\u03b1\\u03b8\\u2019 \\u1f43\\u03bd \\u03c4\\u1f70 \\u03bc\\u1f72\\u03bd \\u03b3\\u03b5\\u03b3\\u03bf\\u03bd\\u03cc\\u03c4\\u03b1 \\u03b3\\u03ad\\u03b3\\u03bf\\u03bd\\u03b5, \\u03c4\\u1f70 \\u03b4\\u1f72 \\u03b3\\u03b9\\u03bd\\u03cc\\u03bc\\u03b5\\u03bd\\u03b1 \", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Stoicorum Veterum Fragmenta II \\u2014 Fragmenta Logica et Physica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"917881b7-0221-40cf-a2dc-ced76e17dc30\", \"excerpt\": \"\\u1f00\\u03bb\\u03bb\\u1f70 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03ac \\u03b3\\u03b5 \\u03b5\\u1f30 \\u03bc\\u1f72\\u03bd \\u1f51\\u03c0\\u03cc \\u03c4\\u03b9\\u03bd\\u03c9\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03c9\\u03bd \\u03c0\\u03b5\\u03c1\\u03b9\\u03b5\\u03c3\\u03c4\\u03ce\\u03c4\\u03c9\\u03bd \\u03b1\\u1f50\\u03c4\\u03bf\\u1fd6\\u03c2 \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03ac\\u03b6\\u03bf\\u03bd\\u03c4\\u03b1\\u03b9 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd, \\u03c3\\u03c5\\u03b3\\u03b3\\u03b9\\u03bd\\u03ce\\u03c3\\u03ba\\u03b5\\u03b9\\u03bd \\u03b1\\u1f50\\u03c4\\u03bf\\u1fd6\\u03c2 \\u1f04\\u03be\\u03b9\\u03bf\\u03bd, \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f50\\u03b4\\u1f72\\u03bd \\u03b4\\u03b5\\u1fd6 \\u03bf\\u1f54\\u03b8\\u2019 \\u1f21\\u03bc\\u1fb6\\u03c2 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u1f51\\u03c0\\u2019 \\u1f10\\u03ba\\u03b5\\u03af\\u03bd\\u03c9\\u03bd \\u03ba\\u03b1\\u03c4\\u2019 \\u1f00\\u03bd\\u03ac\\u03b3\\u03ba\\u03b7\\u03bd \\u03bb\\u03b5\\u03b3\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c0\\u03bf\\u03bb\\u03c5\\u03c0\\u03c1\\u03b1\\u03b3\\u03bc\\u03bf\\u03bd\\u03b5\\u1fd6\\u03bd \\u03bf\\u1f54\\u03c4\\u03b5 \\u1f10\\u03ba\\u03b5\\u03af\\u03bd\\u03bf\\u03c5\\u03c2 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u03bf\\u1f50\\u03c7 \\u1f41\\u03bc\\u03bf\\u03af\\u03c9\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fd6\\u03c2 \\u03bb\\u03b5\\u03b3\\u03cc\\u03bd\\u03c4\\u03c9\\u03bd (\\u1f11\\u03ba\\u03ac\\u03c3\\u03c4\\u03bf\\u03b9\\u03c2 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1ff6\\u03bd \\u03bb\\u03b5\\u03b3\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03bf\\u03be\\u03b1\\u03b6\\u03bf\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03b1 \\u1f21 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03b5\\u03c1\\u03b9\\u03b5\\u03c3\\u03c4\\u03ce\\u03c4\\u03c9\\u03bd \\u03b4\\u03cd\\u03bd\\u03b1\\u03bc\\u03b9\\u03c2), \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f50\\u03b4\\u1f72\\u03bd \\u03b4\\u03b5\\u1fd6 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03bb\\u03ad\\u03b3\\u03bf\\u03bd\\u03c4\\u03b1\\u03c2 \\u03b1\\u1f30\\u03c4\\u03b9\\u1fb6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03bf\\u1f50\\u03b4\\u1f72\\u03bd \\u03b5\\u1f30\\u03c2 \\u03c4\\u1f78 \\u03bf\\u1f55\\u03c4\\u03c9\\u03c2 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd \\u03c3\\u03c5\\u03bd\\u03c4\\u03b5\\u03bb\\u03bf\\u1fe6\\u03bd\\u03c4\\u03b1\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Fato\"}"}

