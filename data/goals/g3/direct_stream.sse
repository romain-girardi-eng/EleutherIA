data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"e311f0e8-1149-4a8d-923e-d30893414a99\", \"excerpt\": \"\\u03a4\\u03bf\\u1fe6 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u03c7\\u03c1\\u03b7\\u03c3\\u03c4\\u03b7\\u03c1\\u03af\\u03c9\\u03bd \\u03c4\\u03c1\\u03cc\\u03c0\\u03bf\\u03c5 \\u03b4\\u03b9\\u1f70 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03c1\\u03bf\\u03b4\\u03b9\\u03b7\\u03bd\\u03c5\\u03c3\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b1\\u1f50\\u03c4\\u03ac\\u03c1\\u03ba\\u03c9\\u03c2 \\u1f21\\u03bc\\u1fd6\\u03bd \\u1f00\\u03c0\\u03b5\\u03bb\\u03b7\\u03bb\\u03b5\\u03b3\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5, \\u03ba\\u03b1\\u1f76 \\u03c4\\u1fc6\\u03c2 \\u03b8\\u03b5\\u03af\\u03b1\\u03c2 \\u03b4\\u03c5\\u03bd\\u03ac\\u03bc\\u03b5\\u03c9\\u03c2 \\u03c4\\u03bf\\u1fe6 \\u03c3\\u03c9\\u03c4\\u1fc6\\u03c1\\u03bf\\u03c2 \\u1f21\\u03bc\\u1ff6\\u03bd \\u03b4\\u03b9\\u1f70 \\u03c4\\u1fc6\\u03c2 \\u03b5\\u1f50\\u03b1\\u03b3\\u03b3\\u03b5\\u03bb\\u03b9\\u03ba\\u1fc6\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03b4\\u03b9\\u03b4\\u03b1\\u03c3\\u03ba\\u03b1\\u03bb\\u03af\\u03b1\\u03c2 \\u03c4\\u1f78 \\u03b8\\u03b5\\u03bf\\u03c0\\u03c1\\u03b5\\u03c0\\u1f72\\u03c2 \\u1f05\\u03bc\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03b2\\u03b9\\u03c9\\u03c6\\u03b5\\u03bb\\u1f72\\u03c2 \\u1f10\\u03c0\\u03b9\\u03b4\\u03b5\\u03b4\\u03b5\\u03b9\\u03b3\\u03bc\\u03ad\\u03bd\\u03b7\\u03c2, \\u1f45\\u03c4\\u03b9 \\u03b4\\u1f74 \\u03b4\\u03b9\\u1f70 \\u03bc\\u03cc\\u03bd\\u03b7\\u03c2 \\u03b1\\u1f50\\u03c4\\u1fc6\\u03c2, \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f50 \\u03b4\\u03b9\\u1fbf \\u1f04\\u03bb\\u03bb\\u03b7\\u03c2, \\u03c4\\u1ff6\\u03bd \\u1f10\\u03be \\u03b1\\u1f30\\u1ff6\\u03bd\\u03bf\\u03c2 \\u03c4\\u1f78\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b2\\u03af\\u03bf\\u03bd \\u1f10\\u03c0\\u03b9\\u03c3\\u03ba\\u03bf\\u03c4\\u03b9\\u03c3\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03b5 \\u03ba\\u03b1\\u1f76 \\u03bb\\u03c5\\u03bc\\u03b7\\u03bd\\u03b1\\u03bc\\u03ad\\u03bd\\u03c9\\u03bd \\u03b4\\u03b1\\u03b9\\u03bc\\u03bf\\u03bd\\u03b9\\u03ba\\u1ff6\\u03bd \\u03c6\\u03b1\\u03bd\\u03c4\\u03b1\\u03c3\\u03bc\\u03ac\\u03c4\\u03c9\\u03bd \\u1f10\\u03bb\\u03b5\\u03c5\\u03b8\\u03b5\\u03c1\\u03af\\u03b1 \\u03c0\\u1fb6\\u03c3\\u03b9\\u03bd \\u1f51\\u03c0\\u1fc6\\u03c1\\u03c7\\u03b5\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03bf\\u03b9\\u03c2, \\u03c6\\u03ad\\u03c1\\u03b5 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03c0\\u03b5\\u03c1\\u1f76 \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Praeparatio Evangelica\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"a36c2d9d-9306-4b6f-979a-b8922f7e5d04\", \"excerpt\": \"Tatian's foundational statement on creation and self-determination. Both angels and humans were made \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03bd (self-determining) by the Logos, capable of good or evil by their own free choice.\\n\\nGREEK TEXT 7a (verified, passage_id: a36c2d9d-9306-4b6f-979a-b8922f7e5d04):\\n\\u039b\\u03cc\\u03b3\\u03bf\\u03c2 \\u03b3\\u1f70\\u03c1 \\u1f41 \\u1f10\\u03c0\\u03bf\\u03c5\\u03c1\\u03ac\\u03bd\\u03b9\\u03bf\\u03c2, \\u03c0\\u03bd\\u03b5\\u1fe6\\u03bc\\u03b1 \\u03b3\\u03b5\\u03b3\\u03bf\\u03bd\\u1f7c\\u03c2 \\u1f00\\u03c0\\u1f78 \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03b1\\u03c4\\u03c1\\u1f78\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c2 \\u1f10\\u03ba \\u03c4\\u1fc6\\u03c2 \\u03bb\\u03bf\\u03b3\\u03b9\\u03ba\\u1fc6\\u03c2 \\u03b4\\u03c5\\u03bd\\u03ac\\u03bc\\u03b5\\u03c9\\u03c2, \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c4\\u1f74\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03b3\\u03b5\\u03bd\\u03bd\\u03ae\\u03c3\\u03b1\\u03bd\\u03c4\\u03bf\\u03c2 \\u03b1\\u1f50\\u03c4\\u1f78\\u03bd \\u03c0\\u03b1\\u03c4\\u03c1\\u1f78\\u03c2 \", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Oratio ad Graecos\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"a343b50a-6de2-55be-b2d7-80e1c89133e5\", \"excerpt\": \"<\\u03a0\\u0395\\u03a1\\u0399 \\u0391\\u03a1\\u03a7\\u03a9\\u039d \\u03a4\\u039f\\u039c\\u039f\\u03a3 \\u03a4\\u03a1\\u0399\\u03a4\\u039f\\u03a3>\\u03b1\\u02b9. \\u03a0\\u03b5\\u03c1\\u1f76 \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03c5\\u03c3\\u03af\\u03bf\\u03c5, \\u03ba\\u03b1\\u1f76 \\u03c4\\u1ff6\\u03bd \\u03b4\\u03bf\\u03ba\\u03bf\\u03cd\\u03bd\\u03c4\\u03c9\\u03bd \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u1f00\\u03bd\\u03b1\\u03b9\\u03c1\\u03b5\\u1fd6\\u03bd\\u1fe5\\u03b7\\u03c4\\u1ff6\\u03bd \\u03b3\\u03c1\\u03b1\\u03c6\\u03b9\\u03ba\\u1ff6\\u03bd \\u03bb\\u03cd\\u03c3\\u03b9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f11\\u03c1\\u03bc\\u03b7\\u03bd\\u03b5\\u03af\\u03b11. \\u1f18\\u03c0\\u03b5\\u1f76 \\u03b4\\u1f72 \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03ba\\u03b7\\u03c1\\u03cd\\u03b3\\u03bc\\u03b1\\u03c4\\u03b9 \\u03c4\\u1ff7 \\u1f10\\u03ba\\u03ba\\u03bb\\u03b7\\u03c3\\u03b9\\u03b1\\u03c3\\u03c4\\u03b9\\u03ba\\u1ff7 \\u03c0\\u03b5\\u03c1\\u03b9\\u03ad\\u03c7\\u03b5\\u03c4\\u03b1\\u03b9\\u1f41 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03ba\\u03c1\\u03af\\u03c3\\u03b5\\u03c9\\u03c2 \\u03b4\\u03b9\\u03ba\\u03b1\\u03af\\u03b1\\u03c2 \\u03b8\\u03b5\\u03bf\\u1fe6 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c2, \\u1f45\\u03c3\\u03c4\\u03b9\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u1f00\\u03ba\\u03bf\\u03cd\\u03bf\\u03bd\\u03c4\\u03b1\\u03c2,\\u03c0\\u03b9\\u03c3\\u03c4\\u03b5\\u03c5\\u03b8\\u03b5\\u1f76\\u03c2 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u1f00\\u03bb\\u03b7\\u03b8\\u03ae\\u03c2, \\u03c0\\u03c1\\u03bf\\u03ba\\u03b1\\u03bb\\u03b5\\u1fd6\\u03c4\\u03b1\\u03b9 \\u1f10\\u03c0\\u1f76 \\u03c4\\u1f78 \\u03ba\\u03b1\\u03bb\\u1ff6\\u03c2 \\u03b2\\u03b9\\u03bf\\u1fe6\\u03bd\\u03ba\\u03b1\\u1f76 \\u03c0\\u03b1\\u03bd\\u03c4\\u1f76 \\u03c4\\u03c1\\u03cc\\u03c0\\u1ff3 \\u03c6\\u03b5\\u03cd\\u03b3\\u03b5\\u03b9\\u03bd \\u03c4\\u1f74\\u03bd \\u1f01\\u03bc\\u03b1\\u03c1\\u03c4\\u03af\\u03b1\\u03bd, \\u03b4\\u03b7\\u03bb\\u03bf\\u03bd\\u03cc\\u03c4\\u03b9 \\u03c3\\u03c5\\u03b3\\u03ba\\u03b1\\u03c4\\u03b1-\\u03c4\\u03b9\\u03b8\\u03b5\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u03c4\\u1f78 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u1f70 \\u1f10\\u03c0\\u03b1\\u03af\\u03bd\\u03bf\\u03c5 \\u03ba\\u03b1\\u1f76 \\u03c8\\u03cc\\u03b3\\u03bf\\u03c5 \\u1f04\\u03be\\u03b9\\u03b1,\\u03c6\\u03ad\\u03c1\\u03b5 \\u03ba\\u03b1\\u1f76 \", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Principiis (Peri Archon)\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"f8ceab87-f393-4ca6-aceb-e28dd1346abe\", \"excerpt\": \"Tatian's \\\"paradox of free will\\\": self-determination (\\u03c4\\u1f78 \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03bd) was the cause of our downfall, yet we who destroyed ourselves can also restore ourselves. A profound statement on human responsibility.\\n\\nGREEK TEXT 11a (verified, passage_id: f8ceab87-f393-4ca6-aceb-e28dd1346abe):\\n\\u03a0\\u1ff6\\u03c2 \\u03bf\\u1f56\\u03bd \\u03b3\\u03ad\\u03bd\\u03b5\\u03c3\\u03b9\\u03bd \\u03c4\\u1f74\\u03bd \\u03ba\\u03b1\\u03b8\\u1fbf \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u1f00\\u03c0\\u03bf\\u03b4\\u03ad\\u03be\\u03bf\\u03bc\\u03b1\\u03b9, \\u03c4\\u03bf\\u03b9\\u03bf\\u03cd\\u03c4\\u03bf\\u03c5\\u03c2 \\u03b1\\u1f50\\u03c4\\u1fc6\\u03c2 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03bf\\u1f30\\u03ba\\u03bf\\u03bd\\u03cc\\u03bc\\u03bf\\u03c5\\u03c2 \\u03b8\\u03b5\\u03c9\\u03c1\\u1ff6\\u03bd; \\u0392\\u03b1\\u03c3\\u03b9\\u03bb\\u03b5\\u03cd\\u03b5\\u03b9\\u03bd \\u03bf\\u1f50 \\u03b8\\u03ad\\u03bb\\u03c9, \\u03c0\\u03bb\\u03bf\\u03c5\\u03c4\\u03b5\\u1fd6\\u03bd \", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Oratio ad Graecos\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"aed97e25-98dd-4935-9ec7-80c5dc348ce7\", \"excerpt\": \"**Reference:** De Fato 14\\n**Author:** Alexander of Aphrodisias\\n**Work:** De Fato\\n**Edition:** Bruns (CAG Suppl. II.2)\\n\\n**Original Greek:**\\n\\u1f14\\u03bd\\u03b5\\u03c3\\u03c4\\u03b9 \\u03b4' \\u1f41\\u03c1\\u1fb6\\u03bd, \\u03b5\\u1f30 \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u03bb\\u03ad\\u03b3\\u03bf\\u03bd\\u03c4\\u03b5\\u03c2 \\u03c3\\u03ce\\u03b6\\u03bf\\u03c5\\u03c3\\u03b9\\u03bd \\u03c4\\u1f70\\u03c2 \\u03ba\\u03bf\\u03b9\\u03bd\\u1f70\\u03c2 \\u03c0\\u03b5\\u03c1\\u1f76 \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd \\u03c0\\u03c1\\u03bf\\u03bb\\u03ae\\u03c8\\u03b5\\u03b9\\u03c2. \\u03bf\\u1f31 \\u03b3\\u1f70\\u03c1 \\u1f00\\u03c0\\u03b1\\u03b9\\u03c4\\u03bf\\u1fe6\\u03bd\\u03c4\\u03b5\\u03c2 \\u03b1\\u1f50\\u03c4\\u03bf\\u03cd\\u03c2, \\u03c0\\u1ff6\\u03c2 \\u03bf\\u1f37\\u03cc\\u03bd \\u03c4\\u03b5 \\u03c0\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u1f44\\u03bd\\u03c4\\u03c9\\u03bd \\u03ba\\u03b1\\u03b8' \\u03b5\\u1f31\\u03bc\\u03b1\\u03c1\\u03bc\\u03ad\\u03bd\\u03b7\\u03bd \\u03c4\\u1f78 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c3\\u03ce\\u03b6\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u03bf\\u1f50\\u03ba \\u1f44\\u03bd\\u03bf\\u03bc\\u03b1 \\u03bc\\u03cc\\u03bd\\u03bf\\u03bd \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c6' \\u1f21\\u03bc\\u1fd6\\u03bd \\u03c4\\u03b9\\u03b8\\u03ad\\u03bd\\u03c4\\u03b5\\u03c2 \\u03c4\\u03bf\\u1fe6\\u03c4' \\u1f00\\u03c0\\u03b1\\u03b9\\u03c4\\u03bf\\u1fe6\\u03c3\\u03b9\\u03bd, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03ba\\u03b1\\u1f76 \\u03c3\\u03b7\\u03bc\\u03b1\\u03b9\\u03bd\\u03cc\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"De Fato\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"7b029b3b-d680-4362-a0ea-8ef4b2aef215\", \"excerpt\": \"Justin's key statement on divine creation of self-determining beings, explaining how God made both angels and humans with \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03bd (self-determination) for the purpose of righteous action.\\n\\nGREEK TEXT (verified from database, passage_id: 7b029b3b-d680-4362-a0ea-8ef4b2aef215):\\n\\u1f08\\u03bb\\u03bb\\u1fbf, \\u1f61\\u03c2 \\u1f10\\u03b3\\u03af\\u03bd\\u03c9\\u03c3\\u03ba\\u03b5 \\u03ba\\u03b1\\u03bb\\u1f78\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03b3\\u03b5\\u03bd\\u03ad\\u03c3\\u03b8\\u03b1\\u03b9, \\u1f10\\u03c0\\u03bf\\u03af\\u03b7\\u03c3\\u03b5\\u03bd \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03c5\\u03c3\\u03af\\u03bf\\u03c5\\u03c2 \\u03c0\\u03c1\\u1f78\\u03c2 \\u03b4\\u03b9\\u03ba\\u03b1\\u03b9\\u03bf\\u03c0\\u03c1\\u03b1\\u03be\\u03af\\u03b1\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f00\\u03b3\\u03b3\\u03ad\\u03bb\\u03bf\\u03c5\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03bf\\u03c5\\u03c2, \\u03ba\\u03b1\\u1f76 \\u03c7\\u03c1\\u03cc\\u03bd\\u03bf\\u03c5\\u03c2\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Dialogus cum Tryphone\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"264e75f4-d79b-5483-b5f5-591f912a42de\", \"excerpt\": \"Greek: \\u2022 \\u03ba\\u03b5\\u1fd6 \\u03b4\\u03ad \\u03c3\\u03bf\\u03b9 \\u1f21 \\u1f10\\u03bb\\u03b5\\u03c5\\u03b8\\u03b5\\u03c1\\u03af\\u03b1 \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03cd\\u03c3\\u03b9\\u03cc\\u03bd \\u03c4\\u03b9 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03b1\\u1f50\\u03c4\\u03bf\\u03b4\\u03ad\\u03c3\\u03c0\\u03bf\\u03c4\\u03bf\\u03bd - freedom seems to you something self-ruling and self-mastering\\n\\u2022 \\u1f45\\u03bd\\u03c4\\u03b9\\u03bd\\u03b1 \\u03bf\\u1f56\\u03bd \\u1f14\\u03c3\\u03c4\\u03b9 \\u03bb\\u1fe6\\u03c3\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u1f00\\u03bd\\u03b1\\u03b3\\u03ba\\u03ac\\u03c3\\u03b1\\u03b9 - whomever it is possible to unbind and to force\\n\\u2022 \\u03b8\\u03b1\\u03c1\\u03c1\\u1ff6\\u03bd \\u03bb\\u03ad\\u03b3\\u03b5 \\u03bc\\u1f74 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u1f10\\u03bb\\u03b5\\u03cd\\u03b8\\u03b5\\u03c1\\u03bf\\u03bd - say boldly he is not free\\n\\u2022 \\u03bc\\u03b9\\u03ba\\u03c1\\u03bf\\u03b4\\u03bf\\u03cd\\u03bb\\u03bf\\u03c5\\u03c2 - petty slaves\\n\\nFreedom (\\u1f10\\u03bb\\u03b5\\u03c5\\u03b8\\u03b5\\u03c1\\u03af\\u03b1) means being \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03bd (self-ruling) and \\u03b1\\u1f50\\u03c4\\u03bf\\u03b4\\u03ad\\u03c3\\u03c0\\u03bf\\u03c4\\u03bf\\u03bd (self-master\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Discourses\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"60635166-3d8d-57e3-96c8-e7e85ab7537d\", \"excerpt\": \"Tatian's foundational statement on creation and self-determination. Both angels and humans were made (self-determining) by the Logos, capable of good or evil by their own free choice.\\n\\n\\\"The heavenly Logos, having become spirit from the Father and word from rational power, made humanity in imitation of the Father who begot him, an image of immortality [...] Both forms of creation became self-determ\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Oration to the Greeks (\\u039b\\u03cc\\u03b3\\u03bf\\u03c2 \\u03c0\\u03c1\\u1f78\\u03c2 \\u1f1d\\u03bb\\u03bb\\u03b7\\u03bd\\u03b1\\u03c2)\"}"}

