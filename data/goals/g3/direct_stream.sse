data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"b95dc60b-6493-4f7d-a7ea-8c357968bd86\", \"excerpt\": \"\\u0395\\u1f30 \\u03b3\\u1f70\\u03c1 \\u1f41 \\u03c5\\u1f31\\u1f78\\u03c2 \\u03c4\\u03bf\\u1fe6 \\u03b8\\u03b5\\u03bf\\u1fe6 \\u03c6\\u03b1\\u03af\\u03bd\\u03b5\\u03c4\\u03b1\\u03b9 \\u03bc\\u03ae \\u03c4\\u03b5 \\u03b4\\u03b9\\u1f70 \\u03c4\\u1f78 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c5\\u1f31\\u1f78\\u03c2 \\u03bc\\u03ae \\u03c4\\u03b5 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c4\\u1f78 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u1f30\\u03c3\\u03c7\\u03c5\\u03c1\\u1f78\\u03c2 \\u03bc\\u03ae \\u03c4\\u03b5 \\u03b4\\u03b9\\u1f70 \\u03c4\\u1f78 \\u03c3\\u03bf\\u03c6\\u1f78\\u03c2 \\u03bb\\u03ad\\u03b3\\u03c9\\u03bd \\u03b4\\u03cd\\u03bd\\u03b1\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c3\\u03ce\\u03b6\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03c0\\u03c1\\u1f78\\u03c2 \\u03c4\\u1f78 \\u1f00\\u03bd\\u03b1\\u03bc\\u03ac\\u03c1\\u03c4\\u03b7\\u03c4\\u03bf\\u03c2 \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9, \\u1f61\\u03c2 \\u1f29\\u03c3\\u03b1\\u03af\\u03b1\\u03c2 \\u03c6\\u03b7\\u03c3\\u03af\\u03bd, \\u03bc\\u03b7 \\u03b4\\u1f72 \\u03bc\\u03ad\\u03c7\\u03c1\\u03b9 \\u03c6\\u03c9\\u03bd\\u1fc6\\u03c2 \\u1f21\\u03bc\\u03b1\\u03c1\\u03c4\\u03b7\\u03ba\\u03ad\\u03bd\\u03b1\\u03b9 \\u03b1\\u1f50\\u03c4\\u03cc\\u03bd, \\u1f00\\u03bd\\u03bf\\u03bc\\u03af\\u03b1\\u03bd \\u03b3\\u1f70\\u03c1 [fol. 156] \\u03bf\\u1f50\\u03ba \\u1f10\\u03c0\\u03bf\\u03af\\u03b7\\u03c3\\u03b5\\u03bd \\u03bf\\u1f50 \\u03b4\\u1f72 \\u03b4\\u03cc\\u03bb\\u03bf\\u03bd \\u03c4\\u1ff7 \\u03c3\\u03c4\\u03cc\\u03bc\\u03b1\\u03c4\\u03b9 [Is., LIII, 9], \\u1f04\\u03bd\\u03b5\\u03c5 \\u03c4\\u03bf\\u1fe6 \\u03b8\\u03b5\\u03bf\\u1fe6 \\u03c3\\u03c9\\u03b8\\u03ae\\u03c3\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03bc\\u1f74 \\u03b4\\u03cd\\u03bd\\u03b1\\u03c3\\u03b8\\u03b1\\u03b9, \\u03c0\\u1ff6\\u03c2 \\u1f51\\u03bc\\u03b5\\u1fd6\\u03c2 \\u1f22 \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f31 \\u1f04\\u03bb\\u03bb\\u03bf\\u03b9 \\u03bf\\u1f31 \\u1f04\\u03bd\\u03b5\\u03c5 \\u03c4\\u1fc6\\u03c2 \\u1f10\\u03bb\\u03c0\\u03af\\u03b4\\u03bf\\u03c2 \\u03c4\\u03b1\\u03cd\\u03c4\\u03b7\\u03c2 \\u03c3\\u03c9\\u03b8\\u03ae\\u03c3\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c0\\u03c1\\u03bf\\u03c3\\u03b4\\u03bf\\u03ba\\u1ff6\\u03bd\\u03c4\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"Dialogus cum Tryphone\"}"}

