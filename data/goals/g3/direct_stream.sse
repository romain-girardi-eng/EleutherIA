data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"0b68baff-e316-4734-a491-acb5acdafee3\", \"excerpt\": \"\\u1f4d\\u03b8\\u03b5\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f10\\u03c0\\u03b9\\u03bc\\u03ad\\u03bd\\u03b5\\u03b9 \\u1f41 \\u03b8\\u03b5\\u1f78\\u03c2 \\u03c4\\u1f74\\u03bd \\u03c3\\u03cd\\u03b3\\u03c7\\u03c5\\u03c3\\u03b9\\u03bd \\u03ba\\u03b1\\u1f76 \\u03ba\\u03b1\\u03c4\\u03ac\\u03bb\\u03c5\\u03c3\\u03b9\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03b1\\u03bd\\u03c4\\u1f78\\u03c2 \\u03ba\\u03cc\\u03c3\\u03bc\\u03bf\\u03c5 \\u03bc\\u1f74 \\u03c0\\u03bf\\u03b9\\u1fc6\\u03c3\\u03b1\\u03b9, \\u1f35\\u03bd\\u03b1 \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f31 \\u03c6\\u03b1\\u1fe6\\u03bb\\u03bf\\u03b9 \\u1f04\\u03b3\\u03b3\\u03b5\\u03bb\\u03bf\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b1\\u03af\\u03bc\\u03bf\\u03bd\\u03b5\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f04\\u03bd\\u03b8\\u03c1\\u03c9\\u03c0\\u03bf\\u03b9 \\u03bc\\u03b7\\u03ba\\u03ad\\u03c4\\u03b9 \\u1f66\\u03c3\\u03b9, \\u03b4\\u03b9\\u1f70 \\u03c4\\u1f78 \\u03c3\\u03c0\\u03ad\\u03c1\\u03bc\\u03b1 \\u03c4\\u1ff6\\u03bd \\u03a7\\u03c1\\u03b9\\u03c3\\u03c4\\u03b9\\u03b1\\u03bd\\u1ff6\\u03bd, \\u1f43 \\u03b3\\u03b9\\u03bd\\u03ce\\u03c3\\u03ba\\u03b5\\u03b9 \\u1f10\\u03bd \\u03c4\\u1fc7 \\u03c6\\u03cd\\u03c3\\u03b5\\u03b9 \\u1f45\\u03c4\\u03b9 \\u03b1\\u1f34\\u03c4\\u03b9\\u03cc\\u03bd \\u1f10\\u03c3\\u03c4\\u03b9\\u03bd. \\u1f18\\u03c0\\u03b5\\u1f76 \\u03b5\\u1f30 \\u03bc\\u1f74 \\u03c4\\u03bf\\u1fe6\\u03c4\\u03bf \\u1f26\\u03bd, \\u03bf\\u1f50\\u03ba \\u1f02\\u03bd \\u03bf\\u1f50 \\u03b4\\u1f72 \\u1f51\\u03bc\\u1fd6\\u03bd \\u03c4\\u03b1\\u1fe6\\u03c4\\u03b1 \\u1f14\\u03c4\\u03b9 \\u03c0\\u03bf\\u03b9\\u03b5\\u1fd6\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f10\\u03bd\\u03b5\\u03c1\\u03b3\\u03b5\\u1fd6\\u03c3\\u03b8\\u03b1\\u03b9 \\u1f51\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03c6\\u03b1\\u03cd\\u03bb\\u03c9\\u03bd \\u03b4\\u03b1\\u03b9\\u03bc\\u03cc\\u03bd\\u03c9\\u03bd \\u03b4\\u03c5\\u03bd\\u03b1\\u03c4\\u1f78\\u03bd \\u1f26\\u03bd, \\u1f00\\u03bb\\u03bb\\u1f70 \\u03c4\\u1f78 \\u03c0\\u1fe6\\u03c1 \\u03c4\\u1f78 \\u03c4\\u1fc6\\u03c2 \\u03ba\\u03c1\\u03af\\u03c3\\u03b5\\u03c9\\u03c2 \\u03ba\\u03b1\\u03c4\\u03b5\\u03bb\\u03b8\\u1f78\\u03bd \\u1f00\\u03bd\\u03ad\\u03b4\\u03b7\\u03bd \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03b4\\u03b9\\u03ad\\u03ba\\u03c1\\u03b9\\u03bd\\u03b5\\u03bd, \\u1f61\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03c1\\u03cc\\u03c4\\u03b5\\u03c1\\u03bf\\u03bd\", \"node_ids\": [], \"confidence\": 0.85, \"work_label\": \"Apologia Secunda\"}"}

data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"aca055fb-10a9-4295-9d36-91eb462fa899\", \"excerpt\": \"\\u039a\\u03b1\\u1f76 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u1f00\\u03c0\\u1f78 \\u03c4\\u1ff6\\u03bd \\u03a3\\u03c4\\u03c9\\u03ca\\u03ba\\u1ff6\\u03bd \\u03b4\\u1f72 \\u03b4\\u03bf\\u03b3\\u03bc\\u03ac\\u03c4\\u03c9\\u03bd, \\u1f10\\u03c0\\u03b5\\u03b9\\u03b4\\u1f74 \\u03ba \\u1f02\\u03bd \\u03c4\\u1f78\\u03bd \\u1f20\\u03b8\\u03b9\\u03ba\\u1f78\\u03bd \\u03bb\\u03cc\\u03b3\\u03bf\\u03bd \\u03ba\\u03cc\\u03c3\\u03bc\\u03b9\\u03bf\\u03b9 \\u03b3\\u03b5\\u03b3\\u03cc\\u03bd\\u03b1\\u03c3\\u03b9\\u03bd, \\u1f61\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f14\\u03bd \\u03c4\\u03b9\\u03c3\\u03b9\\u03bd \\u03c3\\u03b9\\u1ffe \\u03c0\\u03bf\\u03b9\\u03b7\\u03c4\\u03b1\\u03af, \\u03b4\\u03b9\\u1f70 \\u03c4\\u1f78 \\u1f14\\u03bc\\u03c6\\u03c5\\u03c4\\u03bf\\u03bd \\u03c0\\u03b1\\u03bd\\u03c4\\u1f76 \\u03b3\\u03ad\\u03bd\\u03b5\\u03b9 \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd \\u03c3\\u03c0\\u03ad\\u03c1\\u03bc\\u03b1 \\u03c4\\u03bf\\u1fe6 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c5, \\u03bc\\u03b5\\u03bc\\u03b9\\u03c3\\u1fc6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u03b1\\u1f76 \\u03c0\\u03b5\\u03c6\\u03bf\\u03bd\\u03b5\\u1fe6\\u03c3\\u03b8\\u03b1\\u03b9 \\u03bf\\u1f34\\u03b4\\u03b1\\u03bc\\u03b5\\u03bd\\u00b7 \\u1f29\\u03c1\\u03ac\\u03ba\\u03bb\\u03b5\\u03b9\\u03c4\\u03bf\\u03bd \\u03bc\\u03ad\\u03bd, \\u1f61\\u03c2 \\u03c0\\u03c1\\u03bf\\u03ad\\u03c6\\u03b7\\u03bc\\u03b5\\u03bd, \\u03ba\\u03b1\\u1f76 \\u039c\\u03bf\\u03c5\\u03c3\\u03ce\\u03bd\\u03b9\\u03bf\\u03bd \\u03b4\\u1f72 \\u1f10\\u03bd \\u03c4\\u03bf\\u1fd6\\u03c2 \\u03ba\\u03b1\\u03b8\\u1fbf \\u1f21\\u03bc\\u1fb6\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f04\\u03bb\\u03bb\\u03bf\\u03c5\\u03c2 \\u03bf\\u1f34\\u03b4\\u03b1\\u03bc\\u03b5\\u03bd. \\u1f69\\u03c2 \\u03b3\\u1f70\\u03c1 \\u1f10\\u03c3\\u03b7\\u03bc\\u03ac\\u03bd\\u03b1\\u03bc\\u03b5\\u03bd, \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1\\u03c2 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03ba \\u1f02\\u03bd \\u1f41\\u03c0\\u03c9\\u03c3\\u03b4\\u03ae\\u03c0\\u03bf\\u03c4\\u03b5 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03bb\\u03cc\\u03b3\\u03bf\\u03bd \\u03b2\\u03b9\\u03bf\\u1fe6\\u03bd \\u03c3\\u03c0\\u03bf\\u03c5\\u03b4\\u03ac\\u03b6\\u03bf\\u03bd\\u03c4\\u03b1\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03ba\\u03b1\\u03ba\\u03af\\u03b1\\u03bd \\u03c6\\u03b5\\u03cd\\u03b3\\u03b5\\u03b9\\u03bd \\u03bc\\u03b9\\u03c3\\u03b5\\u1fd6\\u03c3\\u03b8\\u03b1\\u03b9 \\u1f00\\u03b5\\u1f76 \", \"node_ids\": [], \"confidence\": 0.85, \"work_label\": \"Apologia Secunda\"}"}

