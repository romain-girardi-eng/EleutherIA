data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"ffcdc298-14dc-4439-adb1-60342164f18a\", \"excerpt\": \"\\u039a\\u03b1\\u1f76 \\u03c4\\u03cc \\u03c4\\u03b5 \\u1f18\\u03be\\u03b7\\u03c1\\u03ac\\u03bd\\u03b8\\u03b7 \\u1f61\\u03c2 \\u1f44\\u03c3\\u03c4\\u03b1\\u03b1\\u03ba\\u03bf\\u03bd \\u1f21 \\u1f30\\u03c3\\u03c7\\u03cd\\u03c2 \\u03bc\\u03bf\\u03c5, \\u03ba\\u03b1\\u1f76 \\u1f21 \\u03b3\\u03bb\\u1ff6\\u03c3\\u03c3\\u03ac \\u03bc\\u03bf\\u03c5 \\u03ba\\u03b5\\u03ba\\u03cc\\u03bb\\u03bb\\u03b7\\u03c4\\u03b1\\u03b9 \\u03c4\\u1ff7 \\u03bb\\u03ac\\u03c1\\u03c5\\u03b3\\u03b3\\u03af \\u03bc\\u03bf\\u03c5, \\u1f41\\u03bc\\u03bf\\u03af\\u03c9\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f51\\u03c0\\u1fbf \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03bc\\u03b5\\u03bb\\u03bb\\u03cc\\u03bd\\u03c4\\u03c9\\u03bd \\u03b3\\u03af\\u03bd\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03ba\\u03b1\\u03c4\\u1f70 \\u03c4\\u1f78 \\u03c4\\u03bf\\u1fe6 \\u03c0\\u03b1\\u03c4\\u03c1\\u1f78\\u03c2 \\u03b8\\u03ad\\u03bb\\u03b7\\u03bc\\u03b1 \\u03c0\\u03c1\\u03bf\\u03b1\\u03b3\\u03b3\\u03b5\\u03bb\\u03af\\u03b1 \\u1f26\\u03bd. \\u1f29 \\u03b3\\u1f70\\u03c1 \\u03c4\\u03bf\\u1fe6 \\u1f30\\u03c3\\u03c7\\u03c5\\u03c1\\u03bf\\u1fe6 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c5 \\u03b4\\u03cd\\u03bd\\u03b1\\u03bc\\u03b9\\u03c2, \\u03b4\\u03b9\\u1fbf \\u1f26\\u03c2 [fol. 155] \\u1f00\\u03b5\\u1f76 \\u1f24\\u03bb\\u03b5\\u03b3\\u03c7\\u03b5 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03c3\\u03c5\\u03b6\\u03b7\\u03c4\\u03bf\\u1fe6\\u03bd\\u03c4\\u03b1\\u03c2 \\u03b1\\u1f50\\u03c4\\u1ff7 \\u03a6\\u03b1\\u03c1\\u03b9\\u03c3\\u03b1\\u03af\\u03bf\\u03c5\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03b3\\u03c1\\u03b1\\u03bc\\u03bc\\u03b1\\u03c4\\u03b5\\u1fd6\\u03c2 \\u03ba\\u03b1\\u1f76 \\u1f01\\u03c0\\u03bb\\u1ff6\\u03c2 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03b3\\u03ad\\u03bd\\u03b5\\u03b9 \\u1f51\\u03bc\\u1ff6\\u03bd \\u03b4\\u03b9\\u03b4\\u03b1\\u03c3\\u03ba\\u03ac\\u03bb\\u03bf\\u03c5\\u03c2, \\u1f10\\u03c0\\u03bf\\u03c7\\u1f74\\u03bd \\u1f14\\u03c3\\u03c7\\u03b5 \\u03b4\\u03af\\u03ba\\u03b7\\u03bd \\u03c0\\u03bf\\u03bb\\u03c5\\u03b0\\u03b4\\u03c1\\u03bf\\u03c5 \\u03ba\\u03b1\\u1f76 \\u1f30\\u03c3\\u03c7\\u03c5\\u03c1\\u1fb6\\u03c2 \\u03c0\\u03b7\\u03b3\\u1fc6\\u03c2, \\u1f26\\u03c2 \\u03c4\\u1f78 \\u1f55\\u03b4\\u03c9\\u03c1 \\u1f00\\u03c0\\u03b5\\u03c3\\u03c4\\u03c1\\u03ac\\u03c6\\u03b7, \\u03c3\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"Dialogus cum Tryphone\"}"}

