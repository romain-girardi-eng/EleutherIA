data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"9a8ffeae-8eab-445f-9475-5071fc3590f4\", \"excerpt\": \"Justin's extended argument distinguishing divine foreknowledge from causal necessity. Crucial for understanding how early Christians navigated the prescience-free will problem.\\n\\nGREEK TEXT 140.4 (verified, passage_id: 9a8ffeae-8eab-445f-9475-5071fc3590f4):\\n\\u1f08\\u03bb\\u03bb\\u1f70 \\u03ba\\u03b1\\u1f76 \\u1f45\\u03c4\\u03b9 \\u03bf\\u1f50\\u03ba \\u03b1\\u1f30\\u03c4\\u03af\\u1fb3 \\u03c4\\u03bf\\u1fe6 \\u03b8\\u03b5\\u03bf\\u1fe6 \\u03bf\\u1f31 \\u03c0\\u03c1\\u03bf\\u03b3\\u03b9\\u03bd\\u03c9\\u03c3\\u03ba\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03b9 \\u1f00\\u03c3\\u03b5\\u03b2\\u03b5\\u1fd6\\u03c2...\\n\\nGREEK TEXT 141.1 (verified, passage_id: 1cda1b29-a1e3-41e7-9ca2-1bb2cb593899):\\n\\u03b2\", \"node_ids\": [], \"confidence\": 0.7, \"work_label\": \"Dialogus cum Tryphone\"}"}

