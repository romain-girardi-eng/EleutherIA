data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"12a2f31f-aaf4-4ed3-a929-cce986c7fb43\", \"excerpt\": \"\\u03a4\\u1f70 \\u03b4\\u1f72 \\u1f11\\u03be\\u1fc6\\u03c2 \\u03b5\\u1f30\\u03c1\\u03b7\\u03bc\\u03ad\\u03bd\\u03b1 \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03c8\\u03b1\\u03bb\\u03bc\\u1ff7\\u00b7 \\u1f4d\\u03c4\\u03b9 \\u03b8\\u03bb\\u1fd6\\u03c8\\u03b9\\u03c2 \\u1f10\\u03b3\\u03b3\\u03cd\\u03c2, \\u1f45\\u03c4\\u03b9 \\u03bf\\u1f50\\u03ba \\u1f14\\u03c3\\u03c4\\u03b9\\u03bd \\u1f41 \\u03b2\\u03bf\\u03b7\\u03b8\\u1ff6\\u03bd \\u03bc\\u03bf\\u03b9. \\u03a0\\u03b5\\u03c1\\u03b9\\u03b5\\u03ba\\u03cd\\u03ba\\u03bb\\u03c9\\u03c3\\u03ac\\u03bd \\u03bc\\u03b5 \\u03bc\\u03cc\\u03c3\\u03c7\\u03bf\\u03b9 \\u03c0\\u03bf\\u03bb\\u03bb\\u03bf\\u03af, \\u03c4\\u03b1\\u1fe6\\u03c1\\u03bf\\u03b9 \\u03c0\\u03af\\u03bf\\u03bd\\u03b5\\u03c2 \\u03c0\\u03b5\\u03c1\\u03b9\\u03ad\\u03c3\\u03c7\\u03bf\\u03bd \\u03bc\\u03b5\\u00b7 \\u1f24\\u03bd\\u03bf\\u03b9\\u03be\\u03b1\\u03bd \\u1f10\\u03c0\\u1fbf \\u1f10\\u03bc\\u1f72 \\u03c4\\u1f78 \\u03c3\\u03c4\\u03cc\\u03bc\\u03b1 \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd \\u1f61\\u03c2 \\u03bb\\u03ad\\u03c9\\u03bd \\u1f01\\u03c1\\u03c0\\u03ac\\u03b6\\u03c9\\u03bd \\u03ba\\u03b1\\u1f76 \\u1f60\\u03c1\\u03c5\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03c2\\u00b7 \\u1f61\\u03c3\\u03b5\\u1f76 \\u1f55\\u03b4\\u03c9\\u03c1 \\u1f10\\u03be\\u03b5\\u03c7\\u03cd\\u03b8\\u03b7 \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b9\\u03b5\\u03c3\\u03ba\\u03bf\\u03c1\\u03c0\\u03af\\u03c3\\u03b8\\u03b7 \\u03c0\\u03ac\\u03bd\\u03c4\\u03b1 \\u03c4\\u1f70 \\u1f40\\u03c3\\u03c4\\u1fb6 \\u03bc\\u03bf\\u03c5 [Ps., XXI, 11 &#45; 15]\\u00b7 \\u03c4\\u1ff6\\u03bd \\u1f41\\u03bc\\u03bf\\u03af\\u03c9\\u03c2 \\u03b1\\u1f50\\u03c4\\u1ff7 \\u03c3\\u03c5\\u03bc\\u03b2\\u03ac\\u03bd\\u03c4\\u03c9\\u03bd \\u03c0\\u03c1\\u03bf\\u03b1\\u03b3\\u03b3\\u03b5\\u03bb\\u03af\\u03b1 \\u1f26\\u03bd. \\u1f18\\u03ba\\u03b5\\u03af\\u03bd\\u03b7\\u03c2 \\u03b3\\u1f70\\u03c1 \\u03c4\\u1fc6\\u03c2 \\u03bd\\u03c5\\u03ba\\u03c4\\u03cc\\u03c2 [cf. MT., XXVI, 30], \\u1f45\\u03c4\\u03b5 \\u1f10\\u03c0\\u1f76 \\u03c4\\u1f78 \\u1f44\\u03c1\\u03bf\\u03c2 \\u03c4\\u1ff6\\u03bd \\u1f10\\u03bb\\u03b1\\u03b9\\u1ff6\\u03bd \\u1f10\\u03c0\\u1fc6\\u03bb\\u03b8\\u03bf\\u03bd \\u03b1\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"Dialogus cum Tryphone\"}"}

