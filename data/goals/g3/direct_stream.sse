data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"1cda1b29-a1e3-41e7-9ca2-1bb2cb593899\", \"excerpt\": \"\\u1f3d\\u03bd\\u03b1 \\u03b4\\u1f72 \\u03bc\\u1f74 \\u03c0\\u03c1\\u03cc\\u03c6\\u03b1\\u03c3\\u03b9\\u03bd \\u1f14\\u03c7\\u03b7\\u03c4\\u03b5 \\u03bb\\u03ad\\u03b3\\u03b5\\u03b9\\u03bd \\u1f45\\u03c4\\u03b9 \\u1f14\\u03b4\\u03b5\\u03b9 \\u03c4\\u1f78\\u03bd \\u03a7\\u03c1\\u03b9\\u03c3\\u03c4\\u1f78\\u03bd \\u03c3\\u03c4\\u03b1\\u03c5\\u03c1\\u03c9\\u03b8\\u1fc6\\u03bd\\u03b1\\u03b9, \\u1f22 \\u03ba\\u03b1\\u1f76 \\u1f10\\u03bd \\u03c4\\u1ff7 \\u03b3\\u03ad\\u03bd\\u03b5\\u03b9 \\u1f51\\u03bc\\u1ff6\\u03bd \\u03b5\\u1f36\\u03bd\\u03b1\\u03b9 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u03c0\\u03b1\\u03c1\\u03b1\\u03b2\\u03b1\\u03af\\u03bd\\u03bf\\u03bd\\u03c4\\u03b1\\u03c2, \\u03ba\\u03b1\\u1f76 \\u03bf\\u1f50\\u03ba \\u1f02\\u03bd \\u1f04\\u03bb\\u03bb\\u03c9\\u03c2 \\u1f10\\u03b4\\u03cd\\u03bd\\u03b1\\u03c4\\u03bf \\u03b3\\u03b5\\u03bd\\u03ad\\u03c3\\u03b8\\u03b1\\u03b9, \\u03c6\\u03b8\\u03ac\\u03c3\\u03b1\\u03c2 \\u03b4\\u03b9\\u1f70 \\u03b2\\u03c1\\u03b1\\u03c7\\u03ad\\u03c9\\u03bd \\u03b5\\u1f36\\u03c0\\u03bf\\u03bd, \\u1f45\\u03c4\\u03b9 \\u03b2\\u03bf\\u03c5\\u03bb\\u03cc\\u03bc\\u03b5\\u03bd\\u03bf\\u03c2 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u1f00\\u03b3\\u03b3\\u03ad\\u03bb\\u03bf\\u03c5\\u03c2 \\u03ba\\u03b1\\u1f76 \\u03c4\\u03bf\\u1f7a\\u03c2 \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03bf\\u03c5\\u03c2 \\u1f15\\u03c0\\u03b5\\u03c3\\u03b8\\u03b1\\u03b9 \\u03c4\\u1fc7 \\u03b2\\u03bf\\u03c5\\u03bb\\u1fc7 \\u03b1\\u1f50\\u03c4\\u03bf\\u1fe6 \\u1f41 \\u03b8\\u03b5\\u1f78\\u03c2 \\u1f10\\u03b2\\u03bf\\u03c5\\u03bb\\u03ae\\u03b8\\u03b7 \\u03c0\\u03bf\\u03b9\\u1fc6\\u03c3\\u03b1\\u03b9 \\u03c4\\u03bf\\u03cd\\u03c4\\u03bf\\u03c5\\u03c2 \\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03c5\\u03c3\\u03af\\u03bf\\u03c5\\u03c2 \\u03c0\\u03c1\\u1f78\\u03c2 \\u03b4\\u03b9\\u03ba\\u03b1\\u03b9\\u03bf\\u03c0\\u03c1\\u03b1\\u03be\\u03af\\u03b1\\u03bd. \\u03bc\\u03b5\\u03c4\\u1f70 \\u03bb\\u03cc\\u03b3\\u03bf\\u03c5 \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c0\\u03af\\u03c3\\u03c4\\u03b1\\u03c3\\u03b8\\u03b1\\u03b9 \\u03b1\\u1f50\\u03c4\\u03bf\\u1f7a\\u03c2 \\u1f50\\u03c6\\u1fbf \\u03bf\\u1f57 \\u03b3\\u03b5\\u03b3\\u03cc\\u03bd\\u03b1\\u03c3\\u03b9, \\u03ba\\u03b1\\u1f76 \\u03b4\\u03b9\\u1fbf \\u1f45\\u03bd \\u03b5\\u1f30\\u03c3\\u03b9 \\u03c0\\u03c1\\u03cc\\u03c4\\u03b5\\u03c1\\u03bf\\u03bd \\u03bf\\u1f50\\u03ba \\u1f44\\u03bd\\u03c4\\u03b5\\u03c2, \\u03ba\\u03b1\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"Dialogus cum Tryphone\"}"}

