data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"ad0049c4-8fa3-417c-9f02-42a98b0a862f\", \"excerpt\": \"Justin's argument for free will in the context of baptism and original sin. Both angels and humans were made self-determining (\\u03b1\\u1f50\\u03c4\\u03b5\\u03be\\u03bf\\u03cd\\u03c3\\u03b9\\u03bf\\u03b9) with free choice (\\u1f10\\u03bb\\u03b5\\u03c5\\u03b8\\u03ad\\u03c1\\u03b1 \\u03c0\\u03c1\\u03bf\\u03b1\\u03af\\u03c1\\u03b5\\u03c3\\u03b9\\u03c2).\\n\\nGREEK TEXT 88.4 (verified, passage_id: efbba9af-d8c6-440e-b4dd-d1486b98c0b1):\\n\\u1f43 \\u1f00\\u03c0\\u1f78 \\u03c4\\u03bf\\u1fe6 \\u1f08\\u03b4\\u1f70\\u03bc \\u1f51\\u03c0\\u1f78 \\u03b8\\u03ac\\u03bd\\u03b1\\u03c4\\u03bf\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c0\\u03bb\\u03ac\\u03bd\\u03b7\\u03bd \\u03c4\\u1f74\\u03bd \\u03c4\\u03bf\\u1fe6 \\u1f44\\u03c6\\u03b5\\u03c9\\u03c2 \\u1f10\\u03c0\\u03b5\\u03c0\\u03c4\\u03ce\\u03ba\\u03b5\\u03b9, \\u03c0\\u03b1\\u03c1\\u1f70 \\u03c4\\u1f74\\u03bd \\u1f30\\u03b4\\u03af\\u03b1\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd \\u1f11\\u03ba\\u03ac\\u03c3\\u03c4\\u03bf\\u03c5 \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd \\u03c0\\u03bf\\u03bd\\u03b7\\u03c1\\u03b5\\u03c5\\u03c3\\u03b1\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5.\\n\\nGREEK TEXT 88.5 (verified\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"Dialogus cum Tryphone\"}"}

