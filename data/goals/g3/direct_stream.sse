data: {"type": "answer_chunk", "data": "{\"type\": \"citation_found\", \"passage_id\": \"efbba9af-d8c6-440e-b4dd-d1486b98c0b1\", \"excerpt\": \"\\u039a\\u03b1\\u1f76 \\u03bf\\u1f50\\u03c7 \\u1f61\\u03c2 \\u1f10\\u03bd\\u03b4\\u03b5\\u1fb6 \\u03b1\\u1f50\\u03c4\\u1f78\\u03bd \\u03c4\\u03bf\\u1fe6 \\u03b2\\u03b1\\u03c0\\u03c4\\u03b9\\u03c3\\u03b8\\u1fc6\\u03bd\\u03b1\\u03b9 \\u1f22 \\u03c4\\u03bf\\u1fe6 \\u1f10\\u03c0\\u03b5\\u03bb\\u03b8\\u03cc\\u03bd\\u03c4\\u03bf\\u03c2 \\u1f10\\u03bd \\u03b5\\u1f34\\u03b4\\u03b5\\u03b9 \\u03c0\\u03b5\\u03c1\\u03b9\\u03c3\\u03c4\\u03b5\\u03c1\\u1fb6\\u03c2 \\u03c0\\u03bd\\u03b5\\u03cd\\u03bc\\u03b1\\u03c4\\u03bf\\u03c2 \\u03bf\\u1f34\\u03b4\\u03b1\\u03bc\\u03b5\\u03bd \\u03b1\\u1f50\\u03c4\\u1f78\\u03bd \\u1f10\\u03bb\\u03b7\\u03bb\\u03c5\\u03b8\\u03ad\\u03bd\\u03b1\\u03b9 \\u1f10\\u03c0\\u1f76 \\u03c4\\u1f78\\u03bd \\u03c0\\u03bf\\u03c4\\u03b1\\u03bc\\u03cc\\u03bd, \\u1f65\\u03c3\\u03c0\\u03b5\\u03c1 \\u03bf\\u1f50 \\u03b4\\u1f72 \\u03c4\\u1f78 \\u03b3\\u03b5\\u03bd\\u03bd\\u03b7\\u03b8\\u1fc6\\u03bd\\u03b1\\u03b9 \\u03b1\\u1f50\\u03c4\\u1f78\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c3\\u03c4\\u03b1\\u03c5\\u03c1\\u03c9\\u03b8\\u1fc6\\u03bd\\u03b1\\u03b9 \\u1f61\\u03c2 \\u1f10\\u03bd\\u03b4\\u03b5\\u1f74\\u03c2 \\u03c4\\u03bf\\u03cd\\u03c4\\u03c9\\u03bd \\u1f51\\u03c0\\u03ad\\u03bc\\u03b5\\u03b9\\u03bd\\u03b5\\u03bd, \\u1f00\\u03bb\\u03bb\\u1fbf \\u1f51\\u03c0\\u1f72\\u03c1 \\u03c4\\u03bf\\u1fe6 \\u03b3\\u03ad\\u03bd\\u03bf\\u03c5\\u03c2 \\u03c4\\u03bf\\u1fe6 \\u03c4\\u1ff6\\u03bd \\u1f00\\u03bd\\u03b8\\u03c1\\u03ce\\u03c0\\u03c9\\u03bd, \\u1f43 \\u1f00\\u03c0\\u1f78 \\u03c4\\u03bf\\u1fe6 \\u1f08\\u03b4\\u1f70\\u03bc \\u1f51\\u03c0\\u1f78 \\u03b8\\u03ac\\u03bd\\u03b1\\u03c4\\u03bf\\u03bd \\u03ba\\u03b1\\u1f76 \\u03c0\\u03bb\\u03ac\\u03bd\\u03b7\\u03bd \\u03c4\\u1f74\\u03bd \\u03c4\\u03bf\\u1fe6 \\u1f44\\u03c6\\u03b5\\u03c9\\u03c2 \\u1f10\\u03c0\\u03b5\\u03c0\\u03c4\\u03ce\\u03ba\\u03b5\\u03b9, \\u03c0\\u03b1\\u03c1\\u1f70 \\u03c4\\u1f74\\u03bd \\u1f30\\u03b4\\u03af\\u03b1\\u03bd \\u03b1\\u1f30\\u03c4\\u03af\\u03b1\\u03bd \\u1f11\\u03ba\\u03ac\\u03c3\\u03c4\\u03bf\\u03c5 \\u03b1\\u1f50\\u03c4\\u1ff6\\u03bd \\u03c0\\u03bf\\u03bd\\u03b7\\u03c1\\u03b5\\u03c5\\u03c3\\u03b1\\u03bc\\u03ad\\u03bd\\u03bf\\u03c5.\", \"node_ids\": [], \"confidence\": 1.0, \"work_label\": \"Dialogus cum Tryphone\"}"}

