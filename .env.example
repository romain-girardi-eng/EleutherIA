# EleutherIA Environment Configuration — Local Development
# Copy this file to .env and fill in your values.
# For production (Supabase + Qdrant Cloud), see deploy/production/.env.example

# =============================================================================
# DATABASE (local Docker PostgreSQL — no DATABASE_URL needed)
# =============================================================================
# The deploy/docker-compose.yml passes POSTGRES_* vars directly to the backend.
# Set DATABASE_URL only if connecting to an external database:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Connection pool settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# =============================================================================
# VECTOR DATABASE (Qdrant)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional for local development

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================
# Preferred provider: kimi, openrouter, or gemini
LLM_PREFERRED_PROVIDER=kimi

# Kimi K2 Thinking (recommended - 256k context, advanced reasoning)
# Get key at: https://platform.moonshot.ai
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# OpenRouter (alternative - multi-model access)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini (fallback)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# =============================================================================
# MONITORING (optional)
# =============================================================================
# Sentry error tracking
SENTRY_DSN=

# Prometheus metrics
PROMETHEUS_ENABLED=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# FRONTEND
# =============================================================================
VITE_API_URL=http://localhost:8000
