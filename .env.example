# EleutherIA Environment Configuration — Local Development
# Copy this file to .env and fill in your values.
# For production deployment notes see deploy/production/README.md

# =============================================================================
# DATABASE (local Docker PostgreSQL — no DATABASE_URL needed)
# =============================================================================
# The deploy/docker-compose.yml passes POSTGRES_* vars directly to the backend.
# Set DATABASE_URL only if connecting to an external database:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# If PostgreSQL is unavailable, GraphRAG can use the committed KG snapshot.
DATABASE_REQUIRED=false
ELEUTHERIA_KG_SNAPSHOT_DIR=data/kg
# Optional maintenance DSN used by database/scripts/bootstrap_supabase.py.
# Prefer a Supabase direct/session-pooler URL for schema + data imports.
# Do not commit a real value; use shell/CI secrets for bootstrap only.
# SUPABASE_DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require

# Connection pool settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================
# Preferred provider: codex (primary), claude, gemini
LLM_PREFERRED_PROVIDER=codex

# Codex proxy — gpt-5.6-sol (PRIMARY, synthesis tier)
# OpenAI-compatible CLI-subscription proxy on the prod docker network.
CODEX_PROXY_BASE_URL=http://cli-proxy-api:8317/v1
CODEX_PROXY_API_KEY=
CODEX_MODEL=gpt-5.6-sol
# Utility tier — cheap internal subtasks (lemma expansion, planning,
# query classification, citation verification).
CODEX_LIGHT_MODEL=gpt-5.6-terra
# Synthesis-tier reasoning budget: low | medium | high
CODEX_REASONING_EFFORT=high
# Answer-budget floor for synthesis-tier Codex calls. Reasoning tokens bill
# against max_tokens, so a small cap can end with finish_reason=length and an
# empty answer; synthesis payloads are raised to at least this value.
CODEX_SYNTHESIS_MAX_TOKENS=32000
# Usable context window (prompt + answer share it on this backend). Measured
# through the production proxy at ~207,000 tokens — the Codex subscription's
# hard cap; 200,000 keeps a safety margin. Oversized prompts skip this rung.
CODEX_MAX_INPUT_TOKENS=200000

# Claude proxy — claude-opus-5 (FALLBACK)
# Same OpenAI-compatible shape, second CLI-subscription proxy.
CLAUDE_PROXY_BASE_URL=http://pragma-claude-proxy:8318/v1
CLAUDE_PROXY_API_KEY=
CLAUDE_PROXY_MODEL=claude-opus-5
CLAUDE_PROXY_LIGHT_MODEL=claude-sonnet-5
# Usable context window — measured at 1,000,000 tokens.
CLAUDE_MAX_INPUT_TOKENS=1000000

# Gemini (LAST RESORT) — two possible backends.
#
# 1. PREFERRED: the OpenAI-compatible CLI-subscription proxy. Setting
#    GEMINI_PROXY_BASE_URL switches the whole Gemini rung to /v1/chat/completions
#    with a bearer key (same shape as the Codex and Claude proxies: streaming,
#    tool calling and JSON mode all reuse the same code paths). No paid AI Studio
#    key involved, and GEMINI_API_KEY is then ignored for this rung.
GEMINI_PROXY_BASE_URL=http://pragma-gemini-proxy:8320/v1
GEMINI_PROXY_API_KEY=
# 2. FALLBACK: leave GEMINI_PROXY_BASE_URL empty to keep the native
#    generativelanguage API on a PAID key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Synthesis-tier model. Must be an id the CONFIGURED backend serves:
# gemini-3.1-pro-low through the proxy, gemini-3.1-pro-preview natively.
GEMINI_MODEL=gemini-3.1-pro-low
# Utility-tier model (cheap internal subtasks, relevance triage). Unset on the
# native backend means the pro model serves both tiers.
GEMINI_LIGHT_MODEL=gemini-3.7-flash-high
# Usable context window — measured at 1,000,000 tokens.
GEMINI_MAX_INPUT_TOKENS=1000000

# =============================================================================
# SCHOLARLY PIPELINE (effective state is exposed by GET /api/graphrag/health)
# =============================================================================
# Master debate-first retrieval/controversy-map/synthesis cutover. Default: off.
ELEUTHERIA_SCHOLAR_RAG=false
# Post-synthesis referee + at most one local revision. Default: off.
ELEUTHERIA_REFEREE=false
# Utility-model relevance ordering before prompt fitting. Default: off.
ELEUTHERIA_RELEVANCE_TRIAGE=false
# Deterministic graph seed before the first ReAct turn (strategy seeds +
# weighted traversal + linked passages). Default: on. Budget in ms (50-30000).
ELEUTHERIA_GRAPH_SEED=true
ELEUTHERIA_GRAPH_SEED_BUDGET_MS=2000

# Dialectical synthesis routing. Blank reasoning effort inherits the provider's
# synthesis setting (CODEX_REASONING_EFFORT for the primary Codex rung).
SCHOLAR_SYNTHESIS_MODEL=gpt-5.6-sol
SCHOLAR_SYNTHESIS_REASONING_EFFORT=
# Blank values preserve per-tier defaults: tool calls 12/24/45 and render caps
# 9000/12000/14000 for quick/standard/deep.
ELEUTHERIA_SCHOLAR_MAX_TOOL_CALLS=
ELEUTHERIA_SCHOLAR_RENDER_MAX_TOKENS=
ELEUTHERIA_SCHOLAR_SYNTHESIS_TIMEOUT=360
ELEUTHERIA_SCHOLAR_CONTESTED_BUDGET=18

# Relevance-triage utility model and bounds. Blank model = utility-tier routing.
ELEUTHERIA_TRIAGE_MODEL=
ELEUTHERIA_TRIAGE_TIMEOUT=25
ELEUTHERIA_TRIAGE_MAX_ITEMS=4800

# Referee/revision bounds.
ELEUTHERIA_REFEREE_TIMEOUT=90
ELEUTHERIA_REVISION_TIMEOUT=240
ELEUTHERIA_REFEREE_MAP_TOKENS=30000

# Synthesis prompt ceiling and complexity-tier caps.
ELEUTHERIA_SYNTH_CONTEXT_TOKENS=1000000
ELEUTHERIA_SYNTH_CONTEXT_TOKENS_QUICK=120000
ELEUTHERIA_SYNTH_CONTEXT_TOKENS_STANDARD=250000

# =============================================================================
# AUTHENTICATION
# =============================================================================
# REQUIRED — no default. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The backend refuses to start on a placeholder or a secret shorter than 32 chars.
JWT_SECRET_KEY=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# --- Passwordless email login (OTP) ---
# Allowlist: only these emails may receive a login code, verify one, or hold a
# session. Comma-separated. This is the single control that grants access.
AUTHORIZED_EMAILS=romain-girardi@hotmail.fr
# Login-code lifetime (minutes) and resend cooldown (seconds)
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_RESEND_COOLDOWN=60

# Email delivery for login codes — configure ONE provider (else codes only log).
# 1) Resend (recommended):
RESEND_API_KEY=
EMAIL_FROM=EleutherIA <no-reply@free-will.app>
# 2) SMTP (alternative to Resend):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# =============================================================================
# MONITORING (optional)
# =============================================================================
# Sentry error tracking
SENTRY_DSN=

# Prometheus metrics
PROMETHEUS_ENABLED=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# opencode proxy (/api/opencode/*)
# =============================================================================
# Upstream opencode runtime — `opencode serve`. The backend injects HTTP Basic
# credentials so OPENCODE_SERVER_PASSWORD never reaches the browser.
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Per-request timeout (seconds) for non-SSE proxy calls; SSE streams are
# long-lived and ignore this value.
OPENCODE_PROXY_TIMEOUT=1800
# Optional dedicated secret for signing short-lived SSE tokens. Falls back to
# JWT_SECRET_KEY when unset.
OPENCODE_SESSION_SECRET=

# =============================================================================
# CLI
# =============================================================================
# Used by cli/main.py to target the API gateway. Falls back to localhost:8000.
ELEUTHERIA_API_URL=http://localhost:8000

# =============================================================================
# SEMANTIC PUBLICATION
# =============================================================================
# Local Fuseki profile serves the generated Turtle dump at this endpoint.
# Generate first with `make kg-rdf`, then start with `make sparql`.
SPARQL_ENDPOINT=http://localhost:3030/eleutheria/sparql
FUSEKI_PORT=3030
FUSEKI_ADMIN_PASSWORD=eleutheria
FUSEKI_JVM_ARGS=-Xmx2g

# =============================================================================
# FRONTEND
# =============================================================================
VITE_API_URL=http://localhost:8000

# =============================================================================
# Snapshot upload to Supabase Storage
# =============================================================================
# Where the KG snapshot files (nodes.jsonl, edges.jsonl, stats.json) are
# mirrored. Defaults to SUPABASE_URL / SUPABASE_SERVICE_KEY when these
# are unset.
ELEUTHERIA_SUPABASE_STORAGE_URL=
ELEUTHERIA_SUPABASE_STORAGE_KEY=
KG_SNAPSHOT_BUCKET=kg-snapshots

# =============================================================================
# Security — LLM endpoint throttling + draft submission
# =============================================================================
# Per-IP sliding-window rate limit on the LLM-invoking endpoints
# (/query, /query/stream, /answer, /compare, reverify). Localhost is exempt.
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_MAX=5
LLM_RATE_LIMIT_WINDOW=60

# Process-wide cap on LLM requests in flight, across all callers. Requests
# arriving with no free slot are rejected with 503 instead of queued.
LLM_MAX_CONCURRENCY=4

# Shared secret required by POST /api/graphrag/query/draft (thesis export
# cache). Leave unset to keep the endpoint disabled.
GRAPHRAG_DRAFT_SUBMIT_TOKEN=

# Shared secret required by POST /api/kg/reload (in-memory snapshot refresh
# after a KG deploy). Leave unset to keep the endpoint disabled.
KG_RELOAD_TOKEN=

# Enforce the quote verifier: answers whose Greek/Latin quotations cannot be
# matched against the corpus are rejected rather than merely reported.
ELEUTHERIA_TEXT_VERIFIER_ENFORCE=true
