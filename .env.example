# EleutherIA Environment Configuration — Local Development
# Copy this file to .env and fill in your values.
# For production deployment notes see deploy/production/README.md

# =============================================================================
# DATABASE (local Docker PostgreSQL — no DATABASE_URL needed)
# =============================================================================
# The deploy/docker-compose.yml passes POSTGRES_* vars directly to the backend.
# Set DATABASE_URL only if connecting to an external database:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# If PostgreSQL is unavailable, GraphRAG can use the committed KG snapshot.
DATABASE_REQUIRED=false
ELEUTHERIA_KG_SNAPSHOT_DIR=data/kg
# Optional maintenance DSN used by database/scripts/bootstrap_supabase.py.
# Prefer a Supabase direct/session-pooler URL for schema + data imports.
# Do not commit a real value; use shell/CI secrets for bootstrap only.
# SUPABASE_DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require

# Connection pool settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================
# Preferred provider: kimi, openrouter, or gemini
LLM_PREFERRED_PROVIDER=gemini
LLM_THINKING_PROVIDER=openrouter

# Kimi Latest (optional Moonshot fallback)
# Get key at: https://platform.moonshot.ai
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# OpenRouter (alternative - multi-model access)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_THINKING_MODEL=openai/gpt-oss-120b:nitro
OPENROUTER_PROVIDER_ORDER=cerebras
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_HTTP_REFERER=https://free-will.app
OPENROUTER_APP_NAME=EleutherIA

# Google Gemini (primary)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# =============================================================================
# MONITORING (optional)
# =============================================================================
# Sentry error tracking
SENTRY_DSN=

# Prometheus metrics
PROMETHEUS_ENABLED=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# FRONTEND
# =============================================================================
VITE_API_URL=http://localhost:8000

# =============================================================================
# Phase C — the platform integration
# =============================================================================
# When EXTERNAL_INTEGRATION=true the backend reads LLM API keys from the platform's
# CredentialsService (Fernet-encrypted in the provider_credentials
# Supabase table) instead of from the GEMINI_API_KEY / MOONSHOT_API_KEY /
# OPENROUTER_API_KEY env vars. Set to false for local-dev / standalone
# deployments.
EXTERNAL_INTEGRATION=false

# Shared encryption secret used by the platform's CredentialsService. The
# service derives a Fernet key from this string via SHA-256, so the
# value must match what the platform's services use.
CREDENTIALS_ENCRYPTION_KEY=

# the platform's Supabase project (separate from EleutherIA's own Supabase).
# Used only by CredentialsService — academic data never lives here.
EXTERNAL_DB_URL=
EXTERNAL_DB_SERVICE_KEY=

# the platform's Temporal cluster — reachable from inside `app-network`.
# Defaults are correct when running under the platform's compose; override
# only for non-default deployments.
TEMPORAL_HOST=temporal:7233
TEMPORAL_TASK_QUEUE=eleutheria-default

# =============================================================================
# Phase C — Snapshot upload to EleutherIA's Supabase Storage
# =============================================================================
# Where the KG snapshot files (nodes.jsonl, edges.jsonl, stats.json) are
# mirrored. Defaults to SUPABASE_URL / SUPABASE_SERVICE_KEY when these
# are unset — the storage project is EleutherIA's own Supabase, not
# the platform's.
ELEUTHERIA_SUPABASE_STORAGE_URL=
ELEUTHERIA_SUPABASE_STORAGE_KEY=
KG_SNAPSHOT_BUCKET=kg-snapshots
