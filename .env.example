# EleutherIA Environment Configuration — Local Development
# Copy this file to .env and fill in your values.
# For production (Supabase + Qdrant Cloud), see deploy/production/.env.example

# =============================================================================
# DATABASE (local Docker PostgreSQL — no DATABASE_URL needed)
# =============================================================================
# The deploy/docker-compose.yml passes POSTGRES_* vars directly to the backend.
# Set DATABASE_URL only if connecting to an external database:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Connection pool settings
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# =============================================================================
# VECTOR DATABASE (Qdrant)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional for local development
# Optional: route production re-embeds through the deployed worker admin API.
# Example: https://free-will.app/api/admin/qdrant
QDRANT_PROXY_URL=
QDRANT_PROXY_KEY=
KG_EMBED_COLLECTION=kg_nodes_gemini
QDRANT_VECTOR_NAME=
# Set to false if you want graph/KG routes without a running Qdrant instance.
QDRANT_REQUIRED=false

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================
# Preferred provider: kimi, openrouter, or gemini
LLM_PREFERRED_PROVIDER=gemini
LLM_THINKING_PROVIDER=openrouter

# Kimi Latest (optional Moonshot fallback)
# Get key at: https://platform.moonshot.ai
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# OpenRouter (alternative - multi-model access)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_THINKING_MODEL=openai/gpt-oss-120b:nitro
OPENROUTER_PROVIDER_ORDER=cerebras
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_HTTP_REFERER=https://free-will.app
OPENROUTER_APP_NAME=EleutherIA

# Google Gemini (primary)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_TPM_LIMIT=30000
GEMINI_EMBEDDING_RPM_LIMIT=100
GEMINI_EMBEDDING_RPD_LIMIT=1000
GEMINI_EMBEDDING_BATCH_TOKEN_LIMIT=24000
EMBEDDING_BATCH_SIZE=50

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# =============================================================================
# MONITORING (optional)
# =============================================================================
# Sentry error tracking
SENTRY_DSN=

# Prometheus metrics
PROMETHEUS_ENABLED=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# FRONTEND
# =============================================================================
VITE_API_URL=http://localhost:8000
