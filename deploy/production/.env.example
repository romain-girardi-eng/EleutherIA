# =============================================================================
# EleutherIA — Production Environment
# =============================================================================
# Copy to .env and fill in real credentials.
# For local development, use the root .env.example instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string from Supabase Dashboard → Settings → Database → Connection string
# Use the "Transaction" (pgbouncer, port 6543) URL for best performance.
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# Maintenance/bootstrap only: use a direct or session-pooler URL when applying
# schema and importing the recovered KG snapshot. This is not consumed by Docker.
# Keep the real value in a local shell/CI secret, not in a committed file.
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_REQUIRED=true
ELEUTHERIA_KG_SNAPSHOT_DIR=data/kg
SPARQL_ENDPOINT=http://fuseki:3030/eleutheria/sparql
FUSEKI_PORT=3030
FUSEKI_ADMIN_PASSWORD=change-this-fuseki-password
FUSEKI_JVM_ARGS=-Xmx1g

# Pool sizing — keep conservative for pgbouncer
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# -----------------------------------------------------------------------------
# LLM Providers (at least one required)
# -----------------------------------------------------------------------------
LLM_PREFERRED_PROVIDER=fireworks
LLM_THINKING_PROVIDER=openrouter

# Fireworks AI — Kimi K2.6 (primary) — https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=your-fireworks-key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# Google Gemini (fallback) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Kimi Latest (Moonshot) — https://platform.moonshot.ai
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# OpenRouter (fallback) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_THINKING_MODEL=openai/gpt-oss-120b:nitro
OPENROUTER_PROVIDER_ORDER=cerebras
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_HTTP_REFERER=https://free-will.app
OPENROUTER_APP_NAME=EleutherIA

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-secure-random-string

# -----------------------------------------------------------------------------
# CORS & Frontend
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://free-will.app
VITE_API_URL=https://free-will.app

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# -----------------------------------------------------------------------------
# Security — LLM throttling, privileged endpoints, quote enforcement
# -----------------------------------------------------------------------------
# Per-IP sliding-window rate limit on the LLM-invoking endpoints.
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_MAX=5
LLM_RATE_LIMIT_WINDOW=60

# Process-wide cap on LLM requests in flight, across all callers. Requests
# arriving with no free slot are rejected with 503 instead of queued.
LLM_MAX_CONCURRENCY=4

# Shared secret required by POST /api/graphrag/query/draft. Unset = disabled.
GRAPHRAG_DRAFT_SUBMIT_TOKEN=

# Shared secret required by POST /api/kg/reload. Unset = disabled.
KG_RELOAD_TOKEN=

# Enforce the quote verifier: answers whose Greek/Latin quotations cannot be
# matched against the corpus are rejected rather than merely reported.
ELEUTHERIA_TEXT_VERIFIER_ENFORCE=true
