# =============================================================================
# EleutherIA — Production Environment
# =============================================================================
# Copy to .env and fill in real credentials.
# For local development, use the root .env.example instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string from Supabase Dashboard → Settings → Database → Connection string
# Use the "Transaction" (pgbouncer, port 6543) URL for best performance.
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# Maintenance/bootstrap only: use a direct or session-pooler URL when applying
# schema and importing the recovered KG snapshot. This is not consumed by Docker.
# Keep the real value in a local shell/CI secret, not in a committed file.
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_REQUIRED=true
ELEUTHERIA_KG_SNAPSHOT_DIR=data/kg
SPARQL_ENDPOINT=http://fuseki:3030/eleutheria/sparql
FUSEKI_PORT=3030
FUSEKI_ADMIN_PASSWORD=change-this-fuseki-password
FUSEKI_JVM_ARGS=-Xmx1g

# Pool sizing — keep conservative for pgbouncer
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# -----------------------------------------------------------------------------
# LLM Providers (at least one required)
# -----------------------------------------------------------------------------
LLM_PREFERRED_PROVIDER=codex

# Codex proxy — gpt-5.6-sol (PRIMARY, synthesis tier)
# OpenAI-compatible CLI-subscription proxy on the prod docker network.
CODEX_PROXY_BASE_URL=http://cli-proxy-api:8317/v1
CODEX_PROXY_API_KEY=your-codex-proxy-key
CODEX_MODEL=gpt-5.6-sol
CODEX_LIGHT_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=high
# Usable context window (prompt + answer share it). Measured at ~207,000 tokens
# through the proxy — the Codex subscription's hard cap; 200,000 keeps a margin.
# Prompts estimated above it skip this rung and go straight to a 1M provider.
CODEX_MAX_INPUT_TOKENS=200000

# Claude proxy — claude-opus-5 (FALLBACK)
CLAUDE_PROXY_BASE_URL=http://pragma-claude-proxy:8318/v1
CLAUDE_PROXY_API_KEY=
CLAUDE_PROXY_MODEL=claude-opus-5
CLAUDE_PROXY_LIGHT_MODEL=claude-sonnet-5
# Usable context window — measured at 1,000,000 tokens.
CLAUDE_MAX_INPUT_TOKENS=1000000

# Gemini proxy (LAST RESORT) — OpenAI-compatible CLI-subscription proxy on the
# prod docker network. Setting GEMINI_PROXY_BASE_URL switches the Gemini rung to
# /v1/chat/completions with a bearer key (same shape as the Codex and Claude
# proxies) and retires the paid AI Studio key: GEMINI_API_KEY is then unused by
# the GraphRAG stack.
GEMINI_PROXY_BASE_URL=http://pragma-gemini-proxy:8320/v1
GEMINI_PROXY_API_KEY=same-key-as-the-other-proxies
# Only needed if the proxy is NOT configured (native generativelanguage API,
# PAID key — https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Ids the proxy serves. Synthesis tier + utility tier (the utility model also
# runs the optional relevance triage).
GEMINI_MODEL=gemini-3.1-pro-low
GEMINI_LIGHT_MODEL=gemini-3.7-flash-high
# Usable context window — measured at 1,000,000 tokens.
GEMINI_MAX_INPUT_TOKENS=1000000

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-secure-random-string

# -----------------------------------------------------------------------------
# CORS & Frontend
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://free-will.app
VITE_API_URL=https://free-will.app

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# -----------------------------------------------------------------------------
# Security — LLM throttling, privileged endpoints, quote enforcement
# -----------------------------------------------------------------------------
# Per-IP sliding-window rate limit on the LLM-invoking endpoints.
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_MAX=5
LLM_RATE_LIMIT_WINDOW=60

# Process-wide cap on LLM requests in flight, across all callers. Requests
# arriving with no free slot are rejected with 503 instead of queued.
LLM_MAX_CONCURRENCY=4

# Shared secret required by POST /api/graphrag/query/draft. Unset = disabled.
GRAPHRAG_DRAFT_SUBMIT_TOKEN=

# Shared secret required by POST /api/kg/reload. Unset = disabled.
KG_RELOAD_TOKEN=

# Enforce the quote verifier: answers whose Greek/Latin quotations cannot be
# matched against the corpus are rejected rather than merely reported.
ELEUTHERIA_TEXT_VERIFIER_ENFORCE=true
