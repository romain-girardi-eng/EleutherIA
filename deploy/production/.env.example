# =============================================================================
# EleutherIA — Production Environment
# =============================================================================
# Copy to .env and fill in real credentials.
# For local development, use the root .env.example instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string from Supabase Dashboard → Settings → Database → Connection string
# Use the "Transaction" (pgbouncer, port 6543) URL for best performance.
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Pool sizing — keep conservative for pgbouncer
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# -----------------------------------------------------------------------------
# Vector Database (Qdrant Cloud)
# -----------------------------------------------------------------------------
QDRANT_HOST=your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Optional: use the deployed Cloudflare worker as a secure Qdrant upload proxy
# when rebuilding embeddings from a local machine.
QDRANT_PROXY_URL=
QDRANT_PROXY_KEY=
KG_EMBED_COLLECTION=kg_nodes_dual
QDRANT_VECTOR_NAME=gemini

# -----------------------------------------------------------------------------
# LLM Providers (at least one required)
# -----------------------------------------------------------------------------
LLM_PREFERRED_PROVIDER=gemini
LLM_THINKING_PROVIDER=openrouter

# Google Gemini (primary) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_TPM_LIMIT=30000
GEMINI_EMBEDDING_RPM_LIMIT=100
GEMINI_EMBEDDING_RPD_LIMIT=1000
GEMINI_EMBEDDING_BATCH_TOKEN_LIMIT=24000
EMBEDDING_BATCH_SIZE=50

# Kimi Latest (Moonshot) — https://platform.moonshot.ai
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# OpenRouter (fallback) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_THINKING_MODEL=openai/gpt-oss-120b:nitro
OPENROUTER_PROVIDER_ORDER=cerebras
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_HTTP_REFERER=https://free-will.app
OPENROUTER_APP_NAME=EleutherIA

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-secure-random-string

# -----------------------------------------------------------------------------
# CORS & Frontend
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://free-will.app
VITE_API_URL=https://free-will.app

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
