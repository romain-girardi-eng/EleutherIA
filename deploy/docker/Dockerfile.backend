# EleutherIA Backend Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY database/pyproject.toml database/README.md ./database/
COPY database/src ./database/src/

COPY kg/pyproject.toml kg/README.md ./kg/
COPY kg/src ./kg/src/

COPY graphrag/pyproject.toml graphrag/README.md ./graphrag/
COPY graphrag/src ./graphrag/src/

# Install packages
RUN pip install --no-cache-dir \
    ./database \
    ./kg \
    ./graphrag[api,llm]

# Copy application code (if there's a main API module)
# COPY api ./api/

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Run server
CMD ["uvicorn", "eleutheria_graphrag.api:router", "--host", "0.0.0.0", "--port", "8000"]
