# EditorConfig is awesome: https://EditorConfig.org
# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python files (match Black/Ruff defaults)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# TypeScript/JavaScript/React
[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# JSON (2-space indent is standard)
[*.json]
indent_style = space
indent_size = 2

# YAML (2-space indent required by spec)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown (preserve readability, don't trim trailing whitespace for line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# SQL files
[*.sql]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Makefile (must use tabs!)
[Makefile]
indent_style = tab

# CSV files (preserve trailing whitespace)
[*.csv]
trim_trailing_whitespace = false

# Package manager files
[{package.json,package-lock.json,yarn.lock,pnpm-lock.yaml}]
indent_style = space
indent_size = 2

# Configuration files
[*.{toml,ini,cfg,conf}]
indent_style = space
indent_size = 2

# GitHub Actions workflows
[.github/workflows/*.{yml,yaml}]
indent_style = space
indent_size = 2

# Docker files
[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_style = space
indent_size = 2
