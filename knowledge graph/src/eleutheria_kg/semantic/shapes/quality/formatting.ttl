# --- Description hygiene: no markdown artefacts ---

kg:Shape_Argument_DescriptionHygiene a sh:NodeShape ;
    sh:targetClass kg:Argument ;
    sh:property kg:Shape_Argument_DescriptionHygieneProp .

kg:Shape_Argument_DescriptionHygieneProp a sh:PropertyShape ;
    sh:path dcterms:description ;
        sh:not [ sh:pattern "\\*\\*" ; sh:flags "s" ] ;
        sh:not [ sh:pattern "__" ; sh:flags "s" ] ;
        sh:not [ sh:pattern "\\[[^\\]]+\\]\\([^)]+\\)" ; sh:flags "s" ] ;
        sh:not [ sh:pattern "(^|\\n)\\s*[-*]\\s" ; sh:flags "s" ] ;
        sh:not [ sh:pattern "(^|\\n)\\s*#+\\s" ; sh:flags "s" ] ;
        sh:severity sh:Warning ;
        sh:message "Description on `argument` contains markdown formatting (bold, list bullets, headings, or [text](url))" .

