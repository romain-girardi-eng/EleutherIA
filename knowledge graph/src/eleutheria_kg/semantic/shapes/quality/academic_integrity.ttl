# Hand-authored (not generated by generate_shapes.py — these two checks encode
# project-specific academic-integrity doctrine from CLAUDE.md, not an ontology
# enumeration, so there is nothing to iterate over per node type).
#
# Machine-checked (warning severity) mirror of the "Ancient Text Authenticity
# Policy" / anachronistic-label doctrine documented in CLAUDE.md:
#
#   (a) every `passage` node SHOULD carry a source URN (CTS/TLG/PHI) so a
#       quoted passage is traceable back to a verifiable edition;
#   (b) an ancient-period node whose description asserts a modern label
#       (compatibilis*/libertarian/determinis*) SHOULD hedge it as a modern
#       scholarly characterization rather than presenting it as ancient fact
#       (cf. Phase 12 of the KG quality repair — "Anachronistic Label Audit").
#
# Both fire as sh:Warning, never sh:Violation: they flag a scholarly-review
# backlog, they do not block conformance.

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kg:      <https://free-will.app/ontology/> .
@prefix res:     <https://free-will.app/kg/> .

# --- (a) Passage nodes should carry a source URN (CTS/TLG/PHI) ---

kg:Shape_Passage_SourceUrn a sh:NodeShape ;
    sh:targetClass kg:Passage ;
    sh:property kg:Shape_Passage_SourceUrnProp .

kg:Shape_Passage_SourceUrnProp a sh:PropertyShape ;
    sh:path kg:ctsURN ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "Passage nodes should carry a source URN (metadata.cts_urn, CTS/TLG/PHI) so the quotation is traceable to a verifiable edition" .

# --- (b) Ancient-period nodes should hedge modern philosophical labels ---
#
# Targets every subject that carries a kg:period triple (passages excluded
# in practice, since the RDF exporter only assigns kg:period from the
# `period` node field, which passage nodes do not populate) whose
# dcterms:description asserts compatibilism/libertarianism/determinism
# without also flagging it as a modern scholarly characterization.

kg:Shape_AncientNode_UnhedgedModernLabel a sh:NodeShape ;
    sh:targetSubjectsOf kg:period ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Ancient-period node description asserts a modern label (compatibilis*/libertarian/determinis*) without a hedge marker (modern/scholars/characteriz/anachron) — cf. CLAUDE.md anachronistic-label doctrine" ;
        sh:select """
            PREFIX kg: <https://free-will.app/ontology/>
            PREFIX dcterms: <http://purl.org/dc/terms/>
            SELECT $this WHERE {
              $this kg:period ?period .
              FILTER ( ?period IN ( "Presocratic", "Classical Greek", "Hellenistic", "Roman Republican", "Roman Imperial", "Patristic", "Late Antiquity" ) )
              $this dcterms:description ?desc .
              FILTER ( REGEX(?desc, "compatibilis|libertarian|determinis", "i") )
              FILTER ( ! REGEX(?desc, "modern|scholars|characteriz|anachron", "i") )
            }
        """ ;
    ] .
