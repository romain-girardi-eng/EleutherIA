# --- Claim-bearing nodes should be anchored to evidence ---

kg:Shape_Argument_NeedsEvidence a sh:NodeShape ;
    sh:targetClass kg:Argument ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Claim-bearing `argument` node lacks any evidence anchor (evidenced_by, grounded_in, source_for)" ;
        sh:select """
            PREFIX kg: <https://free-will.app/ontology/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
              $this a kg:Argument .
              FILTER NOT EXISTS { $this ( kg:evidencedBy | kg:groundedIn | kg:sourceFor ) ?anchor }
              FILTER NOT EXISTS { ?anchor ( kg:evidencedBy | kg:groundedIn | kg:sourceFor ) $this }
              FILTER NOT EXISTS { $this kg:needsEvidence true }
              FILTER NOT EXISTS { $this kg:needsEvidence \"true\"^^xsd:boolean }
            }
        """ ;
    ] .

