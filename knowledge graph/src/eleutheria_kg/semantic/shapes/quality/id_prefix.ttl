kg:Shape_Argument_IdPrefix a sh:NodeShape ;
    sh:targetClass kg:Argument ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Node ID for type `argument` uses a different canonical type prefix (expected `argument_` or a project convention)" ;
        sh:select """
            PREFIX kg: <https://free-will.app/ontology/>
            PREFIX res: <https://free-will.app/kg/>
            SELECT $this WHERE {
              $this a kg:Argument .
              BIND( STRAFTER(STR($this), STR(res:)) AS ?localName )
              FILTER ( STRSTARTS( STR($this), STR(res:) ) )
              FILTER ( ! STRSTARTS( ?localName, "argument_" ) )
              FILTER ( STRSTARTS( ?localName, "concept_" ) || STRSTARTS( ?localName, "controversy_" ) || STRSTARTS( ?localName, "debate_" ) || STRSTARTS( ?localName, "event_" ) || STRSTARTS( ?localName, "group_" ) || STRSTARTS( ?localName, "person_" ) || STRSTARTS( ?localName, "publication_" ) || STRSTARTS( ?localName, "quote_" ) || STRSTARTS( ?localName, "school_" ) || STRSTARTS( ?localName, "synthesis_" ) || STRSTARTS( ?localName, "term_" ) || STRSTARTS( ?localName, "textual_variant_" ) || STRSTARTS( ?localName, "work_" ) )
