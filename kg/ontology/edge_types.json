      "target_types": ["concept", "position", "argument"]
    },
    "argues_against": {
      "description": "Source argues against target position/concept",
      "category": "argumentative",
      "inverse": "opposed_by",
      "source_types": ["person", "argument", "work"],
      "target_types": ["concept", "position", "argument"]
    },
    "refutes": {
      "description": "Source refutes target argument",
      "category": "argumentative",
      "inverse": "refuted_by",
      "source_types": ["person", "argument"],
      "target_types": ["argument"]
    },
    "responds_to": {
      "description": "Source is a response to target",
      "category": "argumentative",
      "inverse": "has_response",
      "source_types": ["argument", "work", "person", "concept", "passage", "publication", "synthesis"],
      "target_types": ["argument", "work", "concept", "debate", "person"]
