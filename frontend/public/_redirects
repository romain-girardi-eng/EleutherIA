# Cloudflare Pages SPA fallback for dynamic React routes.
#
# Since 404.html exists (SEO prerender, 2026-06-10), Pages no longer
# falls back to index.html automatically — without these rules every
# deep link (/texts/<id>, /share/<token>, …) served the 404 page.
# Splat + /spa.html proxy: Pages clean-URL normalization 308s any
# /index.html target to /, and placeholder targets are dropped, so the
# build emits spa.html, targeted extensionless (/spa) because Pages
# pretty-URLs also 308 any explicit .html target.

/texts/* /spa 200
/simple/* /spa 200
# Entity-shaped graph paths are generated only for the reviewed public cohort.
# Do not soft-rewrite unknown IDs: a missing generated file must reach 404.html.
# General graph permalinks use /visualizer?workspace=1&node=<id>.
/recherches/* /spa 200
/contributions/* /spa 200
/passages-canoniques/* /spa 200
/profile/* /spa 200
/share/* /spa 200
/debate/* /spa 200
/projects /spa 200
/projects/* /spa 200
