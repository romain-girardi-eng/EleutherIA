# Cloudflare Pages SPA fallback for dynamic React routes.
#
# Since 404.html exists (SEO prerender, 2026-06-10), Pages no longer
# falls back to index.html automatically — without these rules every
# deep link (/texts/<id>, /share/<token>, …) served the 404 page.
# Splat + /index.html proxy is the documented Pages SPA-subpath form
# (placeholder targets and bare "/" rewrites are silently dropped).

/texts/* /index.html 200
/simple/* /index.html 200
/visualizer/* /index.html 200
/graph/* /index.html 200
/recherches/* /index.html 200
/contributions/* /index.html 200
/passages-canoniques/* /index.html 200
/profile/* /index.html 200
/share/* /index.html 200
