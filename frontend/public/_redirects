# Cloudflare Pages SPA fallback for dynamic React routes.
#
# Since 404.html exists (SEO prerender, 2026-06-10), Pages no longer
# falls back to index.html automatically — without these rules every
# deep link (/texts/<id>, /share/<token>, …) served the 404 page.
# Placeholder rules (not /*) keep prerendered top-level pages
# (/texts/, /glossary/, …) served as real static assets.

/texts/:id /index.html 200
/texts/:id/book /index.html 200
/simple/:id /index.html 200
/visualizer/:id /index.html 200
/graph/:id /index.html 200
/recherches/:slug /index.html 200
/contributions/:id /index.html 200
/passages-canoniques/:id /index.html 200
/profile/:id /index.html 200
/share/:token /index.html 200
