# Frontend Environment Configuration
# Copy this file to .env.development or .env.production and update values

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL - The base URL for the FastAPI backend
# Local development:
VITE_API_URL=http://localhost:8000
# Production API:
# VITE_API_URL=https://free-will.app

# Citation is fail-closed until all three frozen-release values are present.
# The DOI must be the Zenodo *version* DOI, never the rolling concept DOI.
# VITE_APP_COMMIT=0123456789abcdef0123456789abcdef01234567
# VITE_ZENODO_VERSION_DOI=10.5281/zenodo.NNNNNNNN
# VITE_KG_SNAPSHOT_DATE=YYYY-MM-DD
# VITE_KG_RELEASE_ID=kg-sha256-...

# =============================================================================
# 3D Visualization (Semativerse)
# =============================================================================

# Semativerse 3D Knowledge Graph Visualization URL
# Local development:
VITE_SEMATIVERSE_URL=http://localhost:5173
# Production:
# VITE_SEMATIVERSE_URL=https://semativerse.free-will.app

# =============================================================================
# Notes
# =============================================================================
#
# Vite Environment Variables:
# - All variables must be prefixed with VITE_ to be exposed to the browser
# - Values are injected at build time, not runtime
# - Use import.meta.env.VITE_* to access in code
#
# Deployment Options:
# - Docker: Variables are passed via docker-compose.local.yml
# - Cloudflare Pages: Set in Cloudflare Dashboard > Settings > Environment Variables
# - Local: Copy to .env.development and start with npm run dev
